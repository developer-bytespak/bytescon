# Demo flavour: client demos on demo.bytesgov.com. No Stripe, email or file storage.
# Every value is the demo's OWN. Enter them in the Render dashboard; this file only
# lists the names. Check with: npm run flavour:check

NODE_ENV=production
APP_ENV=demo

# Who can create demo accounts. Staff sign in with DEMO_ADMIN_EMAIL.
PLATFORM_ADMIN_EMAILS=
# The first operator, used once by npm run db:seed-demo. Password: at least 12 characters.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

# Neon branch "demo", never the main branch
DATABASE_URL=
DIRECT_URL=
# Render fills this in from bytescon-redis-demo
REDIS_URL=

# Render generates JWT_SECRET
JWT_SECRET=
# A new value: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=

APP_URL=https://demo.bytesgov.com
FRONTEND_URL=https://demo.bytesgov.com
PUBLIC_APP_URL=https://demo.bytesgov.com
ALLOWED_ORIGINS=https://demo.bytesgov.com

# A separate key with a low spending cap
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
