# Staging flavour: internal team only, test data, fake money.
# Every value is staging's OWN, never copied from production. Enter them in the
# Render dashboard; this file only lists the names. Check with: npm run flavour:check
# Details: project-docs/20-environments-staging-and-production.md

NODE_ENV=production
APP_ENV=staging

# Who may sign in and receive email: addresses or whole domains. Staging won't start if empty.
STAGING_ALLOWED_EMAILS=@yourcompany.com
# Staff numbers for SMS tests. Empty means no SMS goes out.
STAGING_ALLOWED_PHONES=
# The first admin, used once by npm run db:seed-staging. Password: at least 12 characters.
STAGING_SEED_ADMIN_EMAIL=
STAGING_SEED_ADMIN_PASSWORD=

# Neon branch "staging", never the main branch
DATABASE_URL=
DIRECT_URL=
# Render fills this in from bytescon-redis-staging
REDIS_URL=

# Render generates JWT_SECRET
JWT_SECRET=
# A new value: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=

APP_URL=https://staging.yourdomain.com
FRONTEND_URL=https://staging.yourdomain.com
PUBLIC_APP_URL=https://staging.yourdomain.com
ALLOWED_ORIGINS=https://staging.yourdomain.com

# Stripe TEST mode. Staging refuses to start with a live key.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

SENDGRID_API_KEY=
EMAIL_FROM=
SAM_API_KEY=
# Separate keys with a low spending cap
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Bucket bytescon-uploads-staging
UPLOADS_S3_BUCKET=
UPLOADS_S3_ENDPOINT=
UPLOADS_S3_REGION=
UPLOADS_S3_ACCESS_KEY_ID=
UPLOADS_S3_SECRET_ACCESS_KEY=
