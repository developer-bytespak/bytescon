NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://bytescon_user:bytescon_pass@localhost:5432/bytescon_platform
REDIS_URL=redis://localhost:6379

JWT_SECRET=replace-with-a-strong-random-secret-min-32-chars
JWT_EXPIRES_IN=8h

# ── Secrets at rest (#20) ──────────────────────────────────────
# When set, tenant SAM/LLM API keys are encrypted at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST differ from JWT_SECRET. Unset = keys stored as plaintext (legacy behavior).
# After setting it, run: npx ts-node prisma/scripts/encryptExistingApiKeys.ts
FIELD_ENCRYPTION_KEY=

# ── Platform administrators (C5) ───────────────────────────────
# Comma-separated emails allowed to moderate CROSS-TENANT content — approving
# shared templates before they become visible to every firm. NOT the per-firm
# ADMIN role (that would be self-approval). Unset = nobody can approve, so
# submitted templates stay PENDING_REVIEW (the safe default).
PLATFORM_ADMIN_EMAILS=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
MAX_UPLOAD_MB=25

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

SAM_API_KEY=
SAM_BASE_URL=https://api.sam.gov/opportunities/v2
USASPENDING_BASE_URL=https://api.usaspending.gov/api/v2

# ── GB-107 description enrichment (SAM.gov noticedesc) ───────────
# Optional dedicated key; when unset the module falls back to
# SAM_API_KEY (shared daily quota). Neither set = the enrichment
# worker idles gracefully; nothing crashes.
SAM_GOV_API_KEY=
ENRICHMENT_RATE_LIMIT_PER_DAY=900
ENRICHMENT_RATE_LIMIT_BURST_INTERVAL_MS=2000
ENRICHMENT_BATCH_SIZE=50
ENRICHMENT_PRIORITY_WINDOW_DAYS=90
# Also fetch pointOfContact/resourceLinks via v2 search (2nd API call per opp)
ENRICHMENT_FETCH_LINKS=false

# ── GSA data (api.data.gov key) ────────────────────────────────
# api.data.gov key — Per Diem + other GSA APIs; free from
# api.data.gov/signup; one key works across all GSA APIs; NOT for SAM.gov.
# Powers the pricing tool's travel/lodging (Per Diem) line items. Empty = inert.
DATA_GOV_API_KEY=
GSA_API_BASE_URL=https://api.gsa.gov

# ── GB-104 Subcontractor outreach recipient email ──────────────
# When on, the SCW outreach composer threads a recipient email from the
# already-approved contact enrichment (SAM.gov POC) into the draft and
# sets emailVerificationStatus. Only `verified` recipients are auto-send
# eligible; `probable`/`unknown` are flagged for manual confirmation.
# Default OFF preserves prior composer behavior. Truthy: 1 | true | yes.
SCW_EMAIL_ENRICHMENT_ENABLED=

# Seed the federal published prime-SBLO directory into a firm's prime-contact
# pool on each POST /api/subcontracting/sync: the DLA Strategic Subcontracting
# OEM POCs and the DoD/DoW Comprehensive-Subcontracting-Plan Prime Contractor
# Directory (both linked from dla.mil's subcontracting page). Ships as a baked
# corpus — src/data/primeSbloDirectory.ts, regenerated by
# `node backend/scripts/genPrimeSbloDirectory.mjs` — because both publishers
# 403 non-browser clients, so there is no runtime fetch, no vendor cost and no
# network dependency. Contacts land with source='dla_captains_of_industry' /
# 'dod_csp_prime_directory'. Government-published business addresses, NOT
# deliverability-verified: never auto-send. DEFAULT ON (set 0 to disable).
PRIME_DIRECTORY_SEED_ENABLED=

# ── Win-probability: absent-feature renormalization ────────────
# When truthy, model features with NO source data are excluded from the
# weighted mean and the surviving weights renormalize, instead of being
# filled with a neutral 0.5. Without it an unenriched SAM opportunity is
# scored on seven constants: measured on prod, ~25 of every 50 opportunities
# returned EXACTLY 0.3092 and most of the rest 0.4081, differing only by
# whether the client shared a 2-digit NAICS sector.
# ⚠️ This MOVES A CUSTOMER-FACING NUMBER (the client portal's Fit score and
# its Strong/Moderate/Weak tier). Low-fit opportunities will correctly score
# much lower. Defaults ON in dev, OFF in production — same rollout shape as
# MATCHING_V2_ENABLED. Before enabling in prod: sample-test ~8 opportunities,
# then re-score the tenant. Truthy: 1.
PROBABILITY_RENORMALIZE_ABSENT=

# ── Clay contact enrichment (prime procurement contacts) ───────
# When truthy AND CLAY_API_KEY is set, the Clay provider enriches a
# recipient/prime with procurement contacts (name/title/email/phone/
# function) via Clay's HTTP API. Emails are 'probable' unless Clay returns an
# explicit deliverability signal (valid/deliverable/verified) — never blanket
# 'verified' (GB-104 auto-send safety). Additive; default OFF and inert
# without a key. Truthy: 1 | true | yes.
CLAY_ENRICHMENT_ENABLED=
CLAY_API_KEY=
# Clay REST base URL. NOTE: Clay's enrichment surface is table/MCP/webhook
# based — point this at the confirmed endpoint (or a published Clay table
# webhook) before enabling; the provider's request/response mapping is
# isolated in clayProvider.ts for that adjustment.
CLAY_BASE_URL=https://api.clay.com/v3

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── LLM SSRF guard (utils/ssrfGuard.ts) ────────────────────────
# Firms can supply their own LLM base URL, so outbound LLM calls are
# resolved and blocked from reaching private/link-local addresses.
# Comma-separated hostnames exempted from that check. Default when
# unset: "ollama,localhost" — the in-cluster Ollama service.
LLM_HOST_ALLOWLIST=
# Set to 1 to DISABLE the private-address guard entirely. Development
# escape hatch for pointing at an LLM on the host network. Never set
# this in production — it re-opens the SSRF path.
LLM_ALLOW_PRIVATE_BASE_URL=

# ── LLM model tiering (#94, services/llm/modelTiering.ts) ──────
# Per-task model selection. Cheap tier handles mechanical tasks,
# premium tier handles reasoning-heavy ones. Defaults are baked in
# (cheap: claude-haiku-4-5; premium: the router's default model), so
# these only need setting to override.
CLAUDE_MODEL_CHEAP=
CLAUDE_MODEL_PREMIUM=

# Enforce the minimum JWT_SECRET strength check outside production
# (it is always enforced when NODE_ENV=production). Set to 1 in
# staging to catch a weak secret before it ships. Truthy: 1 only.
REQUIRE_STRONG_JWT_SECRET=

# ── Winners Intel (USAspending award/subaward staging) ─────────
# Master switch for the winners-intel resolver and its refresh
# worker's health expectation. Default OFF. Truthy: "true" only
# (this one is a string compare, not the 1|true|yes idiom).
ENABLE_WINNERS_INTEL=

# GB-107 SAM.gov endpoint overrides. Both default to the live SAM
# URLs in gb107/config.gb107.ts — set only to point the enrichment
# worker at a mock or a changed endpoint.
ENRICHMENT_NOTICEDESC_URL=
ENRICHMENT_SEARCH_URL=

# Recipient address for the mailer health probe (GET /api/health
# deliverability check). Defaults to probe@bytescon.com.
MAILER_PROBE_TO=

# ── who-wins corpus ingestion throttles (prisma/scripts/buildWhoWins) ──
# USAspending rate-limits and OOMs the bulk pull if driven too hard.
# Leave unset for the built-in defaults; raise the spacing/cooloff if
# the ingest starts 429ing. FORCE_REFETCH re-downloads chunks that are
# already staged (slow — only for repairing a bad batch).
WHO_WINS_CHUNK_SPACING_MS=
WHO_WINS_COOLOFF_MS=
WHO_WINS_FORCE_REFETCH=

# Platform default AI provider (claude, openai, localai, deepseek, insight_engine)
# This is used when a firm hasn't configured their own provider.
DEFAULT_LLM_PROVIDER=openai

# ── Google Cloud / BigQuery ────────────────────────────────────
# Development: run "gcloud auth application-default login" (no key file needed)
# Docker/CI:   point to a service account JSON key file
GCP_PROJECT_ID=
BQ_DATASET=bytescon_analytics
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ── Email (Resend) ─────────────────────────────────────────────
# When RESEND_API_KEY is unset the mailer logs the email payload
# instead of sending — useful for local dev. In production set both.
# Domain authentication on bytescon.com (DKIM + SPF) is required for
# Gmail/Outlook deliverability — add the records Resend issues at
# Domains → Add domain. Docs: https://resend.com/docs/dashboard/domains/introduction
RESEND_API_KEY=
EMAIL_FROM=noreply@bytescon.com
EMAIL_FROM_NAME=Bytescon

# Public URL used in verification + password-reset email links
PUBLIC_APP_URL=https://bytescon.com

# ── GB-103 Client Match Notifications ──────────────────────────
# Master switch for the match-diff job that emails clients when newly
# ingested opportunities match their profile. Default OFF in prod.
# Accepted truthy values: 1 | true | yes.
CLIENT_NOTIFICATIONS_ENABLED=
# Match score (0-100) a client must reach to be notified when no
# per-client NotificationPreference row overrides it. Default 70.
CLIENT_NOTIFICATIONS_DEFAULT_THRESHOLD=70
# CAN-SPAM registered postal address rendered in the email footer.
# Falls back to the confirmed Bytes Platform address when unset.
CAN_SPAM_POSTAL_ADDRESS=1 Central Ave NW, Albuquerque, NM 87102
# Base URL used in notification links (opportunity + unsubscribe).
# Falls back to https://bytescon.com when unset.
APP_URL=https://bytescon.com

# ── Beta program ───────────────────────────────────────────────
# Maximum number of beta firm slots. Beta-status endpoint reports
# slotsRemaining = MAX_BETA_SLOTS - count(consultingFirms).
MAX_BETA_SLOTS=15

# ── Ops alerting (platform-wide) ───────────────────────────────
# Who gets paged when something dies. Email falls back to the first
# PLATFORM_ADMIN_EMAILS entry, then EMAIL_FROM; with none of them set
# (and no webhook), alerts land in error.log only — i.e. nowhere.
PLATFORM_ADMIN_EMAIL=
# Optional JSON-POST webhook — payload satisfies Slack ({text}),
# Discord ({content}) and ntfy-style receivers.
ALERT_WEBHOOK_URL=
# Optional SMS for CRITICAL alerts (requires TWILIO_* to be set).
ALERT_SMS_TO=
# Suppression window for repeats of the same alert key. Default 6.
ALERT_THROTTLE_HOURS=6
# Shared secret for host scripts (nightly backup) to report outcomes
# to POST /api/ops/heartbeat/:jobName. Endpoint answers 503 until set.
# Generate: openssl rand -hex 32
OPS_HEARTBEAT_TOKEN=

# ── Observability ──────────────────────────────────────────────
# Sentry — leave blank to disable (no traffic). Get DSN from
# https://sentry.io project settings.
SENTRY_DSN=
SENTRY_TRACES_RATE=0.1

# Prometheus /api/metrics endpoint guard. If set, requests must
# include ?token=<value> or Authorization: Bearer <value>. Leave
# blank for public scrape (only viable behind internal-network
# proxy). Endpoint lives under /api/ so reverse-proxy routing
# forwards it to the backend instead of the SPA fallback.
METRICS_SECRET=

# ── MCP suite (opportunity-mcp v0.1) ───────────────────────────
# Bearer token consumed by the opportunity-mcp stdio server. The
# server hashes this value and looks it up in the api_tokens table
# (CLAUDE.md §4.4, §6.4). Keep blank in the committed example; set
# in a real .env or in Claude Desktop's mcpServers.env block. No
# fallback default; empty value causes the MCP server to exit non-zero.
Bytescon_MCP_TOKEN=

# ── Matching v2 (GB-101/102 scoring + PSC) ─────────────────────
# Corrected opportunity↔client scorer with dynamic renormalization,
# graduated NAICS, and a PSC dimension. Defaults ON in dev, OFF in
# production until validated; rollback is a flag flip. Set to 1 to enable.
MATCHING_V2_ENABLED=
# Dimension weights (optional overrides; sane defaults in config.ts).
# Need NOT sum to 1 — the scorer renormalizes over present dimensions.
MATCHING_W_NAICS=
MATCHING_W_PSC=
MATCHING_W_AWARD_SIZE=
MATCHING_W_GEOGRAPHY=
MATCHING_W_PAST_PERFORMANCE=
MATCHING_W_SET_ASIDE=

# Show the raw 0-100 "Fit score" number to customers (FIXES.md FIX-1). OFF by
# default: the probability is not yet calibrated on real WON/LOST outcomes, so
# the honest surface is the tiered Strong/Moderate/Weak signal + factor
# breakdown. Flip to 1 only after the calibration backtest passes.
SHOW_NUMERIC_FIT_SCORE=0

# Reward N proposal tokens the first time a submission's WON/LOST outcome is
# recorded (FIXES.md FIX-1 flywheel incentive — real outcomes fuel calibration).
# Default 0 = off.
OUTCOME_LOGGING_REWARD_TOKENS=0

# Score calibration (GB-107)
# Set to 1 after running a v2-permutation backtest and loading the curve.
ENABLE_PROBABILITY_CALIBRATION=0
# isotonic (default) | platt (parametric, 2-parameter sigmoid)
CALIBRATION_METHOD=isotonic

# ═══════════════════════════════════════════════════════════════
# §8.4 — INTEGRATIONS
# ═══════════════════════════════════════════════════════════════
# Every provider below is OPTIONAL. Leave a block blank and that provider's
# card simply reports that this deployment holds no credentials for it — the
# platform does not pretend a connection exists. Fill only what the customer
# actually uses.
#
# OAuth redirect URI. Each provider's developer console must be given the
# EXACT callback URL below, or the authorization round-trip fails with a
# redirect_uri mismatch that the provider reports and the platform cannot fix:
#
#   <PUBLIC_API_URL>/api/integrations/callback/<provider>
#
# e.g.  https://api.bytescon.com/api/integrations/callback/quickbooks
#       https://api.bytescon.com/api/integrations/callback/slack
#
# PUBLIC_API_URL is where the API is reachable from the public internet. It
# falls back to PUBLIC_APP_URL, then to http://localhost:3001 in development.
PUBLIC_API_URL=

# ── Accounting ─────────────────────────────────────────────────
# QuickBooks Online. Create an app at developer.intuit.com, add the callback
# URL above, and copy the client id/secret from its Keys tab.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=

# Unanet and Deltek Costpoint are CONTRACT_ONLY: their API endpoints are
# supplied to each customer under contract rather than published, so the
# request mapping has to be completed against that customer's own tenant
# documentation before anything can sync. Setting these stores the credential
# and unlocks the connection — it does not finish that mapping.
UNANET_BASE_URL=
UNANET_API_KEY=
DELTEK_BASE_URL=
DELTEK_API_KEY=

# ── Calendar ───────────────────────────────────────────────────
# Google Cloud console → OAuth client (Web application) → add the callback URL.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Microsoft Entra ID app registration. The same pair also serves Microsoft
# Teams sign-in where that is used; Teams incoming webhooks need no app.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── Chat ───────────────────────────────────────────────────────
# Slack app at api.slack.com/apps → OAuth & Permissions → add the callback URL.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Microsoft Teams needs NO server-side credential. A channel is connected by
# pasting an incoming-webhook URL into Integrations → Connections, and that URL
# is stored per firm rather than in this file.

# ── E-signature ────────────────────────────────────────────────
# DocuSign. Use the demo base URL while testing and switch to the production
# one only after the app is promoted, or envelopes are created in the wrong
# account:
#   demo        https://demo.docusign.net/restapi
#   production  https://www.docusign.net/restapi
DOCUSIGN_CLIENT_ID=
DOCUSIGN_CLIENT_SECRET=
DOCUSIGN_BASE_URL=

# ── Credential storage ─────────────────────────────────────────
# Provider tokens and API keys are encrypted at rest with FIELD_ENCRYPTION_KEY
# (set near the top of this file). Rotating that key makes every stored
# integration credential unreadable, and each connection has to be re-authorized.
