{
  "name": "bytescon-backend",
  "version": "1.0.0",
  "description": "Bytescon Bytescon Engine - Backend (Bid Analytics, Nexus Knowledge Vault)",
  "main": "dist/server.js",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:seed": "ts-node prisma/seed.ts",
    "db:seed:naics": "ts-node prisma/seedNaics.ts",
    "db:studio": "prisma studio",
    "db:reset-beta": "ts-node prisma/scripts/resetBeta.ts",
    "db:seed-prod": "ts-node prisma/scripts/seedProd.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^8.1.1",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^10.63.0",
    "@types/adm-zip": "^0.5.7",
    "@types/pdfkit": "^0.17.5",
    "adm-zip": "^0.5.16",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "bullmq": "^4.15.0",
    "cors": "^2.8.5",
    "cron-parser": "^4.9.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.11.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.3",
    "openai": "^6.32.0",
    "otpauth": "^9.5.1",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.18.0",
    "prom-client": "^15.1.3",
    "sanitize-html": "^2.17.5",
    "stripe": "^22.0.2",
    "twilio": "^6.0.0",
    "uuid": "11.1.1",
    "winston": "^3.11.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.22.4"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^8.0.1",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^9.0.7",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.5"
  }
}
