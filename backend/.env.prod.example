# =============================================================
# Bytescon Platform — Production Environment Template
# Copy to .env.prod and fill in all required values.
# NEVER commit .env.prod or any file containing real secrets.
# =============================================================

# ----------------------------
# Core Application
# ----------------------------
NODE_ENV=production
PORT=3001

# Public-facing URL (no trailing slash)
APP_URL=https://bytescon.com
FRONTEND_URL=https://bytescon.com

# Root domain for white-label subdomain matching
PLATFORM_ROOT_DOMAIN=bytescon.com

# Allowed CORS origins (comma-separated, no trailing slash)
ALLOWED_ORIGINS=https://bytescon.com

# ----------------------------
# Authentication
# ----------------------------
# REQUIRED. Must be 32+ chars in production. Rotating this invalidates all sessions.
JWT_SECRET=CHANGE_ME_minimum_32_chars_random_string_here
JWT_EXPIRES_IN=8h

# ----------------------------
# Database (Neon Postgres)
# ----------------------------
# App traffic: use the POOLED Neon connection string (has "-pooler" in the host).
# Migrations (`prisma migrate deploy`): run with DATABASE_URL set to the DIRECT
# (non-pooler) endpoint — PgBouncer breaks Prisma's migration advisory locks.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/bytescon?sslmode=require

# ----------------------------
# Redis / BullMQ (Render Key Value)
# ----------------------------
# Use the INTERNAL connection string from the Render Key Value instance
# (same region as the API + worker services).
REDIS_URL=

# ----------------------------
# Stripe (Live Mode)
# ----------------------------
# REQUIRED for billing. Get from Stripe Dashboard → Developers.
STRIPE_SECRET_KEY=sk_live_...

# REQUIRED. Raw body parsing depends on this for signature verification.
# Get from Stripe Dashboard → Webhooks → your endpoint → Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_...

# ISO date when the current webhook secret was last rotated (YYYY-MM-DD).
# The stripeWebhookRotationReminderWorker emails PLATFORM_ADMIN_EMAIL at day 75 and 90.
STRIPE_WEBHOOK_SECRET_ROTATED_AT=2026-01-01

# Price IDs from Stripe Dashboard → Products (must match live mode)
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PROFESSIONAL=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# Publishable key (also set in frontend .env.prod)
STRIPE_PUBLISHABLE_KEY=pk_live_...

# ----------------------------
# Email (SendGrid v3 API)
# ----------------------------
# Transport is SendGrid's v3 Mail Send API (services/mailer.ts) — NOT SMTP.
# If SENDGRID_API_KEY is unset, emails are logged but NOT delivered (dev mode).
SENDGRID_API_KEY=SG.CHANGE_ME
# Must be a SendGrid domain-authenticated (Sender Authentication) address.
EMAIL_FROM=noreply@bytescon.com
EMAIL_FROM_NAME=Bytescon
# Deliverability: point replies at a REAL monitored mailbox (default support@<from-domain>).
EMAIL_REPLY_TO=support@bytescon.com
# List-Unsubscribe contact; the mailbox should exist or alias to a real inbox.
EMAIL_UNSUBSCRIBE_MAILTO=unsubscribe@bytescon.com
# Shown in the email footer; set to your real postal address (CAN-SPAM).
EMAIL_COMPANY_ADDRESS=
EMAIL_APP_DOMAIN=bytescon.com
# PUBLIC_APP_URL (set elsewhere in this file) is the base for verify/reset links.

# Platform operator email — receives Stripe rotation reminders, system alerts.
PLATFORM_ADMIN_EMAIL=

# ----------------------------
# AI / LLM Providers
# ----------------------------
# Primary: Claude (Anthropic). Fallback chain: OpenAI → DeepSeek → Insight Engine → LocalAI.
# At least one of ANTHROPIC_API_KEY or OPENAI_API_KEY must be set in production.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...
INSIGHT_ENGINE_API_KEY=

# LocalAI / Ollama (optional self-hosted fallback). Leave empty on Render.
LOCALAI_BASE_URL=
LOCALAI_MODEL=

# Default provider if firm has not configured one: claude | openai | deepseek | localai
DEFAULT_LLM_PROVIDER=claude

# ----------------------------
# Google Cloud / BigQuery
# ----------------------------
# Project ID for BigQuery analytics (bytescon_analytics dataset).
GCP_PROJECT_ID=

# BigQuery dataset name (default: bytescon_analytics)
BQ_DATASET=bytescon_analytics

# Path inside the Docker container to the service-account JSON key.
# Mounted read-only via docker-compose.prod.yml: ./adc.json:/app/adc.json:ro
GOOGLE_APPLICATION_CREDENTIALS=/app/adc.json

# ----------------------------
# SAM.gov / USAspending
# ----------------------------
# Firm-level API keys override this via ConsultingFirm.samApiKey in DB.
SAM_API_KEY=
SAM_BASE_URL=https://api.sam.gov/opportunities/v2/search
USASPENDING_BASE_URL=https://api.usaspending.gov/api/v2

# ----------------------------
# Twilio (SMS Notifications)
# ----------------------------
# Optional. Leave empty to disable SMS; deadline + scoring workers will skip SMS gracefully.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ----------------------------
# Rate Limiting
# ----------------------------
RATE_LIMIT_MAX=500
RATE_LIMIT_WINDOW_MS=900000

# ----------------------------
# Uploads / File Handling
# ----------------------------
# Max file upload size in MB (default: 10)
MAX_UPLOAD_MB=10

# ----------------------------
# Platform Feature Limits
# ----------------------------
# Max beta slots for Founders Lifetime tier (enforced at signup + billing)
MAX_BETA_SLOTS=10

# Per-firm portfolio scoring cap per run (default: 200)
PORTFOLIO_SCORING_CAP=200

# ----------------------------
# Logging
# ----------------------------
LOG_LEVEL=info

# ----------------------------
# State Procurement Portal Credentials
# ----------------------------
# Used by stateProcurementScraper.ts. Leave empty if not using state/municipal feature.
PORTAL_CA_USER=
PORTAL_CA_PASS=
PORTAL_FL_USER=
PORTAL_FL_PASS=
PORTAL_MD_USER=
PORTAL_MD_PASS=
PORTAL_PA_USER=
PORTAL_PA_PASS=
