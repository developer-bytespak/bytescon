  @@map("compliance_matrices")
}

model MatrixRequirement {
  id              String                  @id @default(cuid())
  matrixId        String
  section         String
  sectionType     String                  @default("INSTRUCTION")
  requirementText String
  proposalSection String?
  status          MatrixRequirementStatus @default(NOT_STARTED)
  notes           String?
  isMandatory     Boolean                 @default(true)
  farReference    String?
  sortOrder       Int                     @default(0)

  // Source document tracking (AI extraction)
  sourceDocumentId     String? // Which document this requirement was extracted from
  sourcePageNumber     Int? // Which page (if known)
  evidenceText         String? // short source excerpt for human verification (§5.2)
  extractionMethod     String  @default("AI") // AI, MANUAL, HYBRID
  extractionConfidence Float   @default(0.8) // 0-1 scale
  isManuallyVerified   Boolean @default(false)
  manualOverrideReason String? // Why the requirement was manually overridden

  // §5.2 compliance-matrix verification + ownership + review
  verificationStatus String  @default("UNVERIFIED") // UNVERIFIED | VERIFIED | REJECTED
  ownerUserId        String?
  reviewRequired     Boolean @default(false)
  reviewReason       String?

  // Proposal coverage tracking (future use)
  proposalSectionId String? // Linked proposal section
  coverageStatus    String  @default("UNCOVERED") // UNCOVERED, PARTIAL, COVERED
  coverageScore     Float   @default(0) // 0-1: how well addressed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // §6.3F — ownership, review and completion. Status uses the existing
  // MatrixRequirementStatus enum extended with the §6.3F workflow states.
  consultingFirmId          String?
  reviewerUserId            String?
  dueDate                   DateTime?
  completionPercent         Int       @default(0)
  isBlocked                 Boolean   @default(false)
  blockerReason             String?
  relatedStandingDocumentId String?
  relatedSubmissionItemId   String?
  amendmentImpact           String? // ADDED | MODIFIED | REMOVED | UNCHANGED
  amendmentRevisionId       String?
  lastActivityAt            DateTime?
  extractionJobId           String?
  // §6.3B — which side of the L/M split this requirement sits on.
  lmRole                    String? // INSTRUCTION | EVALUATION

  matrix         ComplianceMatrix         @relation(fields: [matrixId], references: [id], onDelete: Cascade)
  sourceDocument OpportunityDocument?     @relation("SourceDocument", fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  events         MatrixRequirementEvent[]

  @@index([matrixId])
  @@index([sourceDocumentId])
  @@index([consultingFirmId, status])
  @@index([ownerUserId])
  @@index([dueDate])
  @@map("matrix_requirements")
}

