// Alert cadence for a saved monitoring profile. DISABLED = keep the saved
// filter but send no alerts. Instant/Daily/Weekly are honored by the existing
// email service only when configured; the in-app preference always persists.
enum MonitoringAlertFrequency {
  INSTANT
  DAILY
  WEEKLY
  DISABLED
}

// A reusable saved opportunity-search profile (§5.1 Stage 1). `filters` holds a
// validated subset of the SAME query params the opportunity search endpoint
// accepts (server-side filtering stays the single source of truth) — applying a
// profile just replays those params against GET /api/opportunities.
model SavedMonitoringProfile {
  id               String                   @id @default(uuid())
  consultingFirmId String
  createdByUserId  String?
  name             String
  description      String?
  filters          Json                     @default("{}")
  alertFrequency   MonitoringAlertFrequency @default(DISABLED)
  isActive         Boolean                  @default(true)
  isArchived       Boolean                  @default(false)
  // Cached count from the last apply/preview — display-only, may be stale.
  lastResultCount  Int?
  lastAppliedAt    DateTime?

  // §6.1G — user ownership, visibility and per-profile alert control. Profiles
  // stay firm-scoped; PRIVATE limits read/write to the owner (enforced in the
  // route, not by hiding UI). ownerUserId is the authoritative owner;
  // createdByUserId above is preserved as historical provenance.
  ownerUserId String?
  visibility  String  @default("FIRM") // PRIVATE | FIRM
  priority    String  @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  // Channel preferences. Email is only used when mail is actually configured;
  // in-app is always available.
  alertInApp  Boolean @default(true)
  alertEmail  Boolean @default(false)
  timeZone    String  @default("UTC")

  lastEvaluatedAt  DateTime?
  nextEvaluationAt DateTime?
  lastAlertSentAt  DateTime?
  lastAlertCount   Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consultingFirm ConsultingFirm           @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  alerts         MonitoringProfileAlert[]

  @@index([consultingFirmId, isArchived])
  @@index([consultingFirmId, isActive])
  @@index([consultingFirmId, ownerUserId])
  @@index([nextEvaluationAt])
  @@map("saved_monitoring_profiles")
}

