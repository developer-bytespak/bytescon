// -----------------------------------------------------------------
// 6.3B — SECTION L ↔ SECTION M MAPPING
// -----------------------------------------------------------------

enum MappingVerification {
  UNVERIFIED
  CONFIRMED
  REJECTED
}

model SectionLmMapping {
