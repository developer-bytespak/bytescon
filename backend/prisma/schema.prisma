  WITHDRAWN // we withdrew the bid before evaluation
}

//////////////////////////////////////////////////////////////
// BID PURSUITS — per-firm bid/no-bid declarations
//////////////////////////////////////////////////////////////

enum PursuitStatus {
  REVIEWING // opened the solicitation, no declaration yet
  SUBMITTED // firm says a bid went in (links a SubmissionRecord)
  PASSED // firm passed, or the deadline aged out unanswered
}

enum PursuitSource {
  USER
  AUTO_EXPIRED // swept to PASSED 7 days after the response deadline
}

// Capture-management lifecycle for the Section 5.2 pipeline tracker. This is a
// SEPARATE axis from PursuitStatus: `status` (REVIEWING/SUBMITTED/PASSED) is the
// calibration + award-routing declaration and keeps its meaning, while
// `pipelineStage` is the human-managed capture lifecycle shown on the board.
enum PipelineStage {
  IDENTIFIED
  QUALIFICATION
  CAPTURE
  PROPOSAL
  SUBMITTED
  AWARDED
  LOST
  NO_BID
  ARCHIVED
}

enum PursuitPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// One row per (firm, opportunity) the firm has actually engaged with.
// Created on first detail view; the dashboard widget prompts the firm to
// declare Submitted / Passed. Declarations label the probability engine's
// backtest data, and award notices are routed only to SUBMITTED pursuits.
model BidPursuit {
  id                    String        @id @default(cuid())
  consultingFirmId      String
  opportunityId         String
  status                PursuitStatus @default(REVIEWING)
  source                PursuitSource @default(USER)
  // Score snapshot at declaration time — calibration needs the probability
  // the firm acted on, not whatever a later re-score produces.
  probabilityAtDecision Float?
  submissionRecordId    String?
  snoozedUntil          DateTime?
  firstViewedAt         DateTime      @default(now())
  decidedAt             DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  // --- Section 5.2 pipeline-tracker management fields ---
  pipelineStage   PipelineStage   @default(IDENTIFIED)
  priority        PursuitPriority @default(MEDIUM)
  ownerUserId     String?
  nextAction      String?
  nextActionDueAt DateTime?
  notes           String?
  lastActivityAt  DateTime        @default(now())

  // Explicit close/reopen lifecycle (distinct from pipelineStage). closeReason
  // is one of WON | LOST | NO_BID | DEFERRED | DUPLICATE. Closed pursuits are
  // hidden unless "Include closed" is set; reopening clears these.
  closedAt    DateTime?
  closeReason String?
  closeNote   String?

  consultingFirm   ConsultingFirm    @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  opportunity      Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  submissionRecord SubmissionRecord? @relation(fields: [submissionRecordId], references: [id])
  owner            User?             @relation("PursuitOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  scorecard        Scorecard?
  gateReviews      GateReview[]

  qualificationRecommendations QualificationRecommendation[]

  // §8.1 CRM
  crmActivities CrmActivity[]
  crmFollowUps  CrmFollowUp[]

  @@unique([consultingFirmId, opportunityId])
  @@index([consultingFirmId, status])
  @@index([consultingFirmId, pipelineStage])
  @@index([ownerUserId])
  @@index([consultingFirmId, nextActionDueAt])
  @@map("bid_pursuits")
}

