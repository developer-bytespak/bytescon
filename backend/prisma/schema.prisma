//////////////////////////////////////////////////////////////
// FAR / DFARS / NIST / CMMC / SECTION 508 — REGULATORY ONTOLOGY
// Global (not tenant-scoped). Seeded from Acquisition.gov and
// official sources. The platform's foundational reference layer.
//////////////////////////////////////////////////////////////

model FarClause {
  id                      String    @id @default(cuid())
  code                    String    @unique // e.g. "52.219-14"
  partNumber              String // "52"
  subpartNumber           String? // "52.2"
  title                   String
  prescribedAt            String? // FAR section that prescribes this clause (e.g. "19.508")
  applicableContractTypes String[]  @default([]) // FFP, T_AND_M, IDIQ, COST_REIMB, BPA, COMMERCIAL
  setAsideTriggers        String[]  @default([]) // SDVOSB, WOSB, EDWOSB, HUBZONE, EIGHT_A, SMALL_BUSINESS
  agencyTriggers          String[]  @default([]) // DOD, GSA, VA, DHS, etc. (when applicability is agency-specific)
  flowDownRequired        Boolean   @default(false)
  flowDownThreshold       Decimal?  @db.Decimal(14, 2) // dollar threshold above which flow-down applies
  prerequisiteClauseCodes String[]  @default([]) // other clause codes that must be present
  prohibitedClauseCodes   String[]  @default([])
  commercialItemException Boolean   @default(false) // FAR Part 12 commercial-item exemption applies
  isBlocking              Boolean   @default(false) // unsatisfied prerequisite blocks bid?
  effectiveDate           DateTime?
  lastRevisedDate         DateTime?
  text                    String    @default("")
  summary                 String? // platform-curated 1-paragraph summary
  tags                    String[]  @default([]) // PAST_PERFORMANCE, REPRESENTATIONS, LABOR, CYBERSECURITY, etc.

  @@index([partNumber])
  @@index([code])
  @@map("far_clauses")
}

model DfarsClause {
  id                      String    @id @default(cuid())
  code                    String    @unique // e.g. "252.204-7012"
  partNumber              String
  title                   String
  prescribedAt            String?
  applicableContractTypes String[]  @default([])
  agencyTriggers          String[]  @default([]) // typically ["DOD"]
  flowDownRequired        Boolean   @default(false)
  flowDownThreshold       Decimal?  @db.Decimal(14, 2)
  prerequisiteClauseCodes String[]  @default([])
  isBlocking              Boolean   @default(false)
  effectiveDate           DateTime?
  lastRevisedDate         DateTime?
  text                    String    @default("")
  summary                 String?
  tags                    String[]  @default([])

  @@index([partNumber])
  @@index([code])
  @@map("dfars_clauses")
}

model Nist800171Control {
  id          String @id @default(cuid())
  controlId   String @unique // e.g. "3.1.1"
  family      String // "Access Control"
  title       String
  description String @default("")
  cmmcLevels  Int[]  @default([]) // levels at which this control applies (1, 2, 3)

  @@map("nist_800_171_controls")
}

model CmmcPractice {
  id          String   @id @default(cuid())
  practiceId  String   @unique // e.g. "AC.L1-3.1.1"
  level       Int // 1, 2, or 3
  domain      String // "Access Control"
  title       String
  description String   @default("")
  nistMapping String[] @default([]) // NIST 800-171 controls this practice maps to

  @@map("cmmc_practices")
}

model Section508Criterion {
  id          String   @id @default(cuid())
  criterionId String   @unique // e.g. "302.1" or "E207.2"
  category    String // "Functional Performance" | "Software" | "Hardware" | "Support Docs"
  title       String
  description String   @default("")
  appliesTo   String[] @default([]) // ICT, software, hardware, web, mobile, telecom

  @@map("section_508_criteria")
}

//////////////////////////////////////////////////////////////
// PER-OPPORTUNITY CLAUSE APPLICABILITY (tenant-scoped)
// Polymorphic across FAR / DFARS / NIST / CMMC / 508 via
// (clauseSource, clauseCode). Resolved by farCatalogService.
//////////////////////////////////////////////////////////////

model FarClauseApplicability {
  id                  String   @id @default(cuid())
  consultingFirmId    String
  opportunityId       String
  clauseSource        String   @default("FAR") // "FAR" | "DFARS" | "NIST" | "CMMC" | "508"
  clauseCode          String // "52.219-14" | "252.204-7012" | "3.1.1" | "AC.L1-3.1.1" | "302.1"
  applicabilitySource String   @default("AI_EXTRACTED") // AI_EXTRACTED | RFP_EXPLICIT | INFERRED | MANUAL
  confidence          Float    @default(0.8) // 0-1
  isBlocking          Boolean  @default(false)
  isFlowDown          Boolean  @default(false)
  notes               String?
  matrixRequirementId String? // link to the requirement that triggered this applicability
  createdAt           DateTime @default(now())

  @@index([consultingFirmId])
  @@index([opportunityId])
  @@index([clauseSource, clauseCode])
  @@map("far_clause_applicabilities")
}

//////////////////////////////////////////////////////////////
// AUDIT EVENT — first-class audit trail for every material
// action (mutations, AI inferences, decisions, exports).
// Replaces the thin ComplianceLog status-transition log.
//////////////////////////////////////////////////////////////

model AuditEvent {
  id                   String   @id @default(cuid())
  consultingFirmId     String
  actorUserId          String? // null for system / scheduled actions
  /// §8.3 — INTERNAL_USER | PARTNER_PORTAL_USER | SYSTEM. An external actor is
  /// recorded honestly here rather than borrowing an internal user id.
  actorKind            String?  @default("INTERNAL_USER")
  externalActorId      String?
  actorRole            String?
  action               String // CREATE | UPDATE | DELETE | LLM_INFERENCE | DECISION_OVERRIDE | EXPORT | APPROVAL | ACCESS
  entityType           String
  entityId             String?
  rationale            String? // typed reason for material decisions / overrides
  beforeJson           Json?
  afterJson            Json?
  // FAR-grounded inference replay fields
  farContextHash       String?
  farClausesReferenced String[] @default([])
  llmProvider          String?
  llmModel             String?
  llmTask              String?
  promptHash           String?
  inputTokens          Int?
  outputTokens         Int?
  estimatedCostUsd     Decimal? @db.Decimal(10, 6)
  // Request context
  sourceIp             String?
  userAgent            String?
  requestId            String?
  createdAt            DateTime @default(now())

  @@index([consultingFirmId])
  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_events")
}

//////////////////////////////////////////////////////////////
// PROPOSAL SECTIONS + EVIDENCE ARTIFACTS
//////////////////////////////////////////////////////////////

// Proposal parent (§5.1 Stage 5). One ACTIVE proposal per opportunity (enforced
// in the route); archived proposals are retained. Sections are the shared
// records used by both the workspace and the responsibility matrix.
enum ProposalStatus {
  ACTIVE
  ARCHIVED
}

model Proposal {
  id               String         @id @default(cuid())
  consultingFirmId String
  opportunityId    String
  title            String
  status           ProposalStatus @default(ACTIVE)
  createdByUserId  String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  consultingFirm ConsultingFirm    @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  opportunity    Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  sections       ProposalSection[]

  // §8.3
  keyPersonnel ProposalKeyPersonnel[]

  @@index([consultingFirmId, opportunityId])
  @@index([consultingFirmId, status])
  @@map("proposals")
}

model ProposalSection {
  id               String  @id @default(cuid())
  consultingFirmId String
  opportunityId    String
  proposalId       String?
  sectionNumber    String? // e.g. "L.1.2" or "Volume 1.3"
  title            String
  outline          String? // bullet outline
  draft            String? // current draft text (markdown or HTML)
  sortOrder        Int     @default(0)
  ownerUserId      String? // writer
  // OUTLINE | DRAFTING | IN_REVIEW | CHANGES_REQUESTED | APPROVED (legacy REVIEW/FINAL tolerated)
  status           String  @default("OUTLINE")

  // --- §5.1 Stage 5 workspace + responsibility matrix ---
  reviewerUserId       String?
  dueDate              DateTime?
  reviewDate           DateTime?
  notes                String?
  dependencies         String[]  @default([])
  isArchived           Boolean   @default(false)
  attachmentKey        String?
  attachmentName       String?
  submittedForReviewAt DateTime?
  approvedAt           DateTime?
  approvedByUserId     String?
  isAiGenerated        Boolean   @default(false)
  // IDLE | QUEUED | PROCESSING | COMPLETED | FAILED | CANCELLED
  generationStatus     String    @default("IDLE")
  generationError      String?

  pageLimit Int?
  wordCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proposal        Proposal?                @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  versions        ProposalSectionVersion[]
  reviews         ProposalSectionReview[]
  evidenceLinks   SectionEvidenceLink[]
  adherenceScores AdherenceScore[]

  @@index([consultingFirmId])
  @@index([opportunityId])
  @@index([proposalId])
  @@index([consultingFirmId, status])
  @@map("proposal_sections")
}

// Preserved content versions — one row per saved/generated draft. Never
// overwritten, so approved content is always recoverable.
model ProposalSectionVersion {
  id                String   @id @default(cuid())
  consultingFirmId  String
  proposalSectionId String
  version           Int
  content           String
  source            String   @default("HUMAN") // HUMAN | AI
  isAiGenerated     Boolean  @default(false)
  createdByUserId   String?
  createdAt         DateTime @default(now())

  consultingFirm ConsultingFirm  @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  section        ProposalSection @relation(fields: [proposalSectionId], references: [id], onDelete: Cascade)

  @@unique([proposalSectionId, version])
  @@index([proposalSectionId])
  @@index([consultingFirmId])
  @@map("proposal_section_versions")
}

// Assignment + review transition history (retained).
model ProposalSectionReview {
  id                String   @id @default(cuid())
  consultingFirmId  String
  proposalSectionId String
  action            String // ASSIGNED | REVIEWER_SET | SUBMITTED | APPROVED | CHANGES_REQUESTED | RESUBMITTED
  fromStatus        String?
  toStatus          String?
  actorUserId       String?
  comment           String?
  createdAt         DateTime @default(now())

  consultingFirm ConsultingFirm  @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  section        ProposalSection @relation(fields: [proposalSectionId], references: [id], onDelete: Cascade)

  @@index([proposalSectionId])
  @@index([consultingFirmId])
  @@map("proposal_section_reviews")
}

model EvidenceArtifact {
  id                      String   @id @default(cuid())
  consultingFirmId        String
  opportunityId           String? // null = tenant-wide library artifact
  artifactType            String // PAST_PERFORMANCE | CASE_STUDY | CERTIFICATION | TECHNICAL_DOC | RESUME | OTHER
  title                   String
  description             String?
  fileStorageKey          String?
  fileType                String?
  fileSize                Int?
  externalUrl             String?
  pastPerformanceRecordId String? // link to a structured past-performance record
  tags                    String[] @default([])
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  links                 SectionEvidenceLink[]
  pastPerformanceRecord PastPerformanceRecord? @relation(fields: [pastPerformanceRecordId], references: [id], onDelete: SetNull)

  @@index([consultingFirmId])
  @@index([opportunityId])
  @@index([pastPerformanceRecordId])
  @@map("evidence_artifacts")
}

model SectionEvidenceLink {
  id                 String   @id @default(cuid())
  proposalSectionId  String
  evidenceArtifactId String
  rationale          String? // why this evidence supports this section
  paragraphAnchor    String? // optional paragraph identifier within the section
  createdAt          DateTime @default(now())

  proposalSection  ProposalSection  @relation(fields: [proposalSectionId], references: [id], onDelete: Cascade)
  evidenceArtifact EvidenceArtifact @relation(fields: [evidenceArtifactId], references: [id], onDelete: Cascade)

  @@unique([proposalSectionId, evidenceArtifactId])
  @@map("section_evidence_links")
}

//////////////////////////////////////////////////////////////
// ADHERENCE SCORING — sub-dimensional, FAR-aware
//////////////////////////////////////////////////////////////

model AdherenceScore {
  id                  String   @id @default(cuid())
  consultingFirmId    String
  opportunityId       String
  proposalSectionId   String? // null = whole proposal score
  overallScore        Float // 0-100
  requirementCoverage Float? // 0-1
  evaluationAlignment Float? // 0-1 (Section M weights)
  evidenceSufficiency Float? // 0-1
  farClauseCoverage   Float? // 0-1
  readability         Float? // 0-1
  consistency         Float? // 0-1
  ambiguity           Float? // 0-1 (lower is better)
  blockersJson        Json? // structured blocker list
  computedAt          DateTime @default(now())

  proposalSection ProposalSection? @relation(fields: [proposalSectionId], references: [id], onDelete: Cascade)

  @@index([consultingFirmId])
  @@index([opportunityId])
  @@map("adherence_scores")
}

//////////////////////////////////////////////////////////////
// PAST PERFORMANCE — FAR 15.305(a)(2)(i) compliant
//////////////////////////////////////////////////////////////

model PastPerformanceRecord {
  id                       String    @id @default(cuid())
  consultingFirmId         String
  clientCompanyId          String?
  contractNumber           String
  customerName             String
  customerAgency           String?
  customerPocName          String?
  customerPocEmail         String?
  customerPocPhone         String?
  contractType             String? // FFP | T_AND_M | IDIQ | COST_REIMB | BPA
  totalValue               Decimal?  @db.Decimal(14, 2)
  periodOfPerformanceStart DateTime?
  periodOfPerformanceEnd   DateTime?
  cparsRating              String? // EXCEPTIONAL | VERY_GOOD | SATISFACTORY | MARGINAL | UNSATISFACTORY
  cparsRatingDate          DateTime? // §5.2 — user-entered CPARS date (CPARS is never auto-fetched)
  cparsLink                String?
  scopeSummary             String    @default("")
  relevanceTags            String[]  @default([]) // NAICS codes, service areas, complexity tags
  isCurrent                Boolean   @default(true)

  // §5.1 Stage 10 / §5.2 — richer library fields (all additive/nullable)
  contractTitle         String?
  contractingOffice     String?
  naicsCode             String?
  pscCode               String?
  fundedValue           Decimal? @db.Decimal(14, 2)
  performerRole         String? // PRIME | SUB
  workPerformed         String?
  technicalCapabilities String?
  resultsOutcomes       String?
  quantitativeMetrics   String?
  setAsideRelevance     String?
  // Reference contact (private — gated to authorized roles)
  referenceName         String?
  referenceTitle        String?
  referenceEmail        String?
  referencePhone        String?
  permissionToContact   Boolean  @default(false)
  referenceAvailability String? // AVAILABLE | LIMITED | UNAVAILABLE
  internalNotes         String?
  verificationStatus    String   @default("DRAFT") // DRAFT | VERIFIED | APPROVED
  ownerUserId           String?
  isArchived            Boolean  @default(false)
  linkedOpportunityId   String? // loose scalar FK (no cascade) to originating opportunity
  // Idempotency key for create-from-completed-contract (one PP record per contract).
  sourceContractId      String?  @unique

  // Idempotency key for auto-capture. Set when a record is auto-created from a
  // SubmissionRecord whose outcome was marked WON; null for manually-entered
  // records. @unique so re-recording the same WON outcome never duplicates.
  // Kept as a plain scalar (not a relation) so the won-contract record survives
  // deletion of the originating submission.
  sourceSubmissionRecordId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientCompany     ClientCompany?              @relation(fields: [clientCompanyId], references: [id], onDelete: SetNull)
  evidenceArtifacts EvidenceArtifact[]
  attachments       PastPerformanceAttachment[]
  selections        PastPerformanceSelection[]

  @@index([consultingFirmId])
  @@index([clientCompanyId])
  @@index([consultingFirmId, customerAgency])
  @@index([consultingFirmId, naicsCode])
  @@index([consultingFirmId, isArchived])
  @@map("past_performance_records")
}

//////////////////////////////////////////////////////////////
// CAPTURE WORKSPACE — pursuit Kanban + partner / competitor map
//////////////////////////////////////////////////////////////

model CapturePlan {
  id               String   @id @default(cuid())
  consultingFirmId String
  opportunityId    String   @unique
  stage            String   @default("IDENTIFY") // IDENTIFY | QUALIFY | PURSUE | POSITION | BID
  winThemes        String[] @default([])
  discriminators   String[] @default([])
  ghostingTargets  String[] @default([]) // competitor weaknesses to subtly highlight
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tasks CaptureTask[]

  @@index([consultingFirmId])
  @@map("capture_plans")
}

model CaptureTask {
  id            String    @id @default(cuid())
  capturePlanId String
  title         String
  description   String?
  ownerUserId   String?
  status        String    @default("OPEN") // OPEN | IN_PROGRESS | DONE | BLOCKED
  priority      String    @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  dueDate       DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  capturePlan CapturePlan @relation(fields: [capturePlanId], references: [id], onDelete: Cascade)

  @@index([capturePlanId])
  @@map("capture_tasks")
}

// Whether a teaming partner acts as a prime, a subcontractor, or both
// (§5.1 Stage 4 / §5.2 teaming & subcontractor tracker).
enum PartnerType {
  PRIME
  SUB
  BOTH
}

// Where a partner sits in the outreach → commitment lifecycle for a bid.
enum TeamingStatus {
  IDENTIFIED
  INVITED
  INTERESTED
  COMMITTED
  DECLINED
}

// Lifecycle of a teaming agreement / NDA on an arrangement.
enum AgreementStatus {
  NONE
  DRAFT
  SENT
  SIGNED
}

enum TeamingDraftType {
  TEAMING_AGREEMENT
  NDA
}

model Partner {
  id                  String      @id @default(cuid())
  consultingFirmId    String
  name                String
  uei                 String?
  cage                String?
  primarySetAsides    String[]    @default([])
  primaryNaicsCodes   String[]    @default([])
  capabilities        String[]    @default([])
  certifications      String[]    @default([])
  cmmcLevel           Int?
  pastPerformanceLink String?
  website             String?
  geography           String?
  partnerType         PartnerType @default(BOTH)
  pastRelationship    String?
  ownerUserId         String?
  contactName         String?
  contactEmail        String?
  contactPhone        String?
  notes               String?
  isActive            Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  consultingFirm         ConsultingFirm                 @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  arrangements           TeamingArrangement[]
  performanceRecords     PartnerPerformanceRecord[]
  attributedDeliverables ContractDeliverable[]
  contacts               PartnerContact[]
  portalUsers            PartnerPortalUser[]
  portalUploads          PartnerPortalUpload[]
  personnelSubmissions   PartnerPersonnelSubmission[]
  sourcedPersonnel       Personnel[]
  crmActivities          CrmActivity[]
  crmFollowUps           CrmFollowUp[]
  purchaseOrders         PurchaseOrder[]
  subcontractInvoices    SubcontractInvoice[]
  deliverableSubmissions PartnerDeliverableSubmission[]
  profileChangeRequests  PartnerProfileChangeRequest[]

  // One row per real-world company per firm — duplicate partners split the
  // teaming history the graph/recommender score. NULL UEIs stay unconstrained
  // (Postgres treats NULLs as distinct), so partners without a UEI are fine.
  @@unique([consultingFirmId, uei])
  @@index([consultingFirmId])
  @@index([consultingFirmId, isActive])
  @@map("partners")
}

model TeamingArrangement {
  id                String   @id @default(cuid())
  consultingFirmId  String
  opportunityId     String
  partnerId         String
  role              String // PRIME | SUB | JV_MEMBER | MENTOR_PROTEGE
  arrangementType   String // TEAMING_AGREEMENT | JV | MPA | CTA | INFORMAL
  scopePercent      Float? // workshare percentage (0-100)
  dollarShare       Decimal? @db.Decimal(14, 2)
  flowDownPackageId String? // future: link to generated subcontract clause set
  notes             String?

  // --- §5.1 Stage 4 teaming & subcontractor tracking ---
  teamingStatus          TeamingStatus   @default(IDENTIFIED)
  capabilityContribution String?
  capabilityGap          String?
  workshareDescription   String?
  agreementStatus        AgreementStatus @default(NONE)
  agreementSignedDate    DateTime?
  agreementDueDate       DateTime?
  ndaStatus              AgreementStatus @default(NONE)
  ownerUserId            String?
  agreementDocumentKey   String? // stored upload key (reuses the shared /uploads storage)
  agreementDocumentName  String?
  isArchived             Boolean         @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner         Partner                 @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  consultingFirm  ConsultingFirm          @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  opportunity     Opportunity             @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  agreementDrafts TeamingAgreementDraft[]

  // A partner holds a given role on a bid once — retried/double-submitted
  // creates were silently double-counting teamedValue, arrangements, and
  // win/loss credit in the graph (the "moat" metrics).
  @@unique([consultingFirmId, opportunityId, partnerId, role])
  @@index([consultingFirmId])
  @@index([opportunityId])
  @@index([partnerId])
  @@index([consultingFirmId, agreementStatus])
  @@map("teaming_arrangements")
}

// Versioned, editable agreement/NDA drafts for a teaming arrangement. Each
// generation/edit appends a new row (prior versions preserved). Drafts are
// never executed agreements — they carry a mandatory review disclaimer.
model TeamingAgreementDraft {
  id                   String           @id @default(cuid())
  consultingFirmId     String
  teamingArrangementId String
  draftType            TeamingDraftType @default(TEAMING_AGREEMENT)
  version              Int              @default(1)
  content              String // full draft text (editable)
  generatedByUserId    String?
  createdAt            DateTime         @default(now())

  consultingFirm     ConsultingFirm     @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  teamingArrangement TeamingArrangement @relation(fields: [teamingArrangementId], references: [id], onDelete: Cascade)

  @@unique([teamingArrangementId, draftType, version])
  @@index([consultingFirmId])
  @@index([teamingArrangementId])
  @@map("teaming_agreement_drafts")
}

// FIX-6 — human-in-the-loop attestation on AI-drafted proposals.
// One row per opportunity (the draft lives on Opportunity.savedProposalDraft).
// draftContentHash pins the exact draft the human signed off on; if the draft
// is later regenerated the hash diverges and the attestation reads as STALE,
// forcing a fresh review before a "final" (human-reviewed) PDF can be exported.
model ProposalAttestation {
  id               String   @id @default(cuid())
  consultingFirmId String
  opportunityId    String   @unique
  attestedByUserId String?
  attestedByName   String
  statementVersion String
  statementText    String
  draftContentHash String
  attestedAt       DateTime @default(now())

  consultingFirm ConsultingFirm @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  opportunity    Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([consultingFirmId])
  @@map("proposal_attestations")
}

// Capture & Qualification evidence (§5.1 Stage 3). One row per (firm,
// opportunity, kind, company) — repaired from the previously-orphaned model to
// persist BOTH the identified incumbent (evidenceKind=INCUMBENT) and historical
// competitors (evidenceKind=COMPETITOR), derived deterministically from
// AwardHistory. Auto fields are recomputed on refresh; manual verification /
// correction / notes are preserved. `normalizedName` dedupes company rows.
model Competitor {
  id                  String   @id @default(cuid())
  consultingFirmId    String
  opportunityId       String
  name                String
  normalizedName      String   @default("")
  uei                 String?
  isIncumbent         Boolean  @default(false)
  perceivedStrengths  String[] @default([])
  perceivedWeaknesses String[] @default([])
  pastWinsAtAgency    Int?
  notes               String?

  // --- evidence layer ---
  evidenceKind   EvidenceKind       @default(COMPETITOR)
  confidence     EvidenceConfidence @default(NOT_AVAILABLE)
  evidenceSource String? // e.g. "USASpending award history", "SAM.gov award notice", "Manual"
  whyShown       String? // human-readable explanation of why this row appears
  agency         String?
  naicsRelevant  Boolean            @default(false)
  pscRelevant    Boolean            @default(false)
  agencyRelevant Boolean            @default(false)

  // Award reference (incumbent) + relevant-award aggregates (competitor).
  awardReference      String?
  awardValue          Decimal?  @db.Decimal(14, 2)
  periodOfPerformance String?
  relevantAwardCount  Int?
  relevantAwardValue  Decimal?  @db.Decimal(14, 2)
  sourceRecordDate    DateTime? // date of the underlying award record
  lastRefreshedAt     DateTime?

  // Incumbent manual verification / correction. originalName/Uei preserve the
  // source-derived evidence after a human correction.
  verification     IncumbentVerification @default(UNVERIFIED)
  verifiedByUserId String?
  verifiedAt       DateTime?
  correctionReason String?
  originalName     String?
  originalUei      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([consultingFirmId, opportunityId, evidenceKind, normalizedName])
  @@index([consultingFirmId])
  @@index([opportunityId, evidenceKind])
  @@map("competitors")
}

//////////////////////////////////////////////////////////////
// COLOR-TEAM REVIEW CYCLES (Pink / Red / Gold / White)
//////////////////////////////////////////////////////////////

model ReviewCycle {
  id               String    @id @default(cuid())
  consultingFirmId String
  opportunityId    String
  cycleType        String // PINK | RED | GOLD | WHITE
  status           String    @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | APPROVED | REJECTED
  startedAt        DateTime  @default(now())
  closedAt         DateTime?
  approverUserId   String?
  approvalNotes    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  comments ReviewComment[]

  @@index([consultingFirmId])
  @@index([opportunityId])
  @@map("review_cycles")
}

model ReviewComment {
  id                  String    @id @default(cuid())
  reviewCycleId       String
  authorUserId        String?
  proposalSectionId   String?
  matrixRequirementId String?
  parentCommentId     String?
  body                String
  severity            String    @default("INFO") // INFO | MINOR | MAJOR | BLOCKER
  status              String    @default("OPEN") // OPEN | RESOLVED | WONT_FIX
  resolvedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  reviewCycle ReviewCycle @relation(fields: [reviewCycleId], references: [id], onDelete: Cascade)

  @@index([reviewCycleId])
  @@map("review_comments")
}

//////////////////////////////////////////////////////////////
// CMMC STATUS + COST VOLUME (Phase 4 entities, schema landed early)
//////////////////////////////////////////////////////////////

model CmmcStatus {
  id                String    @id @default(cuid())
  consultingFirmId  String
  clientCompanyId   String? // null = tenant-wide; set = specific client
  level             Int // 1 | 2 | 3
  status            String // SELF_ASSESSED | C3PAO_AUDIT_SCHEDULED | CERTIFIED | EXPIRED
  certifyingBody    String?
  certificationDate DateTime?
  expirationDate    DateTime?
  scope             String?
  sprsScore         Int? // -203 to 110
  poamCount         Int? // open POA&Ms
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([consultingFirmId])
  @@index([clientCompanyId])
  @@map("cmmc_statuses")
}

model CostVolume {
  id                   String   @id @default(cuid())
  consultingFirmId     String
  opportunityId        String
  scenarioName         String   @default("Base")
  contractType         String? // FFP | T_AND_M | IDIQ | COST_REIMB
  laborCategoriesJson  Json?
  indirectRatesJson    Json?
  odcLinesJson         Json?
  travelLinesJson      Json?
  totalProposedPrice   Decimal? @db.Decimal(14, 2)
  unallowableFlagsJson Json? // FAR 31.205 violations detected
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([consultingFirmId])
  @@index([opportunityId])
  @@map("cost_volumes")
}

//////////////////////////////////////////////////////////////
// EMAIL VERIFICATION
//////////////////////////////////////////////////////////////

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  token      String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("email_verification_tokens")
}

//////////////////////////////////////////////////////////////
// LEGAL — VERSIONED TERMS OF SERVICE + BETA NDA
// UserAgreement rows are immutable evidence of acceptance:
// (userId, documentType, version, contentHash, ip, userAgent, acceptedAt).
// The contentHash binds the acceptance to the exact text that was shown.
//////////////////////////////////////////////////////////////

model TermsOfServiceVersion {
  id          String   @id @default(cuid())
  version     String   @unique // "1.0", "1.1", etc.
  title       String   @default("Terms of Service")
  body        String // full markdown body
  contentHash String // sha256 of body
  effectiveAt DateTime @default(now())
  isCurrent   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([isCurrent])
  @@map("tos_versions")
}

model BetaNdaVersion {
  id          String   @id @default(cuid())
  version     String   @unique
  title       String   @default("Beta Non-Disclosure & IP Protection Agreement")
  body        String
  contentHash String
  effectiveAt DateTime @default(now())
  isCurrent   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([isCurrent])
  @@map("beta_nda_versions")
}

//////////////////////////////////////////////////////////////
// BETA WEEKLY QUESTIONNAIRE
// One questionnaire per ISO week (publishes Monday 13:00 UTC).
// Login is gated until the current week's questionnaire is answered
// — this is how we collect beta-feedback discipline. The worker
// in workers/betaQuestionnaireWorker.ts publishes weekly and
// emails reminders.
//////////////////////////////////////////////////////////////

model BetaWeeklyQuestionnaire {
  id            String   @id @default(cuid())
  weekStarting  DateTime @unique // Monday 00:00 UTC of the week
  title         String   @default("Weekly Beta Feedback")
  questionsJson Json // [{id, type, prompt, options?, required}]
  publishedAt   DateTime @default(now()) // when the worker created it
  isActive      Boolean  @default(true) // false = retired, no longer gates login

  responses BetaQuestionnaireResponse[]

  @@index([weekStarting])
  @@index([isActive])
  @@map("beta_weekly_questionnaires")
}

model BetaQuestionnaireResponse {
  id               String   @id @default(cuid())
  questionnaireId  String
  userId           String
  consultingFirmId String
  answersJson      Json // {questionId: answer}
  submittedAt      DateTime @default(now())
  ip               String?
  userAgent        String?

  questionnaire BetaWeeklyQuestionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)

  @@unique([questionnaireId, userId])
  @@index([userId])
  @@index([consultingFirmId])
  @@map("beta_questionnaire_responses")
}

model UserAgreement {
  id           String   @id @default(cuid())
  userId       String
  documentType String // "TOS" | "BETA_NDA"
  documentId   String // id of the TermsOfServiceVersion or BetaNdaVersion
  version      String // denormalized version label for fast queries
  contentHash  String // denormalized content hash binds acceptance to exact text
  acceptedAt   DateTime @default(now())
  ip           String?
  userAgent    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, documentType, version])
  @@index([userId])
  @@index([documentType, version])
  @@map("user_agreements")
}

//////////////////////////////////////////////////////////////
// WINNERS INTEL — staging tables for USAspending pulls
// See .ai/WINNERS_INTEL_SPEC.md §4.1
//
// These tables hold raw award data pulled from USAspending. They are NOT
// tenant-scoped (the source data is public) and write-once-per-batch.
// Distillation into per-agency / per-NAICS markdown slices happens in a
// separate pass; the slice MDs live on disk under data/winners/, not in
// these tables. Pruning keeps the most recent 4 refreshBatchIds on disk.
//////////////////////////////////////////////////////////////

model WinnersAwardStage {
  id                        String    @id @default(cuid())
  usaspendingAwardId        String    @unique
  pieceOfTheActionId        String?
  recipientUei              String?
  recipientName             String?
  recipientParentUei        String?
  agencyToptierCode         String? // e.g. "9700" DoD
  agencyToptierName         String?
  agencySubtierCode         String?
  awardingOfficeCode        String?
  fundingAgencyToptier      String?
  naics                     String?
  pscCode                   String?
  setAsideType              String? // SBA, SDVOSBC, WOSB, 8A, HZC, ...
  contractType              String? // BPA, IDV, etc.
  competitionExtent         String? // FULL_AND_OPEN, ONE_BID, ...
  numberOfOffersReceived    Int?
  totalObligation           Decimal?  @db.Decimal(16, 2)
  baseExercisedOptions      Decimal?  @db.Decimal(16, 2)
  baseAndAllOptions         Decimal?  @db.Decimal(16, 2)
  periodOfPerformanceStart  DateTime?
  periodOfPerformanceEnd    DateTime?
  awardDate                 DateTime?
  fiscalYear                Int?
  placeOfPerformanceState   String?
  placeOfPerformanceCountry String?
  recipientStateCode        String?
  recipientCountryCode      String?
  isRecompete               Boolean   @default(false)
  ingestedAt                DateTime  @default(now())
  refreshBatchId            String

  @@index([agencyToptierCode, fiscalYear])
  @@index([naics, fiscalYear])
  @@index([agencyToptierCode, pscCode])
  @@index([agencyToptierCode, setAsideType])
  @@index([recipientUei])
  @@index([refreshBatchId])
  @@map("winners_award_stage")
}

model WinnersSubawardStage {
  id                        String    @id @default(cuid())
  usaspendingSubawardId     String    @unique
  primeAwardId              String // refs WinnersAwardStage.usaspendingAwardId (logical only — not enforced FK because batches refresh independently)
  subAmount                 Decimal?  @db.Decimal(16, 2)
  subActionDate             DateTime?
  subRecipientUei           String?
  subRecipientName          String?
  subRecipientParentUei     String?
  subRecipientStateCode     String?
  subRecipientSize          String? // small | large | unknown
  subRecipientSetAsideFlags Json? // { sdvosb: bool, wosb: bool, hubzone: bool, eightA: bool }
  subDescription            String? // service description provided by prime
  subNaics                  String?
  subPscCode                String?
  ingestedAt                DateTime  @default(now())
  refreshBatchId            String

  @@index([primeAwardId])
  @@index([subRecipientUei])
  @@index([subNaics])
  @@index([refreshBatchId])
  @@map("winners_subaward_stage")
}

//////////////////////////////////////////////////////////////
// TEAMING RELATIONSHIP (Agency feature, Phase F1)
//
// Persists a saved (client × prime × agency) teaming pursuit so the
// operator can track the funnel from "I noticed this prime" through
// "we're actively teaming on a bid." Tenant-scoped by consultingFirmId.
// Unique on the triple so the operator can't double-create.
//////////////////////////////////////////////////////////////

model TeamingRelationship {
  id               String  @id @default(cuid())
  consultingFirmId String
  clientCompanyId  String
  primeUei         String
  /// Snapshot of prime name at save time — primes get renamed, UEI is the stable key.
  primeName        String?
  /// USAspending toptier code (e.g. "9700" for DoD).
  agencyCode       String
  /// Snapshot of agency name at save time, same rationale as primeName.
  agencyName       String?

  status TeamingRelationshipStatus @default(IDENTIFIED)

  /// Fit score at save time — useful for trend if score later changes.
  fitScoreAtSave Float?
  /// Operator-facing notes; keep small (<2KB) to stay in this row.
  notes          String?

  /// Most recent outreach event timestamp; null until the operator drafts.
  lastOutreachAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? // user id of the operator who saved it

  consultingFirm ConsultingFirm @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  clientCompany  ClientCompany  @relation(fields: [clientCompanyId], references: [id], onDelete: Cascade)

  @@unique([consultingFirmId, clientCompanyId, primeUei, agencyCode])
  @@index([consultingFirmId])
  @@index([clientCompanyId])
  @@index([primeUei])
  @@index([status])
  @@map("teaming_relationships")
}

//////////////////////////////////////////////////////////////
// RECIPIENT PROFILE — cached SAM.gov enrichment for any UEI
// the operator drills into from a subaward row.
//
// Not tenant-scoped: recipient data is shared public info, identical
// to the WinnersAwardStage / WinnersSubawardStage tables. Cached so
// repeated drill-downs don't re-hit SAM. Stale rows (samFetchedAt
// older than 30 days) are refreshed lazily on next read.
//
// vaOsdbuVerified (SCW Phase 2 addition): platform-managed, not from SAM.
// Set to true only when an operator has confirmed VA OSDBU verification
// for that UEI. Critical for FAR / 38 USC 8127 compliance on VA BID SUB
// opportunities — SBA-self-certified SDVOSB is NOT sufficient for VA.
//////////////////////////////////////////////////////////////

model RecipientProfile {
  id                String    @id @default(cuid())
  uei               String    @unique
  legalName         String?
  cageCode          String?
  samRegStatus      String?
  samRegExpiry      DateTime?
  website           String?
  phone             String?
  streetAddress     String?
  city              String?
  state             String?
  zipCode           String?
  /// JSON array of NAICS codes from SAM goodsAndServices.
  naicsCodes        Json?
  sdvosb            Boolean   @default(false)
  wosb              Boolean   @default(false)
  hubzone           Boolean   @default(false)
  smallBusiness     Boolean   @default(false)
  /// True only when an operator has manually confirmed the UEI's VA OSDBU
  /// verification status. Not derivable from SAM Entity data alone.
  vaOsdbuVerified   Boolean   @default(false)
  /// Last time SAM.gov was successfully queried for this UEI.
  samFetchedAt      DateTime?
  /// Last time any contact-enrichment provider populated contactsJson.
  contactsFetchedAt DateTime?
  /// Provider key for the last contact pull: 'sam_poc' | 'apollo' | 'hunter' | ...
  contactsProvider  String?
  /// JSON array of { name, title, email, phone, source }. Capped to ~50 entries to keep row size sane.
  contactsJson      Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([legalName])
  @@index([samFetchedAt])
  @@index([vaOsdbuVerified])
  @@map("recipient_profiles")
}

//////////////////////////////////////////////////////////////
// MCP SUITE (additive, mandated by CLAUDE.md §6.4 and §4.4)
//
// These models exist only to support the MCP server suite under
// /mcp. They are intentionally NOT related (@relation) to existing
// app models so that adding them does not touch ConsultingFirm or
// any other production model. Tenant linkage is enforced at the
// application layer via the consultingFirmId column.
//////////////////////////////////////////////////////////////

enum ApiTokenTier {
  CORE
  PRO
  VAULT
}

/// Long-lived bearer credential issued to an MCP host (Claude Desktop,
/// Claude Code, etc.). Validated by hashing the presented bearer and
/// matching tokenHash. The raw token is never persisted.
model ApiToken {
  id               String       @id @default(uuid())
  name             String
  consultingFirmId String
  tokenHash        String       @unique
  tokenPrefix      String
  tier             ApiTokenTier @default(CORE)
  /// Which delivery interface minted this credential. Existing rows default to
  /// MCP, so MCP behaviour is unchanged; the public REST API accepts only
  /// PUBLIC_API and the MCP resolver refuses anything that is not MCP.
  kind             ApiTokenKind @default(MCP)
  scopes           String[]     @default([])
  lastUsedAt       DateTime?
  expiresAt        DateTime?
  revokedAt        DateTime?
  createdAt        DateTime     @default(now())
  createdBy        String?

  @@index([consultingFirmId])
  @@index([tokenHash])
  @@map("api_tokens")
}

/// One row per MCP tool invocation. Append-only at the application
/// layer; database-role enforcement of append-only is v0.2 work.
/// Schema mirrors CLAUDE.md §6.4 exactly.
model McpAuditLog {
  id            BigInt   @id @default(autoincrement())
  ts            DateTime @default(now()) @db.Timestamptz(6)
  serverName    String   @map("server_name")
  serverVersion String   @map("server_version")
  toolName      String   @map("tool_name")
  tenantId      String   @map("tenant_id") @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  tokenFp       String   @map("token_fp") @db.Char(16)
  inputHash     String   @map("input_hash") @db.Char(64)
  outputBytes   Int      @map("output_bytes")
  durationMs    Int      @map("duration_ms")
  outcome       String
  correlationId String?  @map("correlation_id")
  clientInfo    Json?    @map("client_info")

  @@index([tenantId, ts(sort: Desc)])
  @@index([serverName, toolName, ts(sort: Desc)])
  @@map("mcp_audit_log")
}

//////////////////////////////////////////////////////////////
// SCW SUBAWARD ANALYSIS CACHE
//
// Per SUBCONTRACTING_WORKFLOW_SPEC.md §4. Stores the result of an SCW-2
// subaward-history computation for a given prime, expiring after 7 days
// so the next read forces a recompute against fresh winners_subaward_stage
// data.
//
// Keyed by primeKey rather than just primeUei because the corpus currently
// has UEI populated on only ~3.4% of award rows (381/11222) — see
// docs/scw/data-layer-introspection.md §9. primeKey is "uei:UEIVALUE" when
// available, else "name:UPPERCASED_NAME" — both stable identifiers within
// the corpus snapshot.
//////////////////////////////////////////////////////////////

model ScwSubawardAnalysis {
  id            String  @id @default(cuid())
  /// Composite key — "uei:<UEI>" or "name:<UPPERCASED_NAME>". See model doc.
  primeKey      String
  /// Optional surface fields so the cache row is self-describing without
  /// having to parse primeKey.
  primeUei      String?
  primeName     String?
  lookbackYears Int

  totalSubawardDollars Decimal? @db.Decimal(16, 2)
  averageSubSize       Decimal? @db.Decimal(16, 2)
  /// Sample size (number of subaward rows aggregated). Drives confidence.
  sampleSize           Int

  /// Stored as percentages 0–100, or null when the underlying data is
  /// unavailable (currently always null — see R4 in docs/scw/).
  smallBusinessPercent Float?
  sdvosbPercent        Float?

  /// JSON array of { naicsCode, dollars, count }. Null when subNaics is
  /// universally null in the corpus (current state).
  topNaicsSubbed Json?

  /// JSON { fiscalYear, goalPercent, actualPercent, gapPercent,
  /// underPressure, source }. underPressure=true when gap > 0.5%.
  sdvosbGoalGap Json?

  /// JSON { sampleSize, warnings: string[] }. The warnings list is
  /// non-empty whenever a field had to be returned as null/unknown.
  dataQuality Json

  computedAt DateTime @default(now())
  expiresAt  DateTime

  @@unique([primeKey, lookbackYears])
  @@index([primeUei])
  @@index([primeName])
  @@index([expiresAt])
  @@map("scw_subaward_analyses")
}

//////////////////////////////////////////////////////////////
// SCW OUTREACH DRAFT (audit trail of generated drafts)
//
// Per SUBCONTRACTING_WORKFLOW_SPEC.md §4. Every SCW-4 draft persists here
// with requiresHumanReview=true. The route surface for approval/send is
// strictly human-in-the-loop per spec §2.7 — there is no auto-send code
// path in v1.
//
// Diverges from the spec on primeUei nullability: corpus has UEI populated
// on ~3% of award rows, so name-only drafts are common. primeName is
// captured as a stable display fallback and primeUei stays nullable.
//////////////////////////////////////////////////////////////

model ScwOutreachDraft {
  id               String         @id @default(cuid())
  opportunityId    String
  opportunity      Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  consultingFirmId String
  consultingFirm   ConsultingFirm @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  primeUei         String?
  primeName        String

  /// cold_first_touch | warm_follow_up | urgent_deadline_driven
  outreachType String

  subject    String
  body       String
  /// Optional rendered salutation / closing for UI display.
  salutation String?
  closing    String?

  /// JSON array of { claim, source } — every numeric/proper-noun claim in
  /// the body must appear here, sourced from the input grounding. Verified
  /// by the SCW-4 fact-check pass before persistence.
  factsCited      Json
  /// JSON array of strings — the human reviewer must check each off before
  /// approval is allowed.
  reviewChecklist Json

  requiresHumanReview Boolean   @default(true)
  humanApprovedAt     DateTime?
  humanApprovedById   String?
  humanApprovedBy     User?     @relation(fields: [humanApprovedById], references: [id], onDelete: SetNull)

  /// Set by the operator's email client integration when the draft is
  /// known to have been sent. Always null in v1 (no auto-send).
  sentAt DateTime?

  /// GB-104 — recipient email threaded from contact enrichment so the
  /// outreach has a deliverable address. Null when none resolves
  /// (fallback "missing recipient" state). emailVerificationStatus gates
  /// auto-send: only `verified` may auto-send; `probable`/`unknown`
  /// require explicit human confirmation. emailSource records the
  /// enrichment provider/origin (e.g. "sam.gov").
  recipientEmail          String?
  emailVerificationStatus EmailVerificationStatus @default(unknown)
  emailSource             String?

  /// LLM telemetry for cost/audit visibility, mirrored on AuditEvent.
  llmProvider String?
  llmModel    String?
  tokensUsed  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([opportunityId])
  @@index([consultingFirmId])
  @@index([primeUei])
  @@index([primeName])
  @@index([requiresHumanReview, humanApprovedAt])
  @@map("scw_outreach_drafts")
}

//////////////////////////////////////////////////////////////
// GB-103 CLIENT MATCH NOTIFICATIONS
//
// NotificationPreference: per-client opt-in + threshold + cadence for
// "a new opportunity matches your profile" emails.
// SentNotification: idempotency ledger + audit trail. The
// (clientCompanyId, opportunityId) unique constraint guarantees the
// diff job never double-sends, even across re-runs.
//////////////////////////////////////////////////////////////

enum NotificationChannel {
  EMAIL
}

enum NotificationFrequency {
  IMMEDIATE
  DIGEST
}

model NotificationPreference {
  id               String @id @default(uuid())
  consultingFirmId String
  clientCompanyId  String @unique

  channel           NotificationChannel   @default(EMAIL)
  /// Minimum match score (0-100) an opportunity must reach for this client
  /// to be notified.
  minMatchThreshold Int                   @default(70)
  frequency         NotificationFrequency @default(IMMEDIATE)
  enabled           Boolean               @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consultingFirm ConsultingFirm @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  clientCompany  ClientCompany  @relation(fields: [clientCompanyId], references: [id], onDelete: Cascade)

  @@index([consultingFirmId])
  @@map("notification_preferences")
}

model SentNotification {
  id               String @id @default(uuid())
  consultingFirmId String
  clientCompanyId  String
  opportunityId    String

  /// Match score (0-100) at the moment the notification was sent.
  scoreAtSend Int
  channel     NotificationChannel @default(EMAIL)
  sentAt      DateTime            @default(now())

  consultingFirm ConsultingFirm @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  clientCompany  ClientCompany  @relation(fields: [clientCompanyId], references: [id], onDelete: Cascade)
  opportunity    Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  // Idempotency: one notification per (client, opportunity) pair, ever.
  @@unique([clientCompanyId, opportunityId])
  @@index([consultingFirmId])
  @@index([opportunityId])
  @@map("sent_notifications")
}

/// GB-104 — confidence in a resolved recipient email. `verified` =
/// confirmed deliverable / operator-confirmed (auto-send allowed);
/// `probable` = resolved from an authoritative source but role/
/// deliverability unconfirmed; `unknown` = no email resolved. Lowercase
/// to mirror the GB-104 spec contract.
enum EmailVerificationStatus {
  verified
  probable
  unknown
}

//////////////////////////////////////////////////////////////
// GB-106 PLATFORM & VEHICLE ONBOARDING (additive, see backend/src/gb106)
//////////////////////////////////////////////////////////////

/// Reference data: federal platforms, vehicles, and registrations. Global, not tenant-scoped.
model OnboardingProgram {
  id                  String    @id @default(cuid())
  code                String    @unique
  name                String
  shortName           String
  tier                Int
  category            String
  administeringAgency String
  description         String
  officialUrl         String
  prerequisites       String[]
  keyRequirements     String[]
  relevanceTags       String[]
  coreFor             String[]
  registrationModel   String
  nextWindowOpensAt   DateTime?
  nextWindowClosesAt  DateTime?
  verificationStatus  String
  lastVerifiedAt      DateTime?
  sourceUrls          String[]
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  progress OnboardingProgress[]

  @@index([tier])
  @@index([verificationStatus])
  @@map("onboarding_programs")
}

/// Per-tenant progress against a program. Tenant-scoped.
model OnboardingProgress {
  id          String    @id @default(cuid())
  tenantId    String
  programCode String
  status      String    @default("NOT_STARTED")
  startedAt   DateTime?
  completedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  program OnboardingProgram @relation(fields: [programCode], references: [code], onDelete: Cascade)

  @@unique([tenantId, programCode])
  @@index([tenantId])
  @@map("onboarding_progress")
}

// =============================================================
// Who-Wins v1 — public-label win prior (docs/WHO_WINS_MODEL.md)
// Platform-wide public USAspending data — NO tenant scoping.
// =============================================================

/// One row per COMPETED base prime award from the USAspending award-summary
/// download (extent_competed A/D/E/F/CDO only; award types A-D; ≥$10k).
/// This is the training corpus for segment priors + the matchup model.
model PublicAwardTraining {
  id                 String   @id @default(cuid())
  /// piid + awarding agency code — the award-summary natural key.
  awardKey           String   @unique
  piid               String
  naicsCode          String
  agencyCode         String?
  agencyName         String?
  setAsideCode       String? // FPDS type_of_set_aside_code (NONE, SDVOSBC, 8A, ...)
  extentCompetedCode String? // A | D | E | F | CDO (competed family only)
  /// Winsorized to [1, 50] at ingest; null = not reported (kept for
  /// experience/incumbency counting, excluded from offers statistics).
  offersReceived     Int?
  recipientUei       String
  recipientParentUei String?
  recipientName      String?
  recipientStateCode String?
  obligatedAmount    Decimal  @db.Decimal(16, 2)
  actionDate         DateTime
  fiscalYear         Int
  ingestBatchId      String
  ingestedAt         DateTime @default(now())

  @@index([naicsCode, fiscalYear])
  @@index([recipientUei])
  @@index([recipientParentUei])
  @@index([agencyCode])
  @@index([ingestBatchId])
  @@map("public_award_training")
}

/// Shrunk segment statistics — one row per (modelVersion, NAICS level,
/// set-aside bucket). meanInvOffers is E[1/K]: the calibrated win rate of a
/// random qualified entrant. Shrinkage ladder: GLOBAL → NAICS2 → NAICS4 →
/// NAICS6, pseudo-count blending (see docs/WHO_WINS_MODEL.md §3).
model PublicWinPrior {
  id                    String   @id @default(cuid())
  modelVersion          String
  segmentLevel          String // GLOBAL | NAICS2 | NAICS4 | NAICS6
  naicsPrefix           String // '' for GLOBAL
  setAsideBucket        String // ANY | NONE | SMALL_BUSINESS | SDVOSB | WOSB | HUBZONE | SBA_8A | OTHER
  awardCount            Int
  offersKnownCount      Int
  meanInvOffers         Float // raw E[1/K] where offers known
  shrunkMeanInvOffers   Float // after EB ladder shrinkage — USE THIS
  meanOffers            Float?
  medianOffers          Float?
  singleOfferShare      Float?
  incumbencyShare       Float? // raw share of awards won by a repeat NAICS4 winner
  shrunkIncumbencyShare Float?
  builtAt               DateTime @default(now())

  @@unique([modelVersion, segmentLevel, naicsPrefix, setAsideBucket])
  @@index([modelVersion, naicsPrefix])
  @@map("public_win_priors")
}

/// A fitted who-wins model version: conditional-logit coefficients + feature
/// standardization stats + the out-of-time evaluation report. Exactly one row
/// may be ACTIVE; the runtime prior uses the ACTIVE version's priors + model.
model WhoWinsModel {
  id             String   @id @default(cuid())
  version        String   @unique
  status         String   @default("CANDIDATE") // CANDIDATE | ACTIVE | ARCHIVED
  coefficients   Json // { featureName: beta }
  featureStats   Json // { featureName: { mean, sd } }
  trainingGroups Int
  trainingConfig Json // { negativesPerAward, seed, trainMaxFy, minSegmentWinners, ... }
  evalReport     Json? // ranking lift + prior stability (docs §5)
  trainedAt      DateTime @default(now())

  @@index([status])
  @@map("who_wins_models")
}

/// Last-success ledger for every scheduled/background job, fed by
/// wireJobObservability (BullMQ workers) and POST /api/ops/heartbeat
/// (host scripts like the nightly backup). The ops watchdog alerts when a
/// registered job's lastSuccessAt goes stale — the dead-man's switch the
/// 34-night silent backup failure demanded.
model JobHeartbeat {
  id            String    @id @default(cuid())
  jobName       String    @unique
  lastSuccessAt DateTime?
  lastFailureAt DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("job_heartbeats")
}

//////////////////////////////////////////////////////////////
// MODULE 2 — REGISTRATION, CERTIFICATION & INSURANCE (Section 5)
// Registration health dashboard + Certification & Insurance Log.
// Expiry status is COMPUTED from *Date fields (never stored stale).
//////////////////////////////////////////////////////////////

model RegistrationProfile {
  id               String    @id @default(uuid())
  consultingFirmId String    @unique
  samStatus        String    @default("UNKNOWN") // ACTIVE | INACTIVE | UNKNOWN
  samExpiryDate    DateTime?
  uei              String?
  cageCode         String?
  naicsCodes       String[]  @default([])
  setAsideCerts    String[]  @default([]) // SDVOSB | WOSB | HUBZONE | SBA_8A | ...
  reminderLeadDays Int       @default(60)
  ownerUserId      String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  consultingFirm ConsultingFirm @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)

  @@map("registration_profiles")
}

model Certification {
  id               String    @id @default(uuid())
  consultingFirmId String
  name             String
  category         String    @default("SET_ASIDE") // SET_ASIDE | QUALITY | SECURITY | REGISTRATION | OTHER
  issuingBody      String?
  certNumber       String?
  issueDate        DateTime?
  expiryDate       DateTime?
  reminderLeadDays Int       @default(60)
  ownerUserId      String?
  documentKey      String?
  notes            String?
  isArchived       Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  consultingFirm ConsultingFirm @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)

  @@index([consultingFirmId])
  @@index([consultingFirmId, expiryDate])
  @@map("certifications")
}

model InsurancePolicy {
  id               String    @id @default(uuid())
  consultingFirmId String
  policyType       String // GENERAL_LIABILITY | PROFESSIONAL | WORKERS_COMP | CYBER | BID_BOND | PERFORMANCE_BOND | PAYMENT_BOND | OTHER
  carrier          String?
  policyNumber     String?
  coverageAmount   Decimal?  @db.Decimal(14, 2)
  effectiveDate    DateTime?
  expiryDate       DateTime?
  reminderLeadDays Int       @default(60)
  ownerUserId      String?
  documentKey      String?
  notes            String?
  isArchived       Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  consultingFirm ConsultingFirm @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)

  @@index([consultingFirmId])
  @@index([consultingFirmId, expiryDate])
  @@map("insurance_policies")
}

//////////////////////////////////////////////////////////////
// MODULE 8 — POST-AWARD ADMINISTRATION (Section 5)
// Contract + Option Periods + CLINs + Modifications + Deliverables Log.
// All children denormalize consultingFirmId for robust tenant scoping.
// Financial values use Decimal(14,2). Deliverable OVERDUE is DERIVED, not
// stored. Designed so Module 9 (funding/invoicing/timekeeping) can reference
// Contract/Clin later without schema duplication.
//////////////////////////////////////////////////////////////

model Contract {
  id                   String    @id @default(uuid())
  consultingFirmId     String
  opportunityId        String?   @unique
  clientCompanyId      String?
  contractNumber       String
  title                String
  agency               String?
  contractingOffice    String?
  contractType         String? // FFP | T_AND_M | IDIQ | COST_REIMB | LABOR_HOUR | BPA | OTHER
  awardValue           Decimal?  @db.Decimal(14, 2)
  fundedValue          Decimal?  @db.Decimal(14, 2)
  ceilingValue         Decimal?  @db.Decimal(14, 2)
  startDate            DateTime?
  endDate              DateTime?
  status               String    @default("DRAFT") // DRAFT | ACTIVE | ON_HOLD | COMPLETED | TERMINATED | CANCELLED | ARCHIVED
  ownerUserId          String?
  customerContactName  String?
  customerContactEmail String?
  customerContactPhone String?
  description          String?
  notes                String?
  isArchived           Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  consultingFirm      ConsultingFirm         @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  opportunity         Opportunity?           @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  clientCompany       ClientCompany?         @relation(fields: [clientCompanyId], references: [id], onDelete: SetNull)
  clins               Clin[]
  modifications       ContractModification[]
  optionPeriods       ContractOptionPeriod[]
  deliverables        ContractDeliverable[]
  fundingTransactions FundingTransaction[]
  contractCosts       ContractCost[]
  laborRates          ContractLaborRate[]
  timeEntries         TimeEntry[]
  invoices            ContractInvoice[]

  // §8.2 ERP
  budgets             ContractBudget[]
  resourceAllocations ResourceAllocation[]
  purchaseOrders      PurchaseOrder[]

  @@unique([consultingFirmId, opportunityId])
  @@index([consultingFirmId])
  @@index([consultingFirmId, status])
  @@index([consultingFirmId, endDate])
  @@index([clientCompanyId])
  @@map("contracts")
}

model ContractOptionPeriod {
  id               String    @id @default(uuid())
  consultingFirmId String
  contractId       String
  label            String
  description      String?
  startDate        DateTime?
  endDate          DateTime?
  optionValue      Decimal?  @db.Decimal(14, 2)
  exerciseStatus   String    @default("PLANNED") // PLANNED | PENDING_DECISION | EXERCISED | NOT_EXERCISED | EXPIRED
  decisionDate     DateTime?
  exerciseDeadline DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([consultingFirmId])
  @@index([contractId])
  @@index([consultingFirmId, exerciseDeadline])
  @@map("contract_option_periods")
}

model Clin {
  id               String    @id @default(uuid())
  consultingFirmId String
  contractId       String
  clinNumber       String
  title            String?
  clinType         String? // FFP | T_AND_M | COST_REIMBURSEMENT | LABOR_HOUR | IDIQ | OTHER
  parentClinId     String?
  /// §8.2 — task-order tier without a new model. Defaults to CLIN so every
  /// existing row and query keeps its current meaning.
  clinLevel        ClinLevel @default(CLIN)
  quantity         Decimal?  @db.Decimal(14, 2)
  unit             String?
  unitPrice        Decimal?  @db.Decimal(14, 2)
  fundedAmount     Decimal?  @db.Decimal(14, 2)
  ceilingAmount    Decimal?  @db.Decimal(14, 2)
  startDate        DateTime?
  endDate          DateTime?
  status           String    @default("ACTIVE") // ACTIVE | COMPLETED | CANCELLED
  notes            String?
  isArchived       Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  contract                Contract                 @relation(fields: [contractId], references: [id], onDelete: Cascade)
  parentClin              Clin?                    @relation("ClinParent", fields: [parentClinId], references: [id], onDelete: SetNull)
  childClins              Clin[]                   @relation("ClinParent")
  deliverables            ContractDeliverable[]
  fundingTransactions     FundingTransaction[]
  contractCosts           ContractCost[]
  laborRates              ContractLaborRate[]
  timeEntries             TimeEntry[]
  budgetLines             ContractBudgetLine[]
  resourceAllocations     ResourceAllocation[]
  purchaseOrders          PurchaseOrder[]
  purchaseOrderLines      PurchaseOrderLine[]
  subcontractInvoiceLines SubcontractInvoiceLine[]
  invoiceLineItems        ContractInvoiceLineItem[]

  @@unique([contractId, clinNumber])
  @@index([consultingFirmId])
  @@index([contractId])
  @@map("clins")
}

model ContractModification {
  id               String    @id @default(uuid())
  consultingFirmId String
  contractId       String
  modNumber        String
  modType          String?
  effectiveDate    DateTime?
  signedDate       DateTime?
  description      String?
  fundingChange    Decimal?  @db.Decimal(14, 2)
  ceilingChange    Decimal?  @db.Decimal(14, 2)
  startDateChange  DateTime?
  endDateChange    DateTime?
  status           String    @default("DRAFT") // DRAFT | RECORDED | APPLIED | VOIDED
  appliedAt        DateTime? // set once when APPLIED — guards against double-apply
  attachmentKey    String?
  createdByUserId  String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, modNumber])
  @@index([consultingFirmId])
  @@index([contractId])
  @@map("contract_modifications")
}

model ContractDeliverable {
  id                String    @id @default(uuid())
  consultingFirmId  String
  contractId        String
  clinId            String?
  name              String
  cdrlNumber        String?
  description       String?
  deliverableType   String?
  frequency         String? // ONE_TIME | WEEKLY | MONTHLY | QUARTERLY | ANNUAL | AS_REQUIRED
  dueDate           DateTime?
  ownerUserId       String?
  reviewerUserId    String?
  status            String    @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | READY_FOR_REVIEW | SUBMITTED | ACCEPTED | REJECTED | WAIVED | CANCELLED (OVERDUE derived)
  submissionDate    DateTime?
  submittedByUserId String?
  acceptanceStatus  String? // PENDING | ACCEPTED | REJECTED
  acceptanceDate    DateTime?
  rejectionReason   String?
  attachmentKey     String?
  notes             String?
  lastReminderAt    DateTime?
  lastEscalationAt  DateTime?
  isArchived        Boolean   @default(false)
  // §7.5 — the ONLY explicit deliverable→partner attribution. Set by a human.
  // Partner performance is computed exclusively from attributed rows, so a
  // prime's own deliverable is never credited to (or held against) a partner.
  partnerId         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  contract           Contract                       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  clin               Clin?                          @relation(fields: [clinId], references: [id], onDelete: SetNull)
  partner            Partner?                       @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  partnerSubmissions PartnerDeliverableSubmission[]

  @@index([consultingFirmId])
  @@index([contractId])
  @@index([consultingFirmId, dueDate])
  @@index([consultingFirmId, status])
  @@index([partnerId])
  @@map("contract_deliverables")
}

//////////////////////////////////////////////////////////////
// MODULE 9 — CONTRACT FINANCE & TIMEKEEPING (Section 5)
// Funding ledger (source of truth) + costs + labor rates + time entries +
// invoices + payments. All money Decimal(14,2); rates Decimal(14,4). Backend
// is authoritative for every calculation. Contract.fundedValue is a cache
// maintained transactionally from the funding ledger (reconcilable).
//////////////////////////////////////////////////////////////

model FundingTransaction {
  id               String    @id @default(uuid())
  consultingFirmId String
  contractId       String
  clinId           String?
  type             String // INITIAL_OBLIGATION | INCREMENTAL_FUNDING | FUNDING_REDUCTION | DEOBLIGATION | ADJUSTMENT | REVERSAL
  amount           Decimal   @db.Decimal(14, 2) // signed delta: reductions/deobligations are negative
  effectiveDate    DateTime?
  referenceNumber  String?
  modificationId   String?   @unique // prevents a modification's funding change being applied twice
  description      String?
  notes            String?
  createdByUserId  String?
  isVoided         Boolean   @default(false)
  reversalReason   String?
  createdAt        DateTime  @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  clin     Clin?    @relation(fields: [clinId], references: [id], onDelete: SetNull)

  @@index([consultingFirmId])
  @@index([contractId])
  @@index([clinId])
  @@map("funding_transactions")
}

model ContractCost {
  id                String         @id @default(uuid())
  consultingFirmId  String
  contractId        String
  clinId            String?
  category          String // OTHER_DIRECT_COST | TRAVEL | MATERIAL | SUBCONTRACTOR | EQUIPMENT | ADJUSTMENT | OTHER
  description       String?
  amount            Decimal        @db.Decimal(14, 2)
  incurredDate      DateTime?
  status            String         @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | REJECTED | VOIDED
  attachmentKey     String?
  notes             String?
  createdByUserId   String?
  approvedByUserId  String?
  approvedAt        DateTime?
  rejectionReason   String?
  invoicedInvoiceId String? // set once a cost is placed on an invoice — prevents double-invoicing
  /// §8.2 — provenance. MANUAL for every historical row; SUBCONTRACT_INVOICE
  /// when posted from an approved vendor invoice, which makes that posting
  /// idempotent and auditable.
  sourceType        CostSourceType @default(MANUAL)
  sourceId          String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  clin     Clin?    @relation(fields: [clinId], references: [id], onDelete: SetNull)

  @@index([consultingFirmId])
  @@index([contractId])
  @@index([consultingFirmId, status])
  @@index([consultingFirmId, sourceType, sourceId])
  @@map("contract_costs")
}

model ContractLaborRate {
  id               String    @id @default(uuid())
  consultingFirmId String
  contractId       String
  clinId           String?
  categoryName     String
  categoryCode     String?
  employeeRef      String?
  billingRate      Decimal?  @db.Decimal(14, 4)
  costRate         Decimal?  @db.Decimal(14, 4) // sensitive — hidden from unauthorized roles
  rateType         String    @default("BILLING") // BILLING | COST | CEILING | BLENDED | OTHER
  effectiveStart   DateTime?
  effectiveEnd     DateTime?
  isActive         Boolean   @default(true)
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  clin     Clin?    @relation(fields: [clinId], references: [id], onDelete: SetNull)

  @@index([consultingFirmId])
  @@index([contractId])
  @@index([contractId, categoryName])
  @@map("contract_labor_rates")
}

model TimeEntry {
  id                 String    @id @default(uuid())
  consultingFirmId   String
  contractId         String
  clinId             String?
  userId             String
  laborCategory      String
  workDate           DateTime
  hours              Decimal   @db.Decimal(6, 2)
  description        String?
  status             String    @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | REJECTED | VOIDED
  submittedAt        DateTime?
  approverUserId     String?
  decidedAt          DateTime?
  rejectionReason    String?
  appliedBillingRate Decimal?  @db.Decimal(14, 4)
  appliedCostRate    Decimal?  @db.Decimal(14, 4)
  billingAmount      Decimal?  @db.Decimal(14, 2)
  costAmount         Decimal?  @db.Decimal(14, 2)
  invoicedInvoiceId  String? // set once invoiced — prevents double-invoicing
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  clin     Clin?    @relation(fields: [clinId], references: [id], onDelete: SetNull)

  @@index([consultingFirmId])
  @@index([contractId])
  @@index([consultingFirmId, workDate])
  @@index([userId])
  @@index([consultingFirmId, status])
  @@map("time_entries")
}

model ContractInvoice {
  id               String    @id @default(uuid())
  consultingFirmId String
  contractId       String
  invoiceNumber    String
  periodStart      DateTime?
  periodEnd        DateTime?
  invoiceDate      DateTime?
  dueDate          DateTime?
  status           String    @default("DRAFT") // DRAFT | READY_FOR_REVIEW | APPROVED | SUBMITTED | PARTIALLY_PAID | PAID | OVERDUE | VOIDED
  customerName     String?
  subtotal         Decimal   @default(0) @db.Decimal(14, 2)
  adjustments      Decimal   @default(0) @db.Decimal(14, 2)
  taxAmount        Decimal   @default(0) @db.Decimal(14, 2)
  total            Decimal   @default(0) @db.Decimal(14, 2)
  amountPaid       Decimal   @default(0) @db.Decimal(14, 2)
  submittedAt      DateTime?
  paidAt           DateTime?
  paymentReference String?
  notes            String?
  attachmentKey    String?
  createdByUserId  String?
  approvedByUserId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  contract  Contract                  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  lineItems ContractInvoiceLineItem[]
  payments  InvoicePayment[]
  followUps InvoiceFollowUp[]

  @@unique([consultingFirmId, invoiceNumber])
  @@index([consultingFirmId])
  @@index([contractId])
  @@index([consultingFirmId, status])
  @@index([consultingFirmId, dueDate])
  @@map("contract_invoices")
}

/// A recorded attempt to chase an unpaid invoice.
///
/// Ageing already says WHICH invoice is late. This is the separate record of
/// what was actually done about it, and by whom — the part an ageing report
/// cannot tell you and the part a customer will ask about.
model InvoiceFollowUp {
  id               String    @id @default(uuid())
  consultingFirmId String
  invoiceId        String
  contactedAt      DateTime
  /// EMAIL | PHONE | PORTAL | LETTER | OTHER
  method           String
  contactName      String?
  note             String
  /// When the next chase is due. Null means none was planned.
  nextActionAt     DateTime?
  /// Set when this thread of chasing ended, whatever the outcome. Payment is
  /// recorded on the invoice itself, never inferred from a closed follow-up.
  resolvedAt       DateTime?
  recordedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice ContractInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([consultingFirmId, invoiceId])
  @@index([consultingFirmId, nextActionAt])
  @@map("invoice_follow_ups")
}

model ContractInvoiceLineItem {
  id                String   @id @default(uuid())
  consultingFirmId  String
  invoiceId         String
  kind              String // LABOR | ODC | SUBCONTRACTOR | FEE | ADJUSTMENT
  description       String
  quantity          Decimal? @db.Decimal(14, 2)
  rate              Decimal? @db.Decimal(14, 4)
  amount            Decimal  @db.Decimal(14, 2) // snapshot — never recalculated from current rates
  /// The CLIN this line bills against. Carried down from the time entry or
  /// cost the line was assembled from, never chosen separately — a government
  /// invoice must agree with the records behind it, and re-picking the CLIN at
  /// billing time is exactly how the two drift apart.
  clinId            String?
  sourceTimeEntryId String?
  sourceCostId      String?
  createdAt         DateTime @default(now())

  invoice ContractInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  clin    Clin?           @relation(fields: [clinId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([consultingFirmId])
  @@index([clinId])
  @@map("contract_invoice_line_items")
}

model InvoicePayment {
  id               String    @id @default(uuid())
  consultingFirmId String
  invoiceId        String
  amount           Decimal   @db.Decimal(14, 2)
  paymentDate      DateTime?
  referenceNumber  String?
  method           String?
  notes            String?
  recordedByUserId String?
  isVoided         Boolean   @default(false)
  voidReason       String?
  createdAt        DateTime  @default(now())

  invoice ContractInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([consultingFirmId])
  @@index([invoiceId])
  @@map("invoice_payments")
}

//////////////////////////////////////////////////////////////
// §5.1 Stage 6 / §5.2 — PRICING & RATE BUILD-UP
// Relational, versioned, role-protected pricing. Supersedes the legacy
// (unwired) CostVolume JSON blob. Money math is Prisma.Decimal (decimal.js),
// backend-authoritative; stored line/scenario totals are snapshots.
// consultingFirmId is a bare tenant scalar (same convention as ContractLaborRate/
// Clin); cross-model refs (opportunityId/proposalId/partnerId) are loose scalars.
//////////////////////////////////////////////////////////////

model PricingWorkspace {
  id                    String    @id @default(cuid())
  consultingFirmId      String
  opportunityId         String
  proposalId            String?
  clientCompanyId       String?
  title                 String
  ownerUserId           String?
  status                String    @default("DRAFT") // DRAFT | IN_REVIEW | APPROVED | REJECTED | SUPERSEDED | ARCHIVED
  version               Int       @default(1)
  contractType          String? // FFP | T_AND_M | IDIQ | COST_REIMB | LABOR_HOUR | OTHER
  notes                 String?
  preferredScenarioId   String?
  supersedesWorkspaceId String? // prior version this one replaced
  approvedAt            DateTime?
  approvedByUserId      String?
  isArchived            Boolean   @default(false)
  createdByUserId       String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  scenarios PricingScenario[]
  reviews   PricingReview[]

  @@index([consultingFirmId, opportunityId])
  @@index([consultingFirmId, status])
  @@index([opportunityId, version])
  @@map("pricing_workspaces")
}

model PricingScenario {
  id                 String    @id @default(cuid())
  consultingFirmId   String
  workspaceId        String
  name               String
  description        String?
  isPreferred        Boolean   @default(false)
  isArchived         Boolean   @default(false)
  sortOrder          Int       @default(0)
  // Cached decimal snapshots (recomputed by the backend on every mutation).
  totalDirectLabor   Decimal   @default(0) @db.Decimal(16, 2)
  totalFringe        Decimal   @default(0) @db.Decimal(16, 2)
  totalOverhead      Decimal   @default(0) @db.Decimal(16, 2)
  totalOdc           Decimal   @default(0) @db.Decimal(16, 2)
  totalSubcontractor Decimal   @default(0) @db.Decimal(16, 2)
  totalGA            Decimal   @default(0) @db.Decimal(16, 2)
  subtotalBeforeFee  Decimal   @default(0) @db.Decimal(16, 2)
  totalFee           Decimal   @default(0) @db.Decimal(16, 2)
  totalPrice         Decimal   @default(0) @db.Decimal(16, 2)
  calculatedAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workspace     PricingWorkspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  laborLines    PricingLaborLine[]
  indirectRates PricingIndirectRate[]
  otherCosts    PricingOtherCost[]

  @@index([consultingFirmId])
  @@index([workspaceId])
  @@map("pricing_scenarios")
}

model PricingLaborLine {
  id                String   @id @default(cuid())
  consultingFirmId  String
  scenarioId        String
  categoryName      String
  categoryCode      String?
  description       String?
  personnelCount    Int?
  hours             Decimal  @default(0) @db.Decimal(12, 2)
  baseRate          Decimal  @default(0) @db.Decimal(14, 4) // sensitive — redacted from non-authorized roles
  periodLabel       String? // e.g. "Base Year", "Option 1"
  escalationPct     Decimal  @default(0) @db.Decimal(7, 4)
  directLaborAmount Decimal  @default(0) @db.Decimal(16, 2) // snapshot = hours × baseRate
  notes             String?
  sortOrder         Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  scenario PricingScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@index([consultingFirmId])
  @@index([scenarioId])
  @@map("pricing_labor_lines")
}

model PricingIndirectRate {
  id               String    @id @default(cuid())
  consultingFirmId String
  scenarioId       String
  name             String
  rateType         String // FRINGE | OVERHEAD | GA | MATERIAL_HANDLING | SUBCONTRACT_HANDLING | FEE | OTHER
  percent          Decimal   @default(0) @db.Decimal(7, 4) // sensitive
  costBase         String // DIRECT_LABOUR | LABOUR_PLUS_FRINGE | TOTAL_DIRECT_COST | SUBCONTRACTOR_COST | MATERIAL_COST | CUSTOM_SUPPORTED_BASE
  description      String?
  effectiveDate    DateTime?
  endDate          DateTime?
  source           String? // template name/id if applied from a template
  isActive         Boolean   @default(true)
  sortOrder        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  scenario PricingScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@index([consultingFirmId])
  @@index([scenarioId])
  @@map("pricing_indirect_rates")
}

model PricingOtherCost {
  id                   String   @id @default(cuid())
  consultingFirmId     String
  scenarioId           String
  costCategory         String // TRAVEL | MATERIALS | EQUIPMENT | SUPPLIES | ODC | SUBCONTRACTOR | CONSULTANT | OTHER
  description          String
  quantity             Decimal  @default(1) @db.Decimal(14, 2)
  unit                 String?
  unitCost             Decimal  @default(0) @db.Decimal(14, 4)
  totalAmount          Decimal  @default(0) @db.Decimal(16, 2) // snapshot = quantity × unitCost
  vendorName           String?
  partnerId            String? // loose FK to Partner (teaming) — do not duplicate partner companies
  teamingArrangementId String?
  notes                String?
  attachmentKey        String?
  attachmentName       String?
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  scenario PricingScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@index([consultingFirmId])
  @@index([scenarioId])
  @@map("pricing_other_costs")
}

model PricingTemplate {
  id                   String    @id @default(cuid())
  consultingFirmId     String
  name                 String
  description          String?
  // Snapshotted template content (applied by copying values into scenario lines).
  laborLinesJson       Json? // [{categoryName, categoryCode, baseRate, escalationPct, ...}]
  indirectRatesJson    Json? // [{name, rateType, percent, costBase, ...}]
  feeDefaultPct        Decimal?  @db.Decimal(7, 4)
  escalationDefaultPct Decimal?  @db.Decimal(7, 4)
  effectiveDate        DateTime?
  version              Int       @default(1)
  isActive             Boolean   @default(true)
  isArchived           Boolean   @default(false)
  createdByUserId      String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([consultingFirmId])
  @@index([consultingFirmId, isArchived])
  @@map("pricing_templates")
}

model PricingReview {
  id               String   @id @default(cuid())
  consultingFirmId String
  workspaceId      String
  action           String // SUBMITTED | APPROVED | REJECTED | CHANGES_REQUESTED | VERSIONED | SCENARIO_SELECTED
  fromStatus       String?
  toStatus         String?
  scenarioId       String?
  actorUserId      String?
  comment          String?
  createdAt        DateTime @default(now())

  workspace PricingWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([consultingFirmId])
  @@index([workspaceId])
  @@map("pricing_reviews")
}

//////////////////////////////////////////////////////////////
// §5.1 Stage 7 — SUBMISSION MANAGEMENT
// Pre-submission readiness/packaging workspace tied to a Proposal. Distinct from
// the post-submission compliance/penalty ledger `SubmissionRecord` (which tracks
// on-time/outcome/penalty). Checklist items SOURCE FROM verified MatrixRequirements,
// ProposalSections, and DocumentRequirements (loose scalar refs — not duplicated).
// Backend is authoritative for readiness. No automatic government submission.
//////////////////////////////////////////////////////////////

model ProposalSubmission {
  id                         String    @id @default(cuid())
  consultingFirmId           String
  opportunityId              String
  proposalId                 String?
  title                      String
  finalDeadline              DateTime?
  internalDeadline           DateTime?
  submissionMethod           String? // EMAIL | PORTAL | PHYSICAL | SAM | OTHER (user-recorded only)
  destinationDescription     String?
  status                     String    @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | READY_FOR_REVIEW | READY_TO_SUBMIT | SUBMITTED | CONFIRMED | REJECTED | WITHDRAWN | MISSED | ARCHIVED
  readinessPercent           Int       @default(0) // backend-computed snapshot
  ownerUserId                String?
  submittedAt                DateTime?
  submittedByUserId          String?
  confirmationReference      String?
  confirmationAttachmentKey  String?
  confirmationAttachmentName String?
  confirmationReceivedAt     DateTime?
  overrideReason             String? // required when marked ready/submitted despite blockers
  overriddenByUserId         String?
  notes                      String?
  isArchived                 Boolean   @default(false)
  createdByUserId            String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  items            SubmissionChecklistItem[]
  statusHistory    SubmissionStatusHistory[]
  validationChecks SubmissionValidationCheck[]

  @@index([consultingFirmId, opportunityId])
  @@index([consultingFirmId, status])
  @@index([finalDeadline])
  @@map("proposal_submissions")
}

model SubmissionChecklistItem {
  id                          String    @id @default(cuid())
  consultingFirmId            String
  submissionId                String
  title                       String
  description                 String?
  itemType                    String    @default("OTHER") // PROPOSAL_SECTION | DOCUMENT | FORM | CERTIFICATION | SIGNATURE | ATTACHMENT | FILE_VALIDATION | SUBMISSION_CONFIRMATION | OTHER
  isMandatory                 Boolean   @default(true)
  ownerUserId                 String?
  dueDate                     DateTime?
  status                      String    @default("PENDING") // PENDING | IN_PROGRESS | COMPLETE | VALIDATED | BLOCKED | NA
  isBlocker                   Boolean   @default(false)
  blockerReason               String?
  isArchived                  Boolean   @default(false)
  // Loose source refs (dedupe keys during regeneration)
  sourceMatrixRequirementId   String?
  sourceProposalSectionId     String?
  sourceDocumentRequirementId String?
  sourceSection               String?
  sourcePage                  Int?
  attachmentKey               String?
  attachmentName              String?
  validationState             String    @default("UNVALIDATED") // UNVALIDATED | MANUAL_REQUIRED | PASSED | FAILED
  validationEvidence          String?
  validatedByUserId           String?
  validatedAt                 DateTime?
  isManuallyVerified          Boolean   @default(false)
  notes                       String?
  sortOrder                   Int       @default(0)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  submission ProposalSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([consultingFirmId])
  @@index([submissionId])
  @@index([submissionId, status])
  @@map("submission_checklist_items")
}

model SubmissionStatusHistory {
  id               String   @id @default(cuid())
  consultingFirmId String
  submissionId     String
  action           String
  fromStatus       String?
  toStatus         String?
  actorUserId      String?
  comment          String?
  createdAt        DateTime @default(now())

  submission ProposalSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([consultingFirmId])
  @@index([submissionId])
  @@map("submission_status_history")
}

//////////////////////////////////////////////////////////////
// §5.1 Stage 10 / §5.2 — PAST PERFORMANCE ATTACHMENTS + MATRIX
// PastPerformanceRecord (existing) is extended above. Attachments + per-opportunity
// relevance/selection (the matrix) are new. Automated relevance score is stored
// separately from human selection.
//////////////////////////////////////////////////////////////

model PastPerformanceAttachment {
  id                      String   @id @default(cuid())
  consultingFirmId        String
  pastPerformanceRecordId String
  key                     String
  name                    String
  uploadedByUserId        String?
  createdAt               DateTime @default(now())

  record PastPerformanceRecord @relation(fields: [pastPerformanceRecordId], references: [id], onDelete: Cascade)

  @@index([consultingFirmId])
  @@index([pastPerformanceRecordId])
  @@map("past_performance_attachments")
}

model PastPerformanceSelection {
  id                      String    @id @default(cuid())
  consultingFirmId        String
  pastPerformanceRecordId String
  opportunityId           String
  proposalId              String?
  // Automated (deterministic or AI) relevance — kept separate from human choice.
  relevanceScore          Int? // 0..100
  confidence              String? // HIGH | MEDIUM | LOW | INSUFFICIENT_DATA
  matchingFactors         String[]  @default([])
  missingFactors          String[]  @default([])
  relevanceExplanation    String?
  scoredAt                DateTime?
  scoreMethod             String? // DETERMINISTIC | AI
  // Human selection
  isSelected              Boolean   @default(false)
  selectedByUserId        String?
  selectedAt              DateTime?
  displayOrder            Int       @default(0)
  notes                   String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  record PastPerformanceRecord @relation(fields: [pastPerformanceRecordId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, pastPerformanceRecordId])
  @@index([consultingFirmId])
  @@index([opportunityId])
  @@index([pastPerformanceRecordId])
  @@map("past_performance_selections")
}

//////////////////////////////////////////////////////////////
// SECTION 6 — ENHANCEMENTS TO THE FOUR EXISTING PILLARS
//
// 6.1 Opportunity Discovery · 6.2 Win-Probability Scoring
// 6.3 Document & Requirement Tracking · 6.4 Deadline & Milestone Management
//
// Design rules honoured here:
//  - Section 5 records/workflows are extended, never duplicated. Opportunity,
//    SavedMonitoringProfile, Competitor, ComplianceMatrix/MatrixRequirement,
//    ProposalSubmission, Certification, Contract, Partner and Amendment remain
//    the single business records for their domain.
//  - Every external-source record retains source, external id, source URL,
//    first-seen, last-seen, source-last-updated, last successful sync and a
//    data-quality state.
//  - Every background job record carries idempotency key, attempt count,
//    timeout, failure state, last-run and next-run.
//////////////////////////////////////////////////////////////

// Category of an ingestion source adapter. Mirrors (and is broader than) the
// OpportunitySource provenance enum: a category describes the KIND of feed,
// OpportunitySource records which feed a given Opportunity row came from.
enum SourceCategory {
  SAM_GOV
  CONTRACT_AWARDS
  AGENCY_FORECAST
  GRANTS_GOV
  STATE_LOCAL
  SUBCONTRACTING_BOARD
  MANUAL
  DEMO
  OTHER
}

// Honest freshness/completeness state for any externally sourced record.
// STALE = last successful sync older than the adapter's staleness window.
// PARTIAL = record ingested but required normalization fields were absent.
enum SourceDataQuality {
  OK
  PARTIAL
  STALE
  ERROR
  UNVERIFIED
}

enum SyncRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  TIMED_OUT
  SKIPPED
}

enum SyncMode {
  FULL
  INCREMENTAL
}

// Whether an adapter has actually been exercised against the live provider.
// CONTRACT_ONLY = production-ready adapter + fixtures + tests, but no live
// provider run has occurred (no credentials / no public endpoint configured).
// It is never rendered as a live connection.
enum AdapterVerification {
  LIVE_VERIFIED
  CONTRACT_ONLY
  NOT_CONFIGURED
}

// Per-firm configuration of one ingestion source adapter. `authEnvKey` names an
// OPTIONAL environment variable — the platform runs honestly without it and the
// adapter simply reports NOT_CONFIGURED.
model OpportunitySourceConfig {
  id               String         @id @default(uuid())
  consultingFirmId String
  adapterKey       String // stable adapter identifier, e.g. "sam_gov", "grants_gov"
  displayName      String
  category         SourceCategory
  isEnabled        Boolean        @default(false)

  // Optional provider configuration. Never a hard requirement.
  baseUrl    String?
  authEnvKey String? // name of the env var holding the key — never the key itself
  configJson Json    @default("{}")

  // Cursor / watermark for incremental sync.
  cursorValue     String?
  cursorUpdatedAt DateTime?

  // Operational state.
  lastRunAt           DateTime?
  lastSuccessfulSync  DateTime?
  lastFailureAt       DateTime?
  lastFailureMessage  String?
  nextRunAt           DateTime?
  consecutiveFailures Int                 @default(0)
  dataQuality         SourceDataQuality   @default(UNVERIFIED)
  verification        AdapterVerification @default(NOT_CONFIGURED)

  // Guardrails.
  rateLimitPerMinute Int @default(60)
  timeoutMs          Int @default(30000)
  maxAttempts        Int @default(3)
  stalenessHours     Int @default(48)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consultingFirm ConsultingFirm   @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  syncRuns       SourceSyncRun[]
  opportunities  Opportunity[]
  forecasts      AgencyForecast[]

  @@unique([consultingFirmId, adapterKey])
  @@index([consultingFirmId, isEnabled])
  @@index([nextRunAt])
  @@map("opportunity_source_configs")
}

// One execution of one adapter. `idempotencyKey` makes a re-queued job a no-op
// instead of a duplicate ingest.
model SourceSyncRun {
  id               String        @id @default(uuid())
  consultingFirmId String
  sourceConfigId   String
  idempotencyKey   String        @unique
  mode             SyncMode      @default(INCREMENTAL)
  status           SyncRunStatus @default(PENDING)

  attempt     Int @default(1)
  maxAttempts Int @default(3)
  timeoutMs   Int @default(30000)

  pagesFetched   Int @default(0)
  recordsFetched Int @default(0)
  recordsCreated Int @default(0)
  recordsUpdated Int @default(0)
  recordsSkipped Int @default(0)
  errorCount     Int @default(0)

  cursorBefore String?
  cursorAfter  String?
  errorMessage String?
  rateLimited  Boolean @default(false)

  startedAt  DateTime?
  finishedAt DateTime?
  durationMs Int?
  createdAt  DateTime  @default(now())

  sourceConfig OpportunitySourceConfig @relation(fields: [sourceConfigId], references: [id], onDelete: Cascade)

  @@index([consultingFirmId, status])
  @@index([sourceConfigId, createdAt])
  @@map("source_sync_runs")
}

// -----------------------------------------------------------------
// 6.1B — AGENCY PROCUREMENT FORECASTS
// A forecast is NOT a released solicitation. It lives in its own record so it
// can never be rendered as one, and links to an Opportunity only when a
// deterministic identifier match (or a human) establishes the link.
// -----------------------------------------------------------------

enum ForecastLinkState {
  UNLINKED
  AUTO_LINKED
  REVIEW_REQUIRED
  HUMAN_CONFIRMED
  HUMAN_REJECTED
}

model AgencyForecast {
  id               String  @id @default(uuid())
  consultingFirmId String
  sourceConfigId   String?

  // External provenance (required for every external-source record).
  source          SourceCategory    @default(AGENCY_FORECAST)
  externalId      String
  sourceUrl       String?
  sourceReference String? // published document / spreadsheet reference
  firstSeenAt     DateTime          @default(now())
  lastSeenAt      DateTime          @default(now())
  sourceUpdatedAt DateTime?
  lastSyncedAt    DateTime?
  dataQuality     SourceDataQuality @default(UNVERIFIED)
  sourceMetadata  Json?

  agency                      String
  subAgency                   String?
  contractingOffice           String?
  title                       String
  description                 String?
  anticipatedSolicitationDate DateTime?
  anticipatedAwardDate        DateTime?
  fiscalYear                  Int?
  naicsCode                   String?
  psc                         String?
  setAsideExpectation         String?
  contractVehicle             String?
  estimatedValue              Decimal?  @db.Decimal(14, 2)
  estimatedValueMin           Decimal?  @db.Decimal(14, 2)
  estimatedValueMax           Decimal?  @db.Decimal(14, 2)
  incumbentName               String? // only when the source explicitly supplies one
  placeOfPerformance          String?
  contactName                 String?
  contactEmail                String?
  contactPhone                String?

  // Completeness of the supplied record (0-1), derived from which fields the
  // source actually populated. Never a prediction of accuracy.
  completeness Float @default(0)

  // Link to the solicitation that later appears.
  linkedOpportunityId String?
  linkState           ForecastLinkState @default(UNLINKED)
  linkEvidence        String?
  linkConfidence      Float?
  linkedAt            DateTime?
  linkedByUserId      String?

  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  consultingFirm    ConsultingFirm           @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  sourceConfig      OpportunitySourceConfig? @relation(fields: [sourceConfigId], references: [id], onDelete: SetNull)
  linkedOpportunity Opportunity?             @relation("ForecastSolicitation", fields: [linkedOpportunityId], references: [id], onDelete: SetNull)
  versions          AgencyForecastVersion[]

  @@unique([consultingFirmId, externalId])
  @@index([consultingFirmId, agency])
  @@index([consultingFirmId, fiscalYear])
  @@index([consultingFirmId, anticipatedSolicitationDate])
  @@index([consultingFirmId, naicsCode])
  @@index([linkedOpportunityId])
  @@map("agency_forecasts")
}

// Immutable history — a forecast whose fields change keeps its prior state.
model AgencyForecastVersion {
  id          String   @id @default(uuid())
  forecastId  String
  versionNo   Int
  changedKeys String[] @default([])
  snapshot    Json
  observedAt  DateTime @default(now())

  forecast AgencyForecast @relation(fields: [forecastId], references: [id], onDelete: Cascade)

  @@unique([forecastId, versionNo])
  @@index([forecastId])
  @@map("agency_forecast_versions")
}

// -----------------------------------------------------------------
// 6.1C — RE-COMPETE DETECTION
// A signal, never a certainty. The machine result is preserved verbatim after
// human correction (originalWindowStart/End + originalConfidence).
// -----------------------------------------------------------------

enum RecompeteVerification {
  UNVERIFIED
  VERIFIED
  CORRECTED
  DISMISSED
}

model RecompeteSignal {
  id               String @id @default(uuid())
  consultingFirmId String

  // Exactly one of these identifies the source record the signal came from.
  sourceContractId    String?
  sourceOpportunityId String?
  sourceAwardRef      String? // external award/contract identifier when neither model holds it

  incumbentName          String?
  incumbentUei           String?
  agency                 String?
  contractNumber         String?
  naicsCode              String?
  psc                    String?
  popStartDate           DateTime?
  popEndDate             DateTime? // base-period end
  finalPossibleEndDate   DateTime? // end including all un-exercised options
  optionPeriodCount      Int       @default(0)
  optionPeriodsRemaining Int       @default(0)

  // Estimated re-compete window (never presented as an announced date).
  windowStart DateTime?
  windowEnd   DateTime?
  leadDays    Int       @default(365)

  evidence         Json // structured list of the records/fields used
  confidence       EvidenceConfidence @default(AMBIGUOUS)
  confidenceReason String?
  detectionMethod  String             @default("deterministic-pop-v1")
  methodVersion    String             @default("v1")
  lastCalculatedAt DateTime           @default(now())

  relatedForecastId    String?
  relatedOpportunityId String?

  verification        RecompeteVerification @default(UNVERIFIED)
  verifiedByUserId    String?
  verifiedAt          DateTime?
  correctionReason    String?
  dismissedReason     String?
  // Machine result preserved across human correction.
  originalWindowStart DateTime?
  originalWindowEnd   DateTime?
  originalConfidence  EvidenceConfidence?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consultingFirm ConsultingFirm @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)

  @@unique([consultingFirmId, detectionMethod, sourceContractId, sourceOpportunityId, sourceAwardRef])
  @@index([consultingFirmId, windowStart])
  @@index([consultingFirmId, verification])
  @@map("recompete_signals")
}

// -----------------------------------------------------------------
// 6.1E / 6.2F — FIRM CAPABILITY LIBRARY
// The evidence base for capability matching and gap analysis. A capability is
// only "verified" when a human says so; AI never flips that bit.
// -----------------------------------------------------------------

enum CapabilityVerification {
  UNVERIFIED
  VERIFIED
  REJECTED
}

model FirmCapability {
  id               String @id @default(uuid())
  consultingFirmId String

  name               String
  category           String   @default("TECHNICAL") // TECHNICAL | DOMAIN | CERTIFICATION | PERSONNEL | GEOGRAPHIC | VEHICLE | OTHER
  description        String?
  keywords           String[] @default([])
  naicsCodes         String[] @default([])
  pscCodes           String[] @default([])
  // Free-text capacity note plus an optional numeric concurrent-pursuit cap.
  capacityNote       String?
  concurrentCapacity Int?
  geographies        String[] @default([])
  contractVehicles   String[] @default([])

  verification              CapabilityVerification @default(UNVERIFIED)
  verifiedByUserId          String?
  verifiedAt                DateTime?
  evidenceNote              String?
  // Optional links to the records that substantiate the capability.
  relatedPastPerformanceIds String[]               @default([])
  relatedCertificationIds   String[]               @default([])

  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  consultingFirm ConsultingFirm @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)

  @@index([consultingFirmId, isArchived])
  @@index([consultingFirmId, category])
  @@map("firm_capabilities")
}

// -----------------------------------------------------------------
// 6.1E/6.1F — CAPABILITY MATCH + SET-ASIDE ELIGIBILITY SNAPSHOT
// One row per (firm, opportunity). Deterministic and explainable; recomputed,
// never hand-edited.
// -----------------------------------------------------------------

enum EligibilityState {
  ELIGIBLE
  POSSIBLY_ELIGIBLE
  NOT_ELIGIBLE
  EXPIRING_BEFORE_DEADLINE
  INSUFFICIENT_DATA
}

model OpportunityMatch {
  id               String @id @default(uuid())
  consultingFirmId String
  opportunityId    String @unique

  overallScore         Int // 0..100
  // Per-dimension sub-scores. Null = dimension not assessable (absent data),
  // which is explicitly NOT the same as a zero score.
  capabilityScore      Int?
  naicsScore           Int?
  pscScore             Int?
  certificationScore   Int?
  pastPerformanceScore Int?
  geographyScore       Int?
  vehicleScore         Int?
  keywordScore         Int?

  matchedCapabilityIds String[] @default([])
  missingCapabilities  String[] @default([])
  capacityWarning      String?
  evidence             Json // per-dimension evidence + source record ids
  dataLimitations      String[] @default([])
  hasSufficientData    Boolean  @default(true)

  eligibility              EligibilityState @default(INSUFFICIENT_DATA)
  eligibilityReason        String?
  eligibilityEvidence      Json?
  // Certifications that expire between now and the response deadline.
  expiringCertificationIds String[]         @default([])

  matchMethod   String   @default("capability-match-v1")
  methodVersion String   @default("v1")
  calculatedAt  DateTime @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([consultingFirmId, opportunityId])
  @@index([consultingFirmId, overallScore])
  @@index([consultingFirmId, eligibility])
  @@map("opportunity_matches")
}

// -----------------------------------------------------------------
// 6.1G — SAVED PROFILE ALERT LEDGER
// Deduplication + "alert again only after a meaningful change". The
// contentFingerprint captures the fields whose change justifies re-alerting.
// -----------------------------------------------------------------

model MonitoringProfileAlert {
  id               String  @id @default(uuid())
  consultingFirmId String
  profileId        String
  userId           String
  opportunityId    String?
  forecastId       String?

  // Stable dedupe key: profile + record. One row per pair, ever.
  dedupeKey          String  @unique
  contentFingerprint String
  priority           String  @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  channel            String  @default("IN_APP") // IN_APP | EMAIL | DIGEST
  reason             String?

  alertCount  Int      @default(1)
  firstSentAt DateTime @default(now())
  lastSentAt  DateTime @default(now())

  profile SavedMonitoringProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([consultingFirmId, profileId])
  @@index([profileId, lastSentAt])
  @@map("monitoring_profile_alerts")
}

// -----------------------------------------------------------------
// 6.2B — TENANT-SPECIFIC CALIBRATION
// A calibration is only ACTIVE when it beat the baseline on held-out data.
// Fitting a curve is not sufficient grounds for activation.
// -----------------------------------------------------------------

enum CalibrationState {
  DRAFT
  EVALUATED
  ACTIVE
  REJECTED
  ROLLED_BACK
  STALE
}

enum OutcomeVerification {
  UNVERIFIED
  HUMAN_CONFIRMED
  SYSTEM_DERIVED
}

model TenantCalibration {
  id               String @id @default(uuid())
  consultingFirmId String

  version       Int
  method        String @default("platt") // platt | isotonic
  methodVersion String @default("v1")
  params        Json // {a,b} for Platt, or the isotonic step function

  // Dataset provenance.
  sampleSize    Int
  minSampleSize Int      @default(30)
  trainingStart DateTime
  trainingEnd   DateTime
  holdoutSize   Int      @default(0)

  // Metrics — model vs. the uncalibrated baseline on the SAME holdout.
  brierScore         Float?
  baselineBrierScore Float?
  logLoss            Float?
  baselineLogLoss    Float?
  reliabilityBins    Json?
  improvement        Float? // baselineBrier - brier; must be > 0 to activate

  state             CalibrationState @default(DRAFT)
  activationReason  String?
  rejectionReason   String?
  activatedAt       DateTime?
  activatedByUserId String?
  deactivatedAt     DateTime?
  rolledBackFromId  String?
  stalenessDays     Int              @default(180)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consultingFirm ConsultingFirm      @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  samples        CalibrationSample[]

  @@unique([consultingFirmId, version])
  @@index([consultingFirmId, state])
  @@map("tenant_calibrations")
}

// A single verified (predicted, observed) pair used to fit/evaluate a
// tenant calibration. Sourced from real pursuits — never synthesised.
model CalibrationSample {
  id               String  @id @default(uuid())
  consultingFirmId String
  calibrationId    String?

  opportunityId        String?
  bidPursuitId         String?
  submissionRecordId   String?
  predictedProbability Float
  observedOutcome      Int // 1 = won, 0 = lost
  outcomeSource        String // SUBMISSION_OUTCOME | CONTRACT_AWARD | PURSUIT_STATUS | MANUAL
  verification         OutcomeVerification @default(SYSTEM_DERIVED)
  isHoldout            Boolean             @default(false)
  observedAt           DateTime
  createdAt            DateTime            @default(now())

  calibration TenantCalibration? @relation(fields: [calibrationId], references: [id], onDelete: SetNull)

  @@unique([consultingFirmId, opportunityId, outcomeSource])
  @@index([consultingFirmId, observedAt])
  @@index([calibrationId])
  @@map("calibration_samples")
}

// -----------------------------------------------------------------
// 6.2C / 6.2D — INCUMBENT RETENTION + COMPETITOR AWARD STATS
// Every rate carries its denominator. Award share is never labelled a bid
// win rate when bid-participation data is unavailable.
// -----------------------------------------------------------------

enum RateBasis {
  CONFIRMED_WIN_RATE // real bid-participation data available
  OBSERVED_AWARD_SHARE // share of observed awards in the comparable set
  HISTORICAL_AWARD_FREQUENCY // counts only; no meaningful denominator
  INSUFFICIENT_DATA
}

model IncumbentRetentionStat {
  id               String @id @default(uuid())
  consultingFirmId String

  incumbentName  String
  normalizedName String
  incumbentUei   String?
  agency         String?
  naicsCode      String?
  psc            String?
  contractType   String?

  similarAwardCount   Int       @default(0)
  retainedCount       Int       @default(0)
  lostRecompeteCount  Int       @default(0)
  // Null when the denominator is too small to state a rate.
  retentionRate       Float?
  agencyRetentionRate Float?
  basis               RateBasis @default(INSUFFICIENT_DATA)

  sampleSize     Int                @default(0)
  windowStart    DateTime?
  windowEnd      DateTime?
  evidence       Json
  evidenceSource String?
  confidence     EvidenceConfidence @default(NOT_AVAILABLE)
  explanation    String?

  methodVersion   String   @default("v1")
  lastRefreshedAt DateTime @default(now())
  createdAt       DateTime @default(now())

  consultingFirm ConsultingFirm @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)

  @@unique([consultingFirmId, normalizedName, agency, naicsCode])
  @@index([consultingFirmId, normalizedName])
  @@map("incumbent_retention_stats")
}

model CompetitorAwardStat {
  id               String @id @default(uuid())
  consultingFirmId String

  competitorName String
  normalizedName String
  uei            String?
  agency         String?
  naicsCode      String?
  psc            String?
  contractType   String?
  valueBandLow   Decimal? @db.Decimal(14, 2)
  valueBandHigh  Decimal? @db.Decimal(14, 2)

  observedAwards      Int @default(0)
  comparableAwardPool Int @default(0)
  confirmedWins       Int @default(0)
  confirmedLosses     Int @default(0)
  confirmedBids       Int @default(0)

  // Exactly one of these is populated, matching `basis`.
  confirmedWinRate   Float?
  observedAwardShare Float?
  basis              RateBasis @default(INSUFFICIENT_DATA)
  basisLabel         String // the exact wording shown to users

  isIncumbent    Boolean            @default(false)
  sampleSize     Int                @default(0)
  windowStart    DateTime?
  windowEnd      DateTime?
  evidence       Json
  evidenceSource String?
  confidence     EvidenceConfidence @default(NOT_AVAILABLE)
  explanation    String?

  methodVersion   String   @default("v1")
  lastRefreshedAt DateTime @default(now())
  createdAt       DateTime @default(now())

  consultingFirm ConsultingFirm @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)

  @@unique([consultingFirmId, normalizedName, agency, naicsCode])
  @@index([consultingFirmId, normalizedName])
  @@map("competitor_award_stats")
}

// -----------------------------------------------------------------
// 6.2E — PRICING SENSITIVITY
// Reads Pricing Workspace scenarios; NEVER writes back to approved pricing.
// -----------------------------------------------------------------

enum SensitivityValidity {
  CALIBRATED
  UNVALIDATED_SCENARIO_ANALYSIS
  INSUFFICIENT_DATA
}

model PricingSensitivityAnalysis {
  id                 String  @id @default(uuid())
  consultingFirmId   String
  opportunityId      String
  pricingWorkspaceId String?

  // Benchmark the price points are positioned against, and where it came from.
  benchmarkValue  Decimal? @db.Decimal(14, 2)
  benchmarkSource String? // OPPORTUNITY_ESTIMATE | AWARD_HISTORY_MEDIAN | FORECAST_ESTIMATE | USER_SUPPLIED
  basePrice       Decimal? @db.Decimal(14, 2)
  baseProbability Float?

  // Ordered price points with probability + interval. Read-only analysis output.
  points      Json
  assumptions String[]            @default([])
  validity    SensitivityValidity @default(INSUFFICIENT_DATA)
  isMonotonic Boolean             @default(true)
  sampleSize  Int                 @default(0)

  method        String   @default("price-position-logit-v1")
  methodVersion String   @default("v1")
  calculatedAt  DateTime @default(now())
  createdAt     DateTime @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([consultingFirmId, opportunityId])
  @@map("pricing_sensitivity_analyses")
}

// -----------------------------------------------------------------
// 6.2F — CAPABILITY GAP + PARTNER-CLOSE RECOMMENDATIONS
// Recommendations only. Never creates a TeamingArrangement.
