// Atomic claim ledger for Stripe webhook deliveries. A row is created (unique
// on eventId) BEFORE any handler runs, so concurrent retries of the same event
// can never double-apply a side effect (e.g. a token-pack credit). Lifecycle:
// PROCESSING -> COMPLETED | FAILED; FAILED and stale PROCESSING claims may be
// reclaimed by a later Stripe retry.
model StripeWebhookEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique
  eventType String
  status    String   @default("PROCESSING")
  error     String?
  createdAt DateTime @default(now())
