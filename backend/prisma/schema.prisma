generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////////////

enum OpportunityStatus {
  ACTIVE
  ARCHIVED
  EXPIRED
  AWARDED
  CANCELLED
}

// Provenance of an opportunity record. Drives source classification/badges and
// protects MANUAL records from being overwritten by ingestion.
enum OpportunitySource {
  SAM_GOV
  USA_SPENDING
  MANUAL
  DEMO
  OTHER
  // §6.1A — additional ingestion sources. A record's source is the feed it was
  // normalized from; AGENCY_FORECAST is only ever set on an Opportunity that a
  // human promoted from a forecast, never by forecast ingestion itself.
  GRANTS_GOV
  STATE_LOCAL
  SUBCONTRACTING_BOARD
  AGENCY_FORECAST
  CONTRACT_AWARDS
}

// Whether a Competitor row is the identified incumbent or a historical
// competitor (§5.1 Stage 3 evidence layer).
enum EvidenceKind {
  INCUMBENT
  COMPETITOR
}

// Strength of the evidence. CONFIRMED is only used for a reliable single
// incumbent match backed by an award record — an inferred name is never
// CONFIRMED. Competitors are PROBABLE (strong historical presence) or AMBIGUOUS
// (limited/comparable evidence).
enum EvidenceConfidence {
  CONFIRMED
  PROBABLE
  AMBIGUOUS
  NOT_AVAILABLE
}

// Manual verification state of an identified incumbent.
enum IncumbentVerification {
  UNVERIFIED
  VERIFIED
  CORRECTED
}

enum BidDecisionStatus {
  PENDING
  GO
  NO_GO
}

enum ComplianceStatus {
  PENDING
  APPROVED
  BLOCKED
  REJECTED
}

enum PenaltyType {
  LATE_SUBMISSION
  DOCUMENT_ERROR
  NON_COMPLIANT_BID
  WITHDRAWAL
  OTHER
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  PAUSED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum IngestionJobType {
  INGEST
  ENRICH
  ANALYZE_DOCUMENT
}

enum IngestionJobStatus {
  PENDING
  RUNNING
  COMPLETE
  FAILED
  PARTIAL
}

enum DocumentAnalysisStatus {
  PENDING
  IN_PROGRESS
  COMPLETE
  FAILED
  SKIPPED
}

enum DocumentRequirementStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
}

enum MatrixRequirementStatus {
  NOT_STARTED
  IN_PROGRESS
  // Legacy values kept for existing production rows. The §6.3F state machine
  // treats COMPLETED as an alias of COMPLETE and PENDING_REVIEW as an alias of
  // READY_FOR_REVIEW; nothing writes the legacy values going forward.
  COMPLETED
  PENDING_REVIEW
  BLOCKED
  // §6.3F workflow
  READY_FOR_REVIEW
  CHANGES_REQUIRED
  COMPLETE
  VERIFIED
  NOT_APPLICABLE
}

enum ComplianceLogEntityType {
  SUBMISSION
  BID_DECISION
  OPPORTUNITY
  CLIENT_COMPANY
  DOCUMENT_REQUIREMENT
  WINNERS_INTEL_INJECTION
  WINNERS_INTEL_REFRESH
  TEAMING_RELATIONSHIP
  OTHER
}

enum TeamingRelationshipStatus {
  IDENTIFIED // Operator saved this prime for later
  CONTACTED // Outreach email sent (often via /agency draft-outreach)
  CONVERSATION // Prime replied; conversation underway
  MOU // MOU / teaming agreement in progress or signed
  TEAMED // Active teaming on a bid or contract
  DECLINED // Prime declined or operator deprioritized
}

//////////////////////////////////////////////////////////////
// TENANT LAYER
//////////////////////////////////////////////////////////////

model ConsultingFirm {
  id                     String    @id @default(uuid())
  name                   String
  contactEmail           String    @unique
  isActive               Boolean   @default(true)
  isTest                 Boolean   @default(false)
  lastIngestedAt         DateTime?
  // GB-103 high-water mark: last time the client-match notification diff job
  // ran for this firm. The job loads opportunities updated since this instant
  // rather than scanning the whole table.
  lastMatchNotifiedAt    DateTime?
  flatLateFee            Decimal?  @db.Decimal(14, 2)
  penaltyPercent         Decimal?  @db.Decimal(5, 2)
  samApiKey              String?
  anthropicApiKey        String?
  llmProvider            String    @default("claude")
  openaiApiKey           String?
  insightEngineApiKey    String?
  localaiBaseUrl         String?
  localaiModel           String?
  deepseekApiKey         String?
  purchasedAddons        String[]  @default([])
  isVeteranOwned         Boolean   @default(false)
  proposalTokens         Int       @default(0)
  lastTokenRefreshAt     DateTime?
  brandingLogoUrl        String?
  brandingPrimaryColor   String?   @default("#fbbf24")
  brandingSecondaryColor String?   @default("#f59e0b")
  brandingDisplayName    String?
  brandingTagline        String?
  brandingFaviconUrl     String?

  // Per-firm opt-in for the Winners Intel knowledge base (.ai/WINNERS_INTEL_SPEC.md).
  // When true AND env ENABLE_WINNERS_INTEL=true, the proposal-generation pathway
  // injects department + NAICS slice MDs into the LLM prompt for this firm's drafts.
  // Default false so the feature ships dormant; explicit ADMIN action enables it.
  winnersIntelOptIn Boolean @default(false)

  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  lifetimeAccessAt       DateTime?
  // Owner/demo comp account: entitlementService short-circuits to full
  // all-access and the single-plan migration must never touch this firm.
  isOwnerComp            Boolean   @default(false)
  subdomain              String?   @unique
  customDomain           String?   @unique
  customDomainVerifiedAt DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  users                     User[]
  clientCompanies           ClientCompany[]
  opportunities             Opportunity[]
  financialPenalties        FinancialPenalty[]
  ingestionJobs             IngestionJob[]
  submissionRecords         SubmissionRecord[]
  bidDecisions              BidDecision[]
  documentRequirements      DocumentRequirement[]
  documentTemplates         DocumentTemplate[]
  complianceLogs            ComplianceLog[]
  clientDocuments           ClientDocument[]
  submittedTemplates        SharedTemplate[]
  complianceMatrices        ComplianceMatrix[]
  portalUploads             ClientPortalUpload[]
  apiUsageLogs              ApiUsageLog[]
  integrationConnections    IntegrationConnection[]
  signatureRequests         SignatureRequest[]
  ssoConfig                 FirmSsoConfig?
  subscription              Subscription?
  invoices                  Invoice[]
  stateMunicipalOpps        StateMunicipalOpportunity[]
  subcontractOpportunities  SubcontractOpportunity[]
  subcontractContacts       SubcontractContact[]
  betaFeedback              BetaFeedback[]
  teamingRelationships      TeamingRelationship[]
  scwOutreachDrafts         ScwOutreachDraft[]
  notificationPreferences   NotificationPreference[]
  sentNotifications         SentNotification[]
  partners                  Partner[]
  teamingArrangements       TeamingArrangement[]
  proposalAttestations      ProposalAttestation[]
  addonSubscriptions        AddonSubscription[]
  bidPursuits               BidPursuit[]
  registrationProfile       RegistrationProfile?
  certifications            Certification[]
  insurancePolicies         InsurancePolicy[]
  contracts                 Contract[]
  scorecardCriterionConfigs ScorecardCriterionConfig[]
  scorecards                Scorecard[]
  scorecardDecisions        ScorecardDecision[]
  gateReviews               GateReview[]
  userNotifications         UserNotification[]
  savedMonitoringProfiles   SavedMonitoringProfile[]
  teamingAgreementDrafts    TeamingAgreementDraft[]
  proposals                 Proposal[]
  proposalSectionVersions   ProposalSectionVersion[]
  proposalSectionReviews    ProposalSectionReview[]

  // §6 — discovery sources, capability library, calibration, evidence stats,
  // standing documents and schedule templates.
  opportunitySourceConfigs OpportunitySourceConfig[]
  agencyForecasts          AgencyForecast[]
  recompeteSignals         RecompeteSignal[]
  firmCapabilities         FirmCapability[]
  tenantCalibrations       TenantCalibration[]
  incumbentRetentionStats  IncumbentRetentionStat[]
  competitorAwardStats     CompetitorAwardStat[]
  standingDocuments        StandingDocument[]
  scheduleTemplates        ScheduleTemplate[]

  // §7.0 — shared agent runtime state (per-tenant only; handlers live in code).
  agentSchedules               AgentSchedule[]
  agentRuns                    AgentRun[]
  agentEscalations             AgentEscalation[]
  agentEvents                  AgentEvent[]
  agentNotificationPreferences AgentNotificationPreference[]

  // §7.2 — per-tenant pursuit-preference learning. Never shared across firms.
  pursuitFeedbackSignals PursuitFeedbackSignal[]

  // §7.3 — firm-level surety bonding capacity. Human-maintained.
  bondingCapacities BondingCapacity[]

  // §7.4 — agent bid/no-bid RECOMMENDATIONS. Never a human decision.
  qualificationRecommendations QualificationRecommendation[]
  partnerPerformanceRecords    PartnerPerformanceRecord[]
  awardBenchmarkCohorts        AwardBenchmarkCohort[]
  capabilityNarratives         CapabilityNarrative[]
  capabilityNarrativeVersions  CapabilityNarrativeVersion[]
  actualIndirectRates          ActualIndirectRate[]
  dcaaReadinessChecks          DcaaReadinessCheck[]
  cashFlowProjections          CashFlowProjection[]
  winLossSegments              WinLossSegment[]
  captureRecommendations       CaptureRecommendation[]
  subcontractingGoals          SubcontractingGoal[]
  subcontractingGoalProgress   SubcontractingGoalProgress[]

  // §8.1 CRM
  agencyOffices      AgencyOffice[]
  governmentContacts GovernmentContact[]
  partnerContacts    PartnerContact[]
  crmActivities      CrmActivity[]
  crmFollowUps       CrmFollowUp[]

  // §8.2 ERP
  contractBudgets      ContractBudget[]
  resourceAllocations  ResourceAllocation[]
  purchaseOrders       PurchaseOrder[]
  subcontractInvoices  SubcontractInvoice[]
  subcontractFlowDowns SubcontractFlowDown[]

  // §8.3
  personnel                   Personnel[]
  partnerPortalUsers          PartnerPortalUser[]
  partnerPortalUploads        PartnerPortalUpload[]
  partnerPersonnelSubmissions PartnerPersonnelSubmission[]

  @@map("consulting_firms")
}

model User {
  id               String    @id @default(uuid())
  consultingFirmId String
  email            String    @unique
  passwordHash     String
  firstName        String
  lastName         String
  /// ADMIN | CONSULTANT | BD_CAPTURE | PROPOSAL | CONTRACTS | FINANCE | VIEWER.
  /// ADMIN and CONSULTANT keep exactly the permission sets they always had;
  /// §8.5 added the rest. See services/rbac/permissions.ts.
  role             String
  /// Additive per-user grants on top of the role. Never subtractive, so a
  /// permission cannot be removed here and quietly break a role contract.
  extraPermissions String[]  @default([])
  isActive         Boolean   @default(true)
  isEmailVerified  Boolean   @default(false)
  emailVerifiedAt  DateTime?
  lastLoginAt      DateTime?
  // MFA (TOTP) — opt-in, default OFF so no existing user is locked out.
  // mfaSecret is encrypted at rest (fieldCrypto); recovery codes are bcrypt-hashed.
  mfaEnabled       Boolean   @default(false)
  mfaSecret        String?
  mfaRecoveryCodes String[]  @default([])
  mfaEnrolledAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  consultingFirm    ConsultingFirm     @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  submissionRecords SubmissionRecord[]
  createdTemplates  DocumentTemplate[] @relation("TemplateCreator")

  passwordResetTokens          PasswordResetToken[]
  emailVerificationTokens      EmailVerificationToken[]
  agreements                   UserAgreement[]
  scwOutreachApprovals         ScwOutreachDraft[]
  ownedPursuits                BidPursuit[]                  @relation("PursuitOwner")
  notifications                UserNotification[]
  agentNotificationPreferences AgentNotificationPreference[]

  appliedPursuitFeedback  PursuitFeedbackSignal[] @relation("PursuitFeedbackAppliedBy")
  revertedPursuitFeedback PursuitFeedbackSignal[] @relation("PursuitFeedbackRevertedBy")

  recordedBondingCapacities BondingCapacity[] @relation("BondingRecordedBy")
  verifiedBondingCapacities BondingCapacity[] @relation("BondingVerifiedBy")

  acceptedQualifications QualificationRecommendation[] @relation("QualificationAcceptedBy")
  rejectedQualifications QualificationRecommendation[] @relation("QualificationRejectedBy")

  // §8.1 CRM
  ownedGovContacts  GovernmentContact[] @relation("GovContactOwner")
  ownedCrmFollowUps CrmFollowUp[]       @relation("CrmFollowUpOwner")

  // §8.2 ERP
  resourceAllocations ResourceAllocation[] @relation("ResourceAllocationUser")

  // §8.3
  personnelRecords Personnel[] @relation("PersonnelAccount")

  // §8.5
  ssoIdentities SsoIdentity[]

  @@index([consultingFirmId])
  @@map("users")
}

//////////////////////////////////////////////////////////////
// PASSWORD RESET
//////////////////////////////////////////////////////////////

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}

//////////////////////////////////////////////////////////////
// BID DECISION AUDIT TRAIL
//////////////////////////////////////////////////////////////

model BidDecisionHistory {
  id               String   @id @default(uuid())
  consultingFirmId String
  opportunityId    String
  clientCompanyId  String
  recommendation   String
  winProbability   Float?
  fitScore         Float?
  marketScore      Float?
  expectedValue    Float?
  roiRatio         Float?
  changedBy        String?
  changeReason     String?
  snapshotJson     Json?
  createdAt        DateTime @default(now())

  @@index([consultingFirmId])
  @@index([opportunityId])
  @@index([clientCompanyId])
  @@map("bid_decision_history")
}

//////////////////////////////////////////////////////////////
// NAICS NORMALIZATION
// (Kept for future normalized lookups / enrichment queries)
//////////////////////////////////////////////////////////////

model NaicsCode {
  id          String  @id @default(uuid())
  code        String  @unique
  description String?
  sector      String?

  opportunities Opportunity[]
  clientLinks   ClientNaics[]

  @@map("naics_codes")
}

model ClientNaics {
  id              String @id @default(uuid())
  clientCompanyId String
  naicsCodeId     String

  clientCompany ClientCompany @relation(fields: [clientCompanyId], references: [id], onDelete: Cascade)
  naicsCode     NaicsCode     @relation(fields: [naicsCodeId], references: [id], onDelete: Cascade)

  @@unique([clientCompanyId, naicsCodeId])
  @@map("client_naics")
}

//////////////////////////////////////////////////////////////
// CLIENT LAYER
//////////////////////////////////////////////////////////////

model ClientCompany {
  id               String    @id @default(uuid())
  consultingFirmId String
  name             String
  cage             String?
  uei              String?
  naicsCodes       String[]  @default([])
  // Product/Service Codes the firm is qualified for. Parallel federal
  // classification axis to NAICS; consumed by the matching-v2 PSC dimension.
  pscCodes         String[]  @default([])
  sdvosb           Boolean   @default(false)
  wosb             Boolean   @default(false)
  hubzone          Boolean   @default(false)
  smallBusiness    Boolean   @default(true)
  isActive         Boolean   @default(true)
  // Soft-archive: when set, the client is hidden from default lists and its
  // opportunities/pipeline/contracts/past-performance are filtered out. Distinct
  // from isActive (portal/eligibility) so archiving is fully reversible.
  archivedAt       DateTime?

  // Primary point of contact + free-text notes (notes are CONSULTANT-editable).
  email               String?
  primaryContactName  String?
  primaryContactEmail String?
  notes               String?

  // Extended profile (auto-populated from SAM.gov Entity API)
  ein           String? // Employer Identification Number / Tax ID
  phone         String?
  website       String?
  streetAddress String?
  city          String?
  state         String?
  zipCode       String?
  samRegStatus  String? // "Active" | "Inactive"
  samRegExpiry  DateTime?

  // Contract vehicles this client holds (e.g. ["OASIS+", "SEWP V"])
  contractVehicles String[] @default([])

  // Qualifications & clearances — self-reported firm profile. Captured for
  // proposal readiness and BD targeting; not consumed by scoring yet.
  bondingCapacity    Decimal?  @db.Decimal(14, 2) // aggregate surety bonding capacity in dollars
  employeeCount      Int?
  hasFso             Boolean   @default(false) // Facility Security Officer on staff
  securityClearances String[]  @default([]) // e.g. ["Facility Clearance — Secret", "Staff TS/SCI"]
  isoCertifications  String[]  @default([]) // e.g. ["ISO 9001:2015", "ISO 27001"]
  agenciesOfInterest String[]  @default([]) // agencies the client wants to target
  capabilityKeywords String[]  @default([]) // capability tags beyond NAICS/PSC
  sdvosbCertExpiry   DateTime? // VetCert expiration
  wosbCertExpiry     DateTime?
  hubzoneCertExpiry  DateTime?

  // Per-client branding for proposal PDFs. When the consulting firm generates
  // a draft for this client, the PDF cover, divider, "PREPARED BY" line, and
  // footer reflect THIS client's identity (their UEI/CAGE/brand) rather than
  // the consulting firm's. All nullable — null = fall back to the firm's
  // brandingPrimaryColor / brandingSecondaryColor / displayName / etc.
  brandingLogoUrl        String?
  brandingPrimaryColor   String? // hex like #0A1F44; validated at write time
  brandingSecondaryColor String? // hex like #C9A227; validated at write time
  brandingDisplayName    String?
  brandingTagline        String?
  brandingFooterAddress  String? // single-line address rendered on every page footer
  brandingPreparedByLine String? // overrides the "PREPARED BY" cover-page line

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consultingFirm         ConsultingFirm             @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  performanceStats       PerformanceStats?
  submissionRecords      SubmissionRecord[]
  financialPenalties     FinancialPenalty[]
  bidDecisions           BidDecision[]
  naicsLinks             ClientNaics[]
  documentRequirements   DocumentRequirement[]
  clientPortalUsers      ClientPortalUser[]
  complianceRewards      ComplianceReward[]
  clientDocuments        ClientDocument[]
  opportunityDeclines    ClientOpportunityDecline[]
  portalUploads          ClientPortalUpload[]
  teamingRelationships   TeamingRelationship[]
  notificationPreference NotificationPreference?
  sentNotifications      SentNotification[]
  pastPerformanceRecords PastPerformanceRecord[]
  contracts              Contract[]

  @@index([consultingFirmId])
  @@map("client_companies")
}

//////////////////////////////////////////////////////////////
// OPPORTUNITY LAYER
//////////////////////////////////////////////////////////////

model Opportunity {
  id                 String  @id @default(uuid())
  consultingFirmId   String
  samNoticeId        String?
  // SAM solicitation number — shared between a solicitation and its later
  // Award Notice, so it is the join key that lets an incoming award be routed
  // only to firms with a SUBMITTED BidPursuit on the original solicitation.
  solicitationNumber String?
  title              String
  agency             String
  subagency          String?
  office             String?

  // Denormalized NAICS code for fast access (set by SAM ingestion)
  naicsCode    String     @default("")
  // Normalized relation (optional, for enrichment lookups)
  naicsCodeId  String?
  naicsCodeRef NaicsCode? @relation(fields: [naicsCodeId], references: [id])

  // Product/Service Code (SAM.gov `classificationCode`). Parallel federal
  // classification axis to NAICS — null when the source feed omits it, in
  // which case the matching-v2 PSC dimension is treated as absent (not zero).
  psc            String?
  pscDescription String?

  setAsideType   String @default("NONE")
  marketCategory String @default("SERVICES")

  estimatedValue    Decimal? @db.Decimal(14, 2)
  estimatedValueMin Decimal? @db.Decimal(14, 2)
  estimatedValueMax Decimal? @db.Decimal(14, 2)

  postedDate         DateTime?
  responseDeadline   DateTime
  archiveDate        DateTime?
  placeOfPerformance String?
  sourceUrl          String?
  description        String?
  scoreBreakdown     Json?

  probabilityScore Float             @default(0)
  expectedValue    Decimal?          @db.Decimal(14, 2)
  isScored         Boolean           @default(false)
  status           OpportunityStatus @default(ACTIVE)

  // Seeded/sample record, not a live SAM.gov (or other real-source) posting.
  // Demo rows are excluded from production-facing lists by default and never
  // render a government-source link (their notice ids resolve to a 404).
  isDemo Boolean @default(false)

  // Record provenance. SAM_GOV/USA_SPENDING = ingested government data; MANUAL =
  // hand-entered by the firm (protected from ingestion overwrite); DEMO = seed.
  source OpportunitySource @default(SAM_GOV)

  // USAspending enrichment
  isEnriched           Boolean  @default(false)
  historicalWinner     String?
  historicalAvgAward   Decimal? @db.Decimal(14, 2)
  historicalAwardCount Int?
  competitionCount     Int?
  incumbentProbability Float?
  agencySmallBizRate   Float?
  agencySdvosbRate     Float?
  recompeteFlag        Boolean  @default(false)

  // Notice type from SAM.gov (e.g. "Presolicitation", "Solicitation", "Sources Sought", "Sole Source")
  noticeType String?

  // GB-107 description enrichment (SAM.gov noticedesc fetch). Independent of
  // isEnriched above, which tracks USAspending award-history enrichment.
  // On COMPLETED, `description` is replaced with the real solicitation text
  // (it holds a noticedesc URL pointer at ingest) and the sanitized HTML is
  // kept here. Status: null = never attempted, then QUEUED | IN_PROGRESS |
  // COMPLETED | FAILED | NOT_FOUND | RATE_LIMITED.
  descriptionHtml                  String?
  descriptionEnrichmentStatus      String?
  descriptionEnrichmentAttemptedAt DateTime?
  descriptionEnrichedAt            DateTime?
  descriptionEnrichmentError       String?
  pointOfContact                   Json? // SAM v2 search pointOfContact array (populated when link fetch enabled)
  resourceLinks                    Json? // SAM v2 search resourceLinks array (attachment URLs; download is a follow-up)
  extractedClauses                 Json? // summary of GB-107 clause extraction { far: [], dfars: [], counts }

  // FPDS competition data (from USAspending offersReceived field)
  offersReceived Int?
  extentCompeted String?

  // Document intelligence
  documentIntelScore      Float?
  scopeAlignmentScore     Float?
  technicalComplexScore   Float?
  incumbentSignalDetected Boolean @default(false)

  // Contract vehicle tagging (detected from title/description during ingest)
  contractVehicle   String? // e.g. "OASIS+", "SEWP V", "GSA MAS"
  vehicleType       String? // "GWAC" | "IDIQ" | "BPA" | "MAS" | "BOA"
  vehicleConfidence Float? // 0-1 detection confidence

  // Advanced scoring signals (computed by scoring worker + nightly recalibration)
  deadlineUrgencyScore Float? // 0-1: quality of proposal prep window (sweet spot = 2-6 weeks)
  densityRatio         Float? // bidders vs NAICS norm (< 1.0 = below-average competition)
  agencyHistoryScore   Float? // 0-1: agency set-aside affinity for this client type

  // Proposal assistant — persisted so navigating away doesn't lose work
  savedProposalOutline  Json? // The AI-generated outline object
  savedProposalAnswers  Json? // User's Q&A answers { questionId → answer }
  savedProposalStep     String? // 'outlined' | 'answering' etc.
  savedProposalDraft    Json? // Generated draft sections (cached to avoid re-billing)
  savedProposalPdfKey   String? // Filename in /app/uploads for the cached PDF
  savedProposalDraftAt  DateTime? // When the cached draft was generated
  savedProposalBranding Json? // Branding used at draft time, so the human-reviewed final PDF re-renders identically

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // §6.1A — external-source provenance. Every externally sourced record keeps
  // its source, external identifier, source URL, first/last seen, source-side
  // last-updated, last successful sync and an honest data-quality state.
  sourceConfigId      String?
  externalId          String?
  sourceFirstSeenAt   DateTime?
  sourceLastSeenAt    DateTime?
  sourceUpdatedAt     DateTime?
  sourceLastSyncedAt  DateTime?
  dataQuality         SourceDataQuality @default(UNVERIFIED)
  sourceMetadata      Json?
  // Pre-solicitation classification (§6.1D). Derived from noticeType during
  // ingest; null when the feed gives no usable notice type.
  presolicitationKind String?

  consultingFirm       ConsultingFirm             @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  documents            OpportunityDocument[]
  amendments           Amendment[]
  awardHistory         AwardHistory[]
  submissionRecords    SubmissionRecord[]
  bidDecisions         BidDecision[]
  documentRequirements DocumentRequirement[]
  complianceMatrix     ComplianceMatrix?
  clientDeclines       ClientOpportunityDecline[]
  scwOutreachDrafts    ScwOutreachDraft[]
  sentNotifications    SentNotification[]
  teamingArrangements  TeamingArrangement[]
  proposalAttestation  ProposalAttestation?
  bidPursuits          BidPursuit[]
  contract             Contract?
  competitors          Competitor[]
  proposals            Proposal[]

  // §6 relations
  sourceConfig            OpportunitySourceConfig?     @relation(fields: [sourceConfigId], references: [id], onDelete: SetNull)
  originatingForecasts    AgencyForecast[]             @relation("ForecastSolicitation")
  match                   OpportunityMatch?
  pricingSensitivity      PricingSensitivityAnalysis[]
  capabilityGapAssessment CapabilityGapAssessment?
  extractionJobs          SolicitationExtractionJob[]
  lmMappings              SectionLmMapping[]
  clauseObligations       ClauseObligation[]
  milestones              OpportunityMilestone[]
  amendmentRevisions      AmendmentRevision[]
  scheduleRuns            ScheduleRun[]

  // §8.1 CRM
  crmActivities CrmActivity[]
  crmFollowUps  CrmFollowUp[]

  @@unique([consultingFirmId, samNoticeId])
  @@index([consultingFirmId, presolicitationKind])
  @@index([sourceConfigId])
  @@index([consultingFirmId])
  @@index([consultingFirmId, solicitationNumber])
  @@index([consultingFirmId, isDemo])
  @@index([consultingFirmId, source])
  @@index([consultingFirmId, status])
  @@index([naicsCodeId])
  @@index([agency])
  @@index([responseDeadline])
  @@index([probabilityScore])
  @@index([descriptionEnrichmentStatus])
  @@map("opportunities")
}

