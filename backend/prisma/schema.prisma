  //    worksharConsiderations, why, evidence }]
  partnerRecommendations Json     @default("[]")
  evidence               Json     @default("{}")
  limitations            String[] @default([])

  methodVersion String   @default("v1")
  calculatedAt  DateTime @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([consultingFirmId, opportunityId])
  @@index([consultingFirmId])
  @@map("capability_gap_assessments")
}

// -----------------------------------------------------------------
// 6.3A — SOLICITATION EXTRACTION JOBS
// -----------------------------------------------------------------

enum ExtractionJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  CANCELLED
  TIMED_OUT
}

model SolicitationExtractionJob {
  id                 String  @id @default(uuid())
  consultingFirmId   String
  opportunityId      String
  documentId         String?
  complianceMatrixId String?

  idempotencyKey  String              @unique
  status          ExtractionJobStatus @default(QUEUED)
  progressPercent Int                 @default(0)
  progressStage   String?

  // Deterministic parse first; AI only for classification/mapping.
  parseMethod          String  @default("DETERMINISTIC") // DETERMINISTIC | DETERMINISTIC_PLUS_AI
