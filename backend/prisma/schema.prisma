//////////////////////////////////////////////////////////////
// BID QUALIFICATION — configurable weighted scorecard (§5.2)
//
// Human-judgment qualification layer, distinct from the algorithmic
// BidDecision engine. One Scorecard per BidPursuit (the pipeline anchor).
// Weighted total + recommendation are computed on the BACKEND
// (services/scorecardScoring.ts) — the single source of truth.
//////////////////////////////////////////////////////////////

// Decision workflow state of a scorecard. NOT_REVIEWED → (IN_REVIEW) → a
// final human decision (BID/NO_BID/CONDITIONAL/DEFERRED).
enum QualificationStatus {
  NOT_REVIEWED
  IN_REVIEW
  BID
  NO_BID
  CONDITIONAL
  DEFERRED
}

// System recommendation derived deterministically from the weighted total.
enum ScorecardRecommendation {
  BID
  NO_BID
  CONDITIONAL
  REVIEW_REQUIRED
}

enum GateReviewStatus {
  NOT_STARTED
  IN_PROGRESS
  APPROVED
  REJECTED
  CHANGES_REQUIRED
  WAIVED
}

enum NotificationType {
  GATE_REVIEW_ASSIGNED
  GATE_REVIEW_SUBMITTED
  GATE_REVIEW_DECIDED
  QUALIFICATION_DECISION
  TEAMING_REMINDER
  PROPOSAL_ASSIGNMENT
  PROPOSAL_REVIEW
  PRICING_REVIEW
  SUBMISSION_REMINDER
  SUBMISSION_REVIEW
  // §6 additions
  OPPORTUNITY_ALERT
  RECOMPETE_ALERT
  AMENDMENT_ALERT
  MILESTONE_REMINDER
  MILESTONE_ESCALATION
  REQUIREMENT_ASSIGNMENT
  DOCUMENT_EXPIRY
  // §7.0 additions — shared agent runtime. Additive only; no existing value
  // changed, and none of these is used as a column default.
  AGENT_RUN_COMPLETED
  AGENT_RUN_FAILED
  AGENT_ESCALATION
  // §7.8 addition. Additive only; not used as a column default.
  FINANCE_ALERT

  // §8.1 addition. Additive only; not used as a column default.
  CRM_FOLLOW_UP
}

// Per-firm criterion template. Seeded with sensible defaults on first access.
// Active weights must sum to exactly 100 (validated on write).
model ScorecardCriterionConfig {
  id               String   @id @default(uuid())
  consultingFirmId String
  key              String
  name             String
  description      String?
  weight           Int      @default(0)
  required         Boolean  @default(true)
  displayOrder     Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  consultingFirm ConsultingFirm @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)

  @@unique([consultingFirmId, key])
  @@index([consultingFirmId, isActive])
  @@map("scorecard_criterion_configs")
}

// One scorecard per pursuit (the qualification instance).
model Scorecard {
  id               String              @id @default(uuid())
  consultingFirmId String
  bidPursuitId     String              @unique
  opportunityId    String
  status           QualificationStatus @default(NOT_REVIEWED)

  // Deterministic weighted total (0-100) computed by scorecardScoring.
  totalScore            Int                      @default(0)
  recommendation        ScorecardRecommendation?
  recommendationVersion String                   @default("scorecard-v1")

  // Final human decision (mirrors status once decided) + override capture.
  finalDecision      QualificationStatus?
  isOverride         Boolean              @default(false)
  overrideReason     String?
  overriddenByUserId String?
  decidedByUserId    String?
  decidedAt          DateTime?

  // Reviewer workflow.
  reviewerUserId       String?
  reviewerComments     String?
  submittedForReviewAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consultingFirm ConsultingFirm       @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  bidPursuit     BidPursuit           @relation(fields: [bidPursuitId], references: [id], onDelete: Cascade)
  criteria       ScorecardCriterion[]
  history        ScorecardDecision[]

  @@index([consultingFirmId, status])
  @@index([opportunityId])
  @@index([reviewerUserId])
  @@map("scorecards")
}

// Per-scorecard criterion snapshot — weight is copied at creation so historical
// scorecards stay correct even if the firm later reconfigures the template.
model ScorecardCriterion {
  id           String   @id @default(uuid())
  scorecardId  String
  key          String
  name         String
  description  String?
  weight       Int      @default(0)
  score        Int? // 0-100, null = not yet scored
  required     Boolean  @default(true)
  displayOrder Int      @default(0)
  evidence     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  scorecard Scorecard @relation(fields: [scorecardId], references: [id], onDelete: Cascade)

  @@unique([scorecardId, key])
  @@index([scorecardId])
  @@map("scorecard_criteria")
}

// Append-only decision history — a new row per submit/decision/override/reassess.
// Retained even when the scorecard is later reassessed (never erased).
model ScorecardDecision {
  id               String                   @id @default(uuid())
  consultingFirmId String
  scorecardId      String
  bidPursuitId     String
  opportunityId    String
  status           QualificationStatus
  recommendation   ScorecardRecommendation?
  totalScore       Int                      @default(0)
  isOverride       Boolean                  @default(false)
  overrideReason   String?
  reviewerComments String?
  changedByUserId  String?
  changeReason     String?
  snapshotJson     Json?
  createdAt        DateTime                 @default(now())

  scorecard      Scorecard      @relation(fields: [scorecardId], references: [id], onDelete: Cascade)
  ConsultingFirm ConsultingFirm @relation(fields: [consultingFirmId], references: [id])

  @@index([scorecardId])
  @@index([consultingFirmId])
  @@index([opportunityId])
  @@map("scorecard_decisions")
}

// Gate review linked to the same BidPursuit (and optionally its Scorecard).
model GateReview {
  id               String           @id @default(uuid())
  consultingFirmId String
  bidPursuitId     String
  scorecardId      String?
  opportunityId    String
  name             String
  stage            String           @default("GATE")
  reviewerUserId   String?
  dueDate          DateTime?
  status           GateReviewStatus @default(NOT_STARTED)
  outcome          String?
  comments         String?
  isArchived       Boolean          @default(false)
  submittedAt      DateTime?
  completedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  consultingFirm ConsultingFirm @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  bidPursuit     BidPursuit     @relation(fields: [bidPursuitId], references: [id], onDelete: Cascade)

  @@index([consultingFirmId, status])
  @@index([reviewerUserId])
  @@index([bidPursuitId])
  @@map("gate_reviews")
}

// Generic in-app notification feed for firm users (deduped by dedupeKey).
