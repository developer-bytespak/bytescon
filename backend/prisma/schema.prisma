}

// -----------------------------------------------------------------
// 6.3C — ACTIVE FAR/DFARS CLAUSE OBLIGATIONS
// Flow-down classification is a signal for legal review, never legal advice.
// -----------------------------------------------------------------

enum FlowDownStatus {
  EXPLICIT_FLOWDOWN
  CONDITIONAL_FLOWDOWN
  NO_EXPLICIT_FLOWDOWN_FOUND
  REVIEW_REQUIRED
}

enum ClauseApplicability {
  APPLICABLE
  NOT_APPLICABLE
  CONDITIONAL
  UNDETERMINED
}

model ClauseObligation {
  id               String @id @default(uuid())
  consultingFirmId String
  opportunityId    String

  clauseNumber String
  clauseTitle  String?
  clauseSet    String  @default("FAR") // FAR | DFARS | AGENCY | OTHER

  sourceDocumentId String?
  sourceSection    String?
  sourcePageNumber Int?
  evidenceText     String?

  applicability      ClauseApplicability @default(UNDETERMINED)
  flowDownStatus     FlowDownStatus      @default(REVIEW_REQUIRED)
  flowDownCondition  String?
  affectedPartnerIds String[]            @default([])

  ownerUserId           String?
  dueDate               DateTime?
  complianceStatus      String    @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | SATISFIED | NOT_APPLICABLE | BLOCKED
  legalReviewRequired   Boolean   @default(true)
  legalReviewedByUserId String?
  legalReviewedAt       DateTime?

  isManuallyVerified  Boolean   @default(false)
  verifiedByUserId    String?
  verifiedAt          DateTime?
  amendmentImpact     String? // ADDED | REMOVED | MODIFIED | UNCHANGED
  amendmentRevisionId String?

  extractionJobId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  opportunity Opportunity             @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  history     ClauseObligationEvent[]

  // §8.2
  subcontractFlowDowns SubcontractFlowDown[]

  @@unique([consultingFirmId, opportunityId, clauseNumber])
  @@index([consultingFirmId, opportunityId])
  @@index([opportunityId, flowDownStatus])
  @@map("clause_obligations")
}

model ClauseObligationEvent {
  id           String   @id @default(uuid())
  obligationId String
  action       String
  fromValue    String?
  toValue      String?
  actorUserId  String?
  note         String?
  createdAt    DateTime @default(now())

  obligation ClauseObligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)

  @@index([obligationId])
  @@map("clause_obligation_events")
}

// -----------------------------------------------------------------
// 6.3D — STANDING DOCUMENT LIBRARY
// References EXISTING secure file records where one already exists
// (registration/certification/insurance/past-performance/proposal/submission)
// instead of duplicating the stored file.
// -----------------------------------------------------------------

enum StandingDocumentCategory {
  CAPABILITY_STATEMENT
  CERTIFICATION
  REGISTRATION
  INSURANCE
  BOND
  FINANCIAL
  INDIRECT_RATE
  RESUME
  PAST_PERFORMANCE
  REPRESENTATION
  SIGNED_FORM
  PROPOSAL_TEMPLATE
  OTHER
}

enum DocumentVerificationState {
  UNVERIFIED
  VERIFIED
  REJECTED
  EXPIRED
}

model StandingDocument {
  id               String @id @default(uuid())
  consultingFirmId String

  category    StandingDocumentCategory
  name        String
  description String?
  tags        String[]                 @default([])
  sensitivity String                   @default("INTERNAL") // PUBLIC | INTERNAL | CONFIDENTIAL | RESTRICTED

  currentVersionNo Int                       @default(1)
  effectiveDate    DateTime?
  expiryDate       DateTime?
  verification     DocumentVerificationState @default(UNVERIFIED)
  verifiedByUserId String?
  verifiedAt       DateTime?
  approvedForReuse Boolean                   @default(false)
  approvedByUserId String?
  approvedAt       DateTime?

  ownerUserId              String?
  // Reference (never a copy) to the record that already stores this file.
  sourceSystem             String? // REGISTRATION | CERTIFICATION | INSURANCE | PAST_PERFORMANCE | PROPOSAL | SUBMISSION | LIBRARY
  sourceRecordId           String?
  relatedCertificationId   String?
  relatedInsurancePolicyId String?

  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  consultingFirm ConsultingFirm            @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  versions       StandingDocumentVersion[]
  links          StandingDocumentLink[]

  @@index([consultingFirmId, category])
  @@index([consultingFirmId, isArchived])
  @@index([consultingFirmId, expiryDate])
  @@map("standing_documents")
}

model StandingDocumentVersion {
  id         String @id @default(uuid())
  documentId String
  versionNo  Int

  fileKey    String?
  fileName   String?
  fileType   String?
  fileSize   Int?
  fileHash   String?
  pageCount  Int?
  changeNote String?

  uploadedByUserId String?
  isCurrent        Boolean  @default(true)
  createdAt        DateTime @default(now())

  document StandingDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNo])
  @@index([documentId])
  @@map("standing_document_versions")
}

// Where a standing document is being used.
model StandingDocumentLink {
  id               String @id @default(uuid())
  consultingFirmId String
  documentId       String

  targetType     String // MATRIX_REQUIREMENT | SUBMISSION_ITEM | PROPOSAL_SECTION | CLAUSE_OBLIGATION | OPPORTUNITY
  targetId       String
  opportunityId  String?
  note           String?
  linkedByUserId String?
  createdAt      DateTime @default(now())

  document StandingDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, targetType, targetId])
  @@index([consultingFirmId, targetType, targetId])
  @@index([opportunityId])
  @@map("standing_document_links")
}

// -----------------------------------------------------------------
// 6.3E — PRE-SUBMISSION VALIDATION EVIDENCE
// Append-only. Revalidation adds a row; it never erases prior evidence.
// -----------------------------------------------------------------

enum ValidationOutcome {
  PASSED
  FAILED
  NOT_APPLICABLE
  MANUAL_REQUIRED
  UNSUPPORTED
}

model SubmissionValidationCheck {
  id               String  @id @default(uuid())
  consultingFirmId String
  submissionId     String
  checklistItemId  String?

  checkKey    String // e.g. FILE_PRESENT, FILE_EXTENSION, PDF_PAGE_COUNT, FONT_FAMILY
  checkLabel  String
  outcome     ValidationOutcome
  // Honest statement of what was and was not actually inspected.
  method      String            @default("AUTOMATED") // AUTOMATED | MANUAL | UNSUPPORTED
  expected    String?
  actual      String?
  evidence    String?
  message     String?
  isMandatory Boolean           @default(true)
  isBlocking  Boolean           @default(false)

  validatorVersion  String   @default("v1")
  runId             String // groups all checks from one validation run
  performedByUserId String?
  performedAt       DateTime @default(now())

  submission ProposalSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([consultingFirmId, submissionId])
  @@index([submissionId, runId])
  @@map("submission_validation_checks")
}

// -----------------------------------------------------------------
// 6.3F — REQUIREMENT OWNERSHIP HISTORY
// -----------------------------------------------------------------

model MatrixRequirementEvent {
  id               String @id @default(uuid())
  consultingFirmId String
  requirementId    String

  action      String // STATUS_CHANGE | ASSIGN | REVIEW | BLOCK | UNBLOCK | LINK | AMENDMENT_IMPACT
  fromValue   String?
  toValue     String?
  actorUserId String?
  note        String?
  createdAt   DateTime @default(now())

  requirement MatrixRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@index([requirementId])
  @@index([consultingFirmId])
  @@map("matrix_requirement_events")
}

// -----------------------------------------------------------------
// 6.4A — OPPORTUNITY MILESTONE TIMELINE
// -----------------------------------------------------------------

enum MilestoneType {
  FORECAST_RELEASE
  SOURCES_SOUGHT_DEADLINE
  RFI_DEADLINE
  QUESTION_DEADLINE
  SITE_VISIT
  INDUSTRY_DAY
  PRE_PROPOSAL_CONFERENCE
  DRAFT_RFP
  AMENDMENT_RELEASE
  PROPOSAL_DEADLINE
  INTERNAL_KICKOFF
  BID_DECISION
  GATE_REVIEW
  OUTLINE_COMPLETE
  FIRST_DRAFT
  RED_TEAM
  GOLD_TEAM
  PRICING_FREEZE
  FINAL_QA
  READY_TO_SUBMIT
  SUBMISSION
  ORAL_PRESENTATION
  ANTICIPATED_AWARD
  CUSTOM
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  COMPLETE
  AT_RISK
  MISSED
  CANCELLED
  WAIVED
}

enum MilestoneOrigin {
  SOLICITATION
  AMENDMENT
  EXTRACTION
  SCHEDULE_GENERATOR
  MANUAL
  SYSTEM
}

model OpportunityMilestone {
  id               String  @id @default(uuid())
  consultingFirmId String
  opportunityId    String
  proposalId       String?
  submissionId     String?
  scheduleRunId    String?

  milestoneType MilestoneType
  title         String
  description   String?

  startAt  DateTime?
  endAt    DateTime?
  isAllDay Boolean   @default(false)
  timeZone String    @default("UTC")

  origin         MilestoneOrigin @default(MANUAL)
  sourceEvidence String?
  sourceSection  String?
  sourcePage     Int?

  isMandatory Boolean         @default(false)
  isInternal  Boolean         @default(true)
  status      MilestoneStatus @default(PLANNED)
  priority    String          @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL

  ownerUserId        String?
  backupOwnerUserId  String?
  participantUserIds String[] @default([])

  dependsOnMilestoneId String?
  // A locked milestone is never moved by schedule regeneration.
  isLocked             Boolean @default(false)
  lockReason           String?

  // Reminder policy (per-milestone override of the firm default).
  reminderLeadDays      Int[]   @default([14, 7, 3, 1])
  remindersEnabled      Boolean @default(true)
  escalateAfterDueHours Int     @default(24)

  calendarSyncState  String  @default("NOT_SYNCED") // NOT_SYNCED | EXPORTED | ERROR
  calendarExternalId String?

  amendmentImpact      String? // ADDED | MOVED | REMOVED | UNCHANGED
  amendmentRevisionId  String?
  acknowledgedByUserId String?
  acknowledgedAt       DateTime?

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  opportunity Opportunity            @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  events      MilestoneEvent[]
  reminders   MilestoneReminderLog[]

  @@index([consultingFirmId, opportunityId])
  @@index([consultingFirmId, status])
  @@index([consultingFirmId, endAt])
  @@index([opportunityId, milestoneType])
  @@map("opportunity_milestones")
}

model MilestoneEvent {
  id               String @id @default(uuid())
  consultingFirmId String
  milestoneId      String

  action      String
  fromValue   String?
  toValue     String?
  actorUserId String?
  note        String?
  createdAt   DateTime @default(now())

  milestone OpportunityMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([milestoneId])
  @@map("milestone_events")
}

// -----------------------------------------------------------------
// 6.4D — ESCALATING REMINDERS
// -----------------------------------------------------------------

enum ReminderLevel {
  INFORMATIONAL
  UPCOMING
  DUE_SOON
  URGENT
  OVERDUE
  ESCALATED
}

model MilestoneReminderLog {
  id               String @id @default(uuid())
  consultingFirmId String
  milestoneId      String
  userId           String

  level             ReminderLevel
  channel           String        @default("IN_APP") // IN_APP | EMAIL | CALENDAR
  // One row per (milestone, user, level, channel, occurrence day).
  dedupeKey         String        @unique
  isEscalation      Boolean       @default(false)
  escalatedToUserId String?

  acknowledgedAt       DateTime?
  acknowledgedByUserId String?
  snoozedUntil         DateTime?
  suppressedReason     String?

  sentAt    DateTime @default(now())
  createdAt DateTime @default(now())

  milestone OpportunityMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([consultingFirmId, milestoneId])
  @@index([userId, sentAt])
  @@map("milestone_reminder_logs")
}

// -----------------------------------------------------------------
// 6.4B — AMENDMENT REVISIONS + IMPACTS
// Extends the existing Amendment record with immutable versioned revisions,
// content hashes and a deterministic diff.
// -----------------------------------------------------------------

model AmendmentRevision {
  id               String  @id @default(uuid())
  consultingFirmId String
  opportunityId    String
  amendmentId      String?

  revisionNo      Int
  amendmentNumber String?
  sourceUrl       String?
  documentName    String?
  contentHash     String
  contentLength   Int     @default(0)

  // External provenance.
  externalId      String?
  firstSeenAt     DateTime          @default(now())
  lastSeenAt      DateTime          @default(now())
  sourceUpdatedAt DateTime?
  dataQuality     SourceDataQuality @default(UNVERIFIED)

  // Deterministic diff vs. the prior revision.
  diffSummary         Json?
  changedDeadlines    Json?
  changedRequirements Json?
  changedEvaluation   Json?
  changedClauses      Json?
  changedAttachments  Json?
  questionsAndAnswers Json?
  aiSummary           String?
  aiSummaryJson       Json?
  aiPromptVersion     String?
  humanReviewRequired Boolean @default(true)

  acknowledgedByUserId String?
  acknowledgedAt       DateTime?

  createdAt DateTime @default(now())

  opportunity Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  impacts     AmendmentImpact[]

  @@unique([opportunityId, revisionNo])
  @@unique([opportunityId, contentHash])
  @@index([consultingFirmId, opportunityId])
  @@map("amendment_revisions")
}

enum AmendmentImpactArea {
  COMPLIANCE_MATRIX
  PROPOSAL_SECTION
  PRICING
  SUBMISSION_CHECKLIST
  MILESTONE
  CLAUSE
  DOCUMENT
  OTHER
}

// A PROPOSED impact awaiting human confirmation. It never mutates the target.
model AmendmentImpact {
  id               String @id @default(uuid())
  consultingFirmId String
  revisionId       String
  opportunityId    String

  area              AmendmentImpactArea
  targetType        String?
  targetId          String?
  targetLabel       String?
  impact            String
  recommendedAction String?
  reviewRequired    Boolean             @default(true)
  reviewReason      String?

  acknowledgedByUserId String?
  acknowledgedAt       DateTime?
  dismissedReason      String?

  createdAt DateTime @default(now())

  revision AmendmentRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@index([consultingFirmId, opportunityId])
  @@index([revisionId])
  @@map("amendment_impacts")
}

// -----------------------------------------------------------------
// 6.4C — WORKING-BACKWARD SCHEDULES
// -----------------------------------------------------------------

model ScheduleTemplate {
  id               String  @id @default(uuid())
  consultingFirmId String
  name             String
  description      String?
  isDefault        Boolean @default(false)
  isArchived       Boolean @default(false)

  // Ordered phases: [{ key, milestoneType, label, offsetWorkingDays,
  //                    durationWorkingDays, dependsOn, minBufferDays, optional }]
  phases             Json
  minBufferDays      Int    @default(1)
  workingDays        Int[]  @default([1, 2, 3, 4, 5]) // ISO weekday numbers
  holidayCalendarKey String @default("US_FEDERAL")

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  consultingFirm ConsultingFirm @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  runs           ScheduleRun[]

  @@unique([consultingFirmId, name])
  @@index([consultingFirmId, isArchived])
  @@map("schedule_templates")
}

model ScheduleRun {
  id               String  @id @default(uuid())
  consultingFirmId String
  opportunityId    String
  templateId       String?

  versionNo      Int
  anchorDeadline DateTime
  timeZone       String   @default("UTC")
  isPreview      Boolean  @default(false)
  isApplied      Boolean  @default(false)

  // Complexity inputs actually used, so the result is reproducible.
  inputs                Json
  generated             Json // full computed phase list before write-back
  // Honest reporting when the working-day math cannot fit the phases.
  isFeasible            Boolean @default(true)
  infeasibilityReason   String?
  overdueMilestoneCount Int     @default(0)
  lockedPreserved       Int     @default(0)
  completedPreserved    Int     @default(0)

  overrideReason     String?
  overriddenByUserId String?
  generatedByUserId  String?
  methodVersion      String   @default("v1")
  createdAt          DateTime @default(now())

  template    ScheduleTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  opportunity Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, versionNo])
  @@index([consultingFirmId, opportunityId])
  @@map("schedule_runs")
}

// Working-day calendar. Seeded with US federal holidays; firms may add their
// own non-working days (calendarKey scopes them).
model HolidayCalendarEntry {
  id               String   @id @default(uuid())
  consultingFirmId String? // null = platform-wide (e.g. US_FEDERAL)
  calendarKey      String   @default("US_FEDERAL")
  date             DateTime @db.Date
  name             String
  createdAt        DateTime @default(now())

  @@unique([calendarKey, date, consultingFirmId])
  @@index([calendarKey, date])
  @@map("holiday_calendar_entries")
}

//////////////////////////////////////////////////////////////
// §7.0 — SHARED AGENT RUNTIME FOUNDATION
//
// One runtime for all nine agents. These six models generalise the durable-run
// patterns already proven by SolicitationExtractionJob (§6.3A) and
// SourceSyncRun (§6.1A), and the per-tenant scheduling pattern proven by
// OpportunitySourceConfig (§6.1A).
//
// No agent handler lives in the database — AGENT_REGISTRY is code-level
// (see src/services/agents/registry.ts). These tables hold per-tenant STATE
// only.
//////////////////////////////////////////////////////////////

/// The nine domain agents. Registering a key here does NOT mean the agent is
/// implemented — implementation status lives in the code-level registry.
enum AgentKey {
  OPPORTUNITY
  QUALIFICATION
  COMPLIANCE
  PROPOSAL
  PRICING
  TEAMING
  CONTRACT_ADMINISTRATION
  FINANCE
  INTELLIGENCE
  /// Reserved, never exposed in the product UI. Exists so the shared runtime
  /// can be exercised end-to-end without pretending a domain agent is ready.
  INTERNAL_DIAGNOSTIC
}

enum AgentTriggerType {
  MANUAL
  SCHEDULE
  EVENT
  RETRY
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  WAITING_FOR_REVIEW
  COMPLETED
  FAILED
  CANCELLED
  TIMED_OUT
  SKIPPED
}

/// Autonomy dial. PROPOSE is the default for every agent: it may compute,
/// persist artifacts and raise escalations, but may not silently mutate
/// human-verified business records.
enum AgentAutonomyLevel {
  OBSERVE
  PROPOSE
  ACT_WITH_GUARDRAILS
}

enum AgentConfidenceState {
  HIGH
  MEDIUM
  LOW
  INSUFFICIENT_DATA
}

enum AgentDataSufficiency {
  SUFFICIENT
  PARTIAL
  INSUFFICIENT
}

enum AgentArtifactType {
  OPPORTUNITY_BRIEF
  QUALIFICATION_BRIEF
  COMPLIANCE_STATUS
  PROPOSAL_STATUS
  PRICING_ASSESSMENT
  TEAMING_PLAN
  CONTRACT_HEALTH
  FINANCE_STATUS
  PORTFOLIO_INTELLIGENCE
  /// Produced by the internal diagnostic handler only.
  RUNTIME_DIAGNOSTIC
}

enum AgentEscalationStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum AgentEscalationSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AgentEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  DEAD_LETTER
}

enum AgentScheduleType {
  CRON
  INTERVAL
  MANUAL_ONLY
}

/// Per-tenant, per-agent configuration and cadence. Modelled directly on
/// OpportunitySourceConfig: isEnabled + nextRunAt + consecutiveFailures is the
/// due-query the dispatcher runs, so one poll serves every tenant without
/// creating per-tenant BullMQ repeatables.
model AgentSchedule {
  id               String   @id @default(uuid())
  consultingFirmId String
  agentKey         AgentKey

  isEnabled       Boolean           @default(false)
  scheduleType    AgentScheduleType @default(CRON)
  cronExpression  String?
  intervalMinutes Int?
  timezone        String            @default("UTC")

  nextRunAt           DateTime?
  lastRunAt           DateTime?
  lastSuccessfulRunAt DateTime?
  lastFailureAt       DateTime?
  lastFailureMessage  String?
  consecutiveFailures Int       @default(0)

  maxAttempts   Int                @default(3)
  timeoutMs     Int                @default(600000)
  autonomyLevel AgentAutonomyLevel @default(PROPOSE)

  /// Background LLM budget for this agent within this tenant. null = inherit
  /// the platform default. Enforced BEFORE any provider call.
  tokenBudget           Int?
  costBudgetUsd         Decimal? @db.Decimal(10, 4)
  tokensUsedThisPeriod  Int      @default(0)
  costUsedThisPeriodUsd Decimal  @default(0) @db.Decimal(10, 4)
  budgetPeriodStartedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consultingFirm ConsultingFirm @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  runs           AgentRun[]

  @@unique([consultingFirmId, agentKey])
  @@index([consultingFirmId])
  @@index([agentKey])
  @@index([isEnabled])
  @@index([isEnabled, nextRunAt])
  @@map("agent_schedules")
}

/// One durable execution record. Generalises SolicitationExtractionJob and
/// SourceSyncRun: idempotency key, attempt budget, timeout budget, progress,
/// heartbeat, input snapshot + hash, structured outcome, token/cost capture.
model AgentRun {
  id               String   @id @default(uuid())
  consultingFirmId String
  agentKey         AgentKey

  scheduleId String?
  eventId    String?

  triggerType       AgentTriggerType
  triggerEntityType String?
  triggerEntityId   String?
  initiatedByUserId String?

  /// Collision-free dedupe across schedule/event/manual triggers.
  idempotencyKey String             @unique
  status         AgentRunStatus     @default(QUEUED)
  autonomyLevel  AgentAutonomyLevel @default(PROPOSE)

  attempt     Int @default(1)
  maxAttempts Int @default(3)
  timeoutMs   Int @default(600000)

  progressPercent Int     @default(0)
  progressStage   String?

  /// What the run saw. inputHash enables skip-if-unchanged without re-reading.
  inputSnapshot Json?
  inputHash     String?

  outputSummary   String?
  confidenceState AgentConfidenceState?
  dataSufficiency AgentDataSufficiency?
  warnings        String[]              @default([])
  limitations     String[]              @default([])

  errorCode    String?
  errorMessage String?

  startedAt   DateTime?
  heartbeatAt DateTime?
  finishedAt  DateTime?
  cancelledAt DateTime?
  durationMs  Int?

  tokenInput       Int     @default(0)
  tokenOutput      Int     @default(0)
  estimatedCostUsd Decimal @default(0) @db.Decimal(10, 6)

  handlerVersion String @default("v1")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consultingFirm ConsultingFirm @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  schedule       AgentSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  event          AgentEvent?    @relation(fields: [eventId], references: [id], onDelete: SetNull)

  artifacts   AgentArtifact[]
  escalations AgentEscalation[]

  @@index([consultingFirmId, agentKey, status])
  @@index([consultingFirmId, createdAt])
  @@index([consultingFirmId, triggerEntityType, triggerEntityId])
  @@index([status, heartbeatAt])
  @@index([scheduleId])
  @@index([eventId])
  @@map("agent_runs")
}

/// Durable structured output. Never mutated after human verification — a newer
/// result supersedes rather than overwrites, preserving the decision trail.
model AgentArtifact {
  id               String   @id @default(uuid())
  consultingFirmId String
  runId            String
  agentKey         AgentKey

  artifactType AgentArtifactType
  title        String
  summary      String?

  structuredData Json
  /// Per-claim source attribution: {sourceType, sourceId, sourceLocator, retrievedAt}[]
  evidence       Json?

  sourceEntityType String?
  sourceEntityId   String?

  confidenceState AgentConfidenceState @default(MEDIUM)

  isHumanVerified  Boolean   @default(false)
  verifiedByUserId String?
  verifiedAt       DateTime?

  /// Set when a later run produces a newer artifact for the same subject.
  supersededByArtifactId String?
  supersededAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([consultingFirmId, agentKey, artifactType])
  @@index([consultingFirmId, sourceEntityType, sourceEntityId])
  @@index([runId])
  @@map("agent_artifacts")
}

/// A decision an agent refused to make alone. Deduped on dedupeKey so repeated
/// runs never produce an endless queue of identical OPEN items.
model AgentEscalation {
  id               String   @id @default(uuid())
  consultingFirmId String
  runId            String?
  agentKey         AgentKey

  severity AgentEscalationSeverity @default(MEDIUM)
  status   AgentEscalationStatus   @default(OPEN)

  title             String
  reason            String
  recommendedAction String?

  entityType String?
  entityId   String?

  /// Stable per (firm, agent, reason, entity) so re-runs update rather than duplicate.
  dedupeKey String @unique

  assignedToUserId String?
  dueAt            DateTime?

  acknowledgedAt       DateTime?
  acknowledgedByUserId String?
  resolvedAt           DateTime?
  resolvedByUserId     String?
  resolution           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consultingFirm ConsultingFirm @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  run            AgentRun?      @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([consultingFirmId, status, severity])
  @@index([consultingFirmId, agentKey, status])
  @@index([assignedToUserId])
  @@index([runId])
  @@map("agent_escalations")
}

/// Transactional outbox. Producers insert inside the SAME transaction as their
/// business write, so an event can never exist for a rolled-back change and can
/// never be lost to a process restart (unlike Redis pub/sub).
model AgentEvent {
  id               String @id @default(uuid())
  consultingFirmId String

  eventType  String
  entityType String?
  entityId   String?
  payload    Json    @default("{}")

  /// Producer-supplied stability key — the single source of at-most-once delivery.
  dedupeKey String @unique

  status      AgentEventStatus @default(PENDING)
  availableAt DateTime         @default(now())
  claimedAt   DateTime?
  claimedBy   String?
  processedAt DateTime?

  attempt     Int     @default(0)
  maxAttempts Int     @default(3)
  lastError   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consultingFirm ConsultingFirm @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  runs           AgentRun[]

  @@index([status, availableAt])
  @@index([consultingFirmId, eventType])
  @@index([consultingFirmId, entityType, entityId])
  @@map("agent_events")
}

/// Per-user, per-agent notification routing. Distinct from NotificationPreference,
/// which is keyed to clientCompanyId and serves the client portal only.
model AgentNotificationPreference {
  id               String   @id @default(uuid())
  consultingFirmId String
  userId           String
  agentKey         AgentKey

  inAppEnabled Boolean @default(true)
  emailEnabled Boolean @default(false)

  minimumSeverity AgentEscalationSeverity @default(MEDIUM)

  notifyOnSuccess    Boolean @default(false)
  notifyOnFailure    Boolean @default(true)
  notifyOnEscalation Boolean @default(true)

  digestMode Boolean @default(false)
  timezone   String  @default("UTC")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consultingFirm ConsultingFirm @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, agentKey])
  @@index([consultingFirmId])
  @@index([consultingFirmId, agentKey])
  @@map("agent_notification_preferences")
}

//////////////////////////////////////////////////////////////
// §7.2 — PURSUIT FEEDBACK LEARNING
//
// One durable, versioned signal per deterministic input fingerprint. The
// learned adjustment is ADVISORY: it changes nothing until a human ADMIN
// applies it, and reverting restores the exact preserved baseline rather than
// recalculating what the old weights probably were.
//
// Behavioural learning is tenant-private. Every query is scoped by
// consultingFirmId and no aggregate is ever computed across firms.
//////////////////////////////////////////////////////////////

enum PursuitFeedbackStatus {
  /// Below the configured minimum sample. Carries evidence but no applicable change.
  INSUFFICIENT_DATA
  /// A bounded adjustment awaiting human approval. Production matching is unchanged.
  PROPOSED
  /// A human ADMIN applied it. This is the firm's effective matching weighting.
  APPLIED
  /// A human ADMIN reverted it. The preserved baseline is back in force.
  REVERTED
  /// A newer proposal replaced this one before it was ever applied.
  SUPERSEDED
}

model PursuitFeedbackSignal {
  id               String @id @default(uuid())
  consultingFirmId String

  /// Bumped whenever the derivation changes, so old signals stay interpretable.
  algorithmVersion String @default("pursuit-feedback-v1")
  /// Deterministic fingerprint of the labelled evidence. Identical input =
  /// identical signal, so a repeated analysis never creates a second row.
  inputHash        String

  status PursuitFeedbackStatus @default(PROPOSED)

  sampleSize        Int @default(0)
  pursuedSampleSize Int @default(0)
  ignoredSampleSize Int @default(0)
  /// The policy threshold in force when this signal was generated.
  minimumSampleSize Int

  confidenceState AgentConfidenceState @default(INSUFFICIENT_DATA)
  dataSufficiency AgentDataSufficiency @default(INSUFFICIENT)

  /// The dimension weights in force at generation time. Revert restores exactly this.
  baselineWeights Json
  /// The bounded, renormalised adjustment being proposed.
  proposedWeights Json
  /// Per-dimension sample counts, means, deltas and bounds — the whole rationale.
  evidence        Json

  summary          String?
  generatedByRunId String?
  generatedAt      DateTime @default(now())

  appliedByUserId String?
  appliedAt       DateTime?

  revertedByUserId String?
  revertedAt       DateTime?

  supersededBySignalId String?
  supersededAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consultingFirm ConsultingFirm @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  appliedBy      User?          @relation("PursuitFeedbackAppliedBy", fields: [appliedByUserId], references: [id], onDelete: SetNull)
  revertedBy     User?          @relation("PursuitFeedbackRevertedBy", fields: [revertedByUserId], references: [id], onDelete: SetNull)

  @@unique([consultingFirmId, inputHash])
  @@index([consultingFirmId, status])
  @@index([consultingFirmId, generatedAt])
  @@map("pursuit_feedback_signals")
}

//////////////////////////////////////////////////////////////
// §7.3 — SURETY BONDING CAPACITY
//
// Firm-level bonding capacity, which the proposal requires the Compliance
// Agent to monitor and which no existing model represents. (ClientCompany
// carries a single self-reported `bondingCapacity` Decimal describing a
// CLIENT's capacity; it is a different subject and is left untouched.)
//
// These are structured business facts a human maintains from a surety letter.
// The agent reads them, computes expiry and headroom, and reports honestly —
// it never creates, edits or infers a bonding value.
//////////////////////////////////////////////////////////////

enum BondingCapacityStatus {
  /// Recorded and in force.
  ACTIVE
  /// Past its expiry date. Never counted as available capacity.
  EXPIRED
  /// Superseded by a newer letter, or withdrawn by the surety.
  ARCHIVED
}

/// A surety's stated bonding capacity for one firm.
///
/// Money is Decimal throughout — bonding limits are financial facts and are
/// never held as floats. `availableCapacity` is DERIVED at read time from
/// aggregate minus committed, and is deliberately NOT stored: a stale stored
/// figure would be worse than no figure at all. When either input is absent the
/// agent reports INSUFFICIENT_DATA rather than manufacturing headroom.
model BondingCapacity {
  id               String @id @default(uuid())
  consultingFirmId String

  /// Surety or broker who issued the capacity letter.
  suretyName         String?
  /// Largest single project the surety will bond.
  singleProjectLimit Decimal? @db.Decimal(14, 2)
  /// Total simultaneous exposure the surety will carry.
  aggregateLimit     Decimal? @db.Decimal(14, 2)
  /// Currently committed against the aggregate limit, as the firm records it.
  committedAmount    Decimal? @db.Decimal(14, 2)

  effectiveDate DateTime?
  expiryDate    DateTime?

  status BondingCapacityStatus @default(ACTIVE)

  /// Where the figures came from — letter reference, broker email, file name.
  evidenceReference String?
  notes             String?

  /// Human attribution. The agent never writes these.
  recordedByUserId String?
  verifiedByUserId String?
  verifiedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consultingFirm ConsultingFirm @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  recordedBy     User?          @relation("BondingRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  verifiedBy     User?          @relation("BondingVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  @@index([consultingFirmId, status])
  @@index([consultingFirmId, expiryDate])
  @@map("bonding_capacities")
}

//////////////////////////////////////////////////////////////
// §7.4 — QUALIFICATION RECOMMENDATION
//
// The Qualification Agent's bid/no-bid RECOMMENDATION. It is deliberately a
// separate concept from both existing decision records:
//
//   Scorecard / ScorecardDecision  the §5.2 HUMAN qualification decision
//   BidDecision                    the engine's opportunity×client scoring row
//   QualificationRecommendation    what the AGENT recommends, and why
//
// Keeping them separate is the whole point: an agent recommendation must never
// be mistakable for a decision a person made. The agent writes only this table;
// it never writes the other two.
//
// Append-only in effect: a materially changed input produces a NEW version and
// supersedes the previous row rather than overwriting it, because a
// recommendation is decision evidence.
//////////////////////////////////////////////////////////////

enum QualificationRecommendationResult {
  /// Evidence supports bidding, with no critical blocker or contradiction.
  RECOMMEND_BID
  /// Evidence supports not bidding.
  RECOMMEND_NO_BID
  /// Near the decision boundary, or a critical uncertainty exists. A human decides.
  BORDERLINE_REVIEW
  /// Too little evidence to recommend anything. Never silently a NO_BID.
  INSUFFICIENT_DATA
}

enum QualificationRecommendationStrength {
  STRONG
  MODERATE
  WEAK
  NONE
}

enum QualificationRecommendationStatus {
  /// The agent's current recommendation for this pursuit.
  ACTIVE
  /// A human accepted it; the decision itself was recorded through the canonical human workflow.
  ACCEPTED
  /// A human rejected it; their own decision was recorded through the canonical human workflow.
  REJECTED
  /// A newer version replaced it. The row is retained as decision evidence.
  SUPERSEDED
}

model QualificationRecommendation {
  id               String  @id @default(uuid())
  consultingFirmId String
  pursuitId        String
  opportunityId    String
  /// The run that produced it. Null only if the row outlives its run.
  agentRunId       String?

  /// Monotonic per pursuit, so history reads in order.
  version          Int    @default(1)
  /// Deterministic fingerprint of the normalised evidence. Unchanged inputs
  /// produce no new version.
  inputHash        String
  algorithmVersion String @default("qualification-v1")

  recommendation QualificationRecommendationResult
  strength       QualificationRecommendationStrength @default(NONE)

  /// Probability is a 0–100 score, matching Opportunity.probabilityScore and
  /// the Section 5/6 stack. Not money, so not Decimal.
  rawProbability   Int?
  finalProbability Int?
  /// RAW | CALIBRATED | FALLBACK — the canonical winProbability vocabulary.
  probabilityMode  String?
  calibrationnote  String?

  confidenceLower Int?
  confidenceUpper Int?
  confidenceState AgentConfidenceState @default(INSUFFICIENT_DATA)
  dataSufficiency AgentDataSufficiency @default(INSUFFICIENT)

  scorecardScore Int?

  /// True when the recommendation is BORDERLINE_REVIEW, with the reason codes
  /// the deterministic policy produced.
  isBorderline      Boolean  @default(false)
  borderlineReasons String[] @default([])

  capabilityGapSeverity String?
  capacityState         String?

  /// Structured evidence summaries. Each records its own sample sizes and
  /// limitations so nothing is presented without its denominator.
  incumbentEvidence  Json?
  competitorEvidence Json?
  pricingEvidence    Json?
  complianceEvidence Json?

  /// Deterministically rendered from the structured evidence above. Contains no
  /// number the evidence did not already supply.
  narrative String

  evidence        Json?
  dataLimitations String[] @default([])

  /// A priority the agent PROPOSES. It never writes BidPursuit.priority,
  /// because that field carries no human/derived distinction.
  proposedPriority String?

  status QualificationRecommendationStatus @default(ACTIVE)

  supersedesId String?
  supersededAt DateTime?

  acceptedByUserId String?
  acceptedAt       DateTime?
  rejectedByUserId String?
  rejectedAt       DateTime?
  /// What the human actually decided, recorded for side-by-side evidence.
  humanDecision    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consultingFirm ConsultingFirm @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  pursuit        BidPursuit     @relation(fields: [pursuitId], references: [id], onDelete: Cascade)
  acceptedBy     User?          @relation("QualificationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  rejectedBy     User?          @relation("QualificationRejectedBy", fields: [rejectedByUserId], references: [id], onDelete: SetNull)

  @@unique([pursuitId, inputHash])
  @@index([consultingFirmId, status])
  @@index([consultingFirmId, pursuitId, version])
  @@index([consultingFirmId, createdAt])
  @@map("qualification_recommendations")
}

//////////////////////////////////////////////////////////////
// SECTION 7.5 — TEAMING AGENT
// Objective partner-performance evidence and subcontracting-goal obligations.
// Every row is tenant-private: two firms may know the same legal company, and
// neither may see the other's judgement of it.
//////////////////////////////////////////////////////////////

// How much evidence stands behind a computed figure. Never guessed.
enum TeamingDataSufficiency {
  INSUFFICIENT_DATA
  PARTIAL
  SUFFICIENT
}

// Socio-economic category a subcontracting obligation is measured against.
enum SubcontractingGoalType {
  SMALL_BUSINESS
  SMALL_DISADVANTAGED_BUSINESS
  SDVOSB
  VOSB
  WOSB
  HUBZONE
  ANC_TRIBAL
  HBCU_MI
  OTHER
}

// Whether the obligation is expressed as a percentage or a dollar amount.
enum SubcontractingGoalTargetType {
  PERCENT
  AMOUNT
}

// Where the obligation came from. A goal is never invented by the platform.
enum SubcontractingGoalSource {
  SOLICITATION
  SUBCONTRACTING_PLAN
  CONTRACT
  HUMAN_ENTRY
}

enum SubcontractingGoalStatus {
  ACTIVE
  ACHIEVED
  MISSED
  ARCHIVED
}

// Deterministic risk state. INSUFFICIENT_DATA is a real answer, not a default.
enum SubcontractingGoalRiskState {
  ON_TRACK
  WATCH
  AT_RISK
  MISSED
  INSUFFICIENT_DATA
}

// -----------------------------------------------------------------
// PartnerPerformanceRecord — OBJECTIVE outcomes only.
//
// Computed exclusively from evidence explicitly linked to the partner
// (ContractDeliverable.partnerId). Counts are stored as raw numerator and
// denominator so a rate can never be shown without the sample behind it.
// `humanNotes` and `isHumanVerified` belong to a person; the agent writes
// neither and overwrites neither.
// -----------------------------------------------------------------
model PartnerPerformanceRecord {
  id               String  @id @default(uuid())
  consultingFirmId String
  partnerId        String
  contractId       String?
  opportunityId    String?

  periodStart DateTime
  periodEnd   DateTime

  engagementCount      Int @default(0)
  deliverablesDue      Int @default(0)
  deliverablesOnTime   Int @default(0)
  deliverablesLate     Int @default(0)
  deliverablesAccepted Int @default(0)
  deliverablesRejected Int @default(0)
  issuesRaised         Int @default(0)

  // { CRITICAL: n, HIGH: n, MEDIUM: n, LOW: n } — counts, never a grade.
  issueSeverityCounts Json @default("{}")

  // Denominator for every rate below. Below the policy minimum → INSUFFICIENT_DATA.
  sampleSize      Int                    @default(0)
  dataSufficiency TeamingDataSufficiency @default(INSUFFICIENT_DATA)

  // { onTimeRate: {numerator, denominator, percent}, acceptanceRate: {...}, issueRate: {...} }
  computedMetrics Json @default("{}")

  // Ids of the ContractDeliverable rows this record was computed from.
  evidenceRecordIds String[] @default([])
  evidence          Json     @default("{}")

  // A DERIVED label produced by the documented decline policy, never a
  // subjective human judgement. Null unless the policy fired.
  derivedLabel    String?
  declineEvidence Json?

  // Human-owned. The agent never sets these.
  isHumanVerified Boolean @default(false)
  humanNotes      String?

  methodVersion String   @default("teaming-performance-v1")
  generatedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  consultingFirm ConsultingFirm @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  partner        Partner        @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, periodStart, periodEnd])
  @@index([consultingFirmId])
  @@index([consultingFirmId, partnerId])
  @@index([consultingFirmId, periodEnd])
  @@map("partner_performance_records")
}

// -----------------------------------------------------------------
// SubcontractingGoal — a small-business participation obligation.
//
// It must come from a solicitation, a subcontracting plan, a contract, or a
// verified human entry. The platform never invents a statutory target.
// -----------------------------------------------------------------
model SubcontractingGoal {
  id               String  @id @default(uuid())
  consultingFirmId String
  pursuitId        String?
  contractId       String?
  opportunityId    String?

  goalType   SubcontractingGoalType
  // Free-text refinement of goalType when the source names one.
  category   String?
  targetType SubcontractingGoalTargetType

  targetPercent Decimal? @db.Decimal(5, 2)
  targetAmount  Decimal? @db.Decimal(14, 2)

  source          SubcontractingGoalSource
  sourceReference String?

  measurementStartDate DateTime?
  measurementEndDate   DateTime?
  dueDate              DateTime?

  status          SubcontractingGoalStatus @default(ACTIVE)
  // A goal drives escalations only once a person has verified it.
  isHumanVerified Boolean                  @default(false)
  createdByUserId String?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consultingFirm ConsultingFirm               @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  progress       SubcontractingGoalProgress[]

  @@index([consultingFirmId])
  @@index([consultingFirmId, status])
  @@index([consultingFirmId, dueDate])
  @@index([pursuitId])
  @@index([contractId])
  @@map("subcontracting_goals")
}

// -----------------------------------------------------------------
// SubcontractingGoalProgress — attainment for one measurement period.
//
// All money is Decimal. A missing authoritative ledger yields
// INSUFFICIENT_DATA, never an implied zero.
// -----------------------------------------------------------------
model SubcontractingGoalProgress {
  id               String @id @default(uuid())
  consultingFirmId String
  goalId           String

  periodStart DateTime
  periodEnd   DateTime

  eligibleBaseAmount Decimal? @db.Decimal(14, 2)
  achievedAmount     Decimal? @db.Decimal(14, 2)
  achievedPercent    Decimal? @db.Decimal(5, 2)
  remainingAmount    Decimal? @db.Decimal(14, 2)
  remainingPercent   Decimal? @db.Decimal(5, 2)

  riskState       SubcontractingGoalRiskState @default(INSUFFICIENT_DATA)
  dataSufficiency TeamingDataSufficiency      @default(INSUFFICIENT_DATA)

  // Working days between calculatedAt and the goal deadline, when both exist.
  workingDaysRemaining Int?

  evidenceRecordIds String[] @default([])
  evidence          Json     @default("{}")
  limitations       String[] @default([])

  methodVersion String   @default("teaming-goal-v1")
  calculatedAt  DateTime @default(now())
  createdAt     DateTime @default(now())

  consultingFirm ConsultingFirm     @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  goal           SubcontractingGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, periodStart, periodEnd])
  @@index([consultingFirmId])
  @@index([goalId])
  @@index([consultingFirmId, riskState])
  @@map("subcontracting_goal_progress")
}

//////////////////////////////////////////////////////////////
// SECTION 7.6 — PRICING AGENT
// A cached, reproducible benchmark of comparable PUBLIC federal awards.
//////////////////////////////////////////////////////////////

/// How much comparable public evidence stands behind a benchmark.
enum BenchmarkDataSufficiency {
  INSUFFICIENT_DATA
  PARTIAL
  SUFFICIENT
}

/// How far the deterministic fallback ladder had to be relaxed to find a cohort.
/// Recorded on every cohort so a broadened filter is never hidden.
enum BenchmarkFilterLevel {
  LEVEL_1_NAICS_AGENCY_SETASIDE_BAND
  LEVEL_2_NAICS_AGENCY_BAND
  LEVEL_3_NAICS_BAND
  LEVEL_4_NAICS
  NONE
}

/// Where a proposed price sits against the historical distribution. This is a
/// statement about historical POSITION, never a verdict that a price is good.
enum CompetitiveRangeState {
  BELOW_HISTORICAL_RANGE
  WITHIN_HISTORICAL_RANGE
  ABOVE_HISTORICAL_RANGE
  EXTREME_OUTLIER
  INSUFFICIENT_DATA
}

// -----------------------------------------------------------------
// AwardBenchmarkCohort
//
// Built ONLY from public federal award records (AwardHistory, ingested from
// USAspending/FPDS). It never reads another tenant's PricingWorkspace,
// PricingScenario, PricingLaborLine, PricingIndirectRate, PricingTemplate or
// ContractLaborRate — proven by `awardBenchmark.isolation.test.ts`.
//
// `consultingFirmId` scopes the CACHED RESULT to the tenant that asked for it.
// It does not scope the evidence: two firms benchmarking the same NAICS and
// agency see the same public awards, because those awards are public.
// -----------------------------------------------------------------
model AwardBenchmarkCohort {
  id                 String  @id @default(uuid())
  consultingFirmId   String
  opportunityId      String?
  pricingWorkspaceId String?
  pricingScenarioId  String?

  /// Digest of the normalized cohort inputs. Identical inputs reuse the row.
  inputHash        String
  algorithmVersion String @default("award-benchmark-v1")
  cohortVersion    Int    @default(1)

  filterLevel    BenchmarkFilterLevel
  /// Human-readable list of every filter that had to be relaxed, and why.
  relaxedFilters String[]             @default([])

  naics         String?
  agency        String?
  setAside      String?
  valueBandLow  Decimal? @db.Decimal(16, 2)
  valueBandHigh Decimal? @db.Decimal(16, 2)
  periodStart   DateTime
  periodEnd     DateTime

  cohortSize        Int      @default(0)
  /// AwardHistory ids that formed the distribution — the audit trail.
  sourceIds         String[] @default([])
  /// AwardHistory ids considered and rejected, with the reason.
  excludedSourceIds String[] @default([])
  exclusionReasons  Json     @default("[]")

  /// Null below the minimum cohort size. Never a placeholder zero.
  minimumValue Decimal? @db.Decimal(16, 2)
  p25Value     Decimal? @db.Decimal(16, 2)
  medianValue  Decimal? @db.Decimal(16, 2)
  p75Value     Decimal? @db.Decimal(16, 2)
  maximumValue Decimal? @db.Decimal(16, 2)
  meanValue    Decimal? @db.Decimal(16, 2)

  /// [{ awardId, agency, naics, setAside, awardDate, awardAmount, included }]
  distributionData Json @default("[]")

  dataSufficiency BenchmarkDataSufficiency @default(INSUFFICIENT_DATA)
  limitations     String[]                 @default([])

  computedAt DateTime  @default(now())
  staleAt    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  consultingFirm ConsultingFirm @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)

  @@unique([consultingFirmId, inputHash])
  @@index([consultingFirmId])
  @@index([consultingFirmId, pricingScenarioId])
  @@index([consultingFirmId, pricingWorkspaceId])
  @@index([consultingFirmId, computedAt])
  @@index([staleAt])
  @@map("award_benchmark_cohorts")
}

//////////////////////////////////////////////////////////////
// SECTION 7.7 — PROPOSAL AGENT CAPABILITY LIBRARY
// Reusable, human-approved proposal narrative. Deliberately narrow: this is
// the minimum library the Proposal Agent needs, NOT the Section 8 document and
// knowledge layer. No resume library, no personnel library, no portal.
//////////////////////////////////////////////////////////////

/// What kind of reusable proposal content a narrative holds.
enum CapabilityNarrativeCategory {
  TECHNICAL_NARRATIVE
  DIFFERENTIATOR
  MANAGEMENT_APPROACH
  QUALITY_APPROACH
  BOILERPLATE
  OTHER
}

enum CapabilityNarrativeStatus {
  ACTIVE
  ARCHIVED
}

/// Version lifecycle. Only a HUMAN moves a version to APPROVED — the Proposal
/// Agent can never create or promote an approved version.
enum CapabilityNarrativeVersionStatus {
  DRAFT
  APPROVED
  ARCHIVED
}

// -----------------------------------------------------------------
// CapabilityNarrative — the reusable item.
//
// The item itself carries no prose. Text lives in versions, so approving an
// edit never destroys the wording a previous proposal was built on.
// -----------------------------------------------------------------
model CapabilityNarrative {
  id               String @id @default(uuid())
  consultingFirmId String

  title    String
  category CapabilityNarrativeCategory @default(TECHNICAL_NARRATIVE)

  /// Deterministic retrieval metadata. No embeddings, no vector store.
  capabilityKeys String[] @default([])
  naicsCodes     String[] @default([])
  agencyTags     String[] @default([])
  tags           String[] @default([])

  status CapabilityNarrativeStatus @default(ACTIVE)

  /// The one version the agent may quote as an approved contractor fact.
  currentApprovedVersionId String?

  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  archivedAt      DateTime?

  consultingFirm ConsultingFirm               @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  versions       CapabilityNarrativeVersion[]

  @@index([consultingFirmId])
  @@index([consultingFirmId, status])
  @@index([consultingFirmId, category])
  @@map("capability_narratives")
}

// -----------------------------------------------------------------
// CapabilityNarrativeVersion — immutable once approved.
//
// Editing approved text creates a NEW draft version rather than replacing the
// approved one, so an agent run remains reproducible against the exact version
// it quoted. `contentHash` is what a proposal draft fingerprint pins.
// -----------------------------------------------------------------
model CapabilityNarrativeVersion {
  id                    String @id @default(uuid())
  consultingFirmId      String
  capabilityNarrativeId String

  versionNumber Int
  content       String
  contentHash   String

  status CapabilityNarrativeVersionStatus @default(DRAFT)

  /// Where the claims in this text come from, for citation traceability.
  sourceReferences String[] @default([])
  evidence         Json     @default("{}")

  createdByUserId String?
  createdAt       DateTime @default(now())

  /// Set only by a human approval. The agent never writes these.
  approvedByUserId String?
  approvedAt       DateTime?
  supersededAt     DateTime?

  consultingFirm ConsultingFirm      @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  narrative      CapabilityNarrative @relation(fields: [capabilityNarrativeId], references: [id], onDelete: Cascade)

  @@unique([capabilityNarrativeId, versionNumber])
  @@index([consultingFirmId])
  @@index([consultingFirmId, status])
  @@index([capabilityNarrativeId, status])
  @@map("capability_narrative_versions")
}

//////////////////////////////////////////////////////////////
// SECTION 7.8 — FINANCE AGENT
// Three models, all firm-scoped. They record ACTUALS, READINESS EVIDENCE and
// PROJECTIONS. They never duplicate Module 9: ContractInvoice, InvoicePayment,
// TimeEntry and ContractCost remain the only authoritative billing records.
//////////////////////////////////////////////////////////////

/// Where an actual indirect rate came from. Never inferred from a provisional rate.
enum ActualIndirectRateSource {
  MANUAL_ENTRY
  IMPORT
  /// Derived from authoritative pool cost and allocation base records held here.
  DERIVED_FROM_LEDGER
}

enum ActualIndirectRateStatus {
  DRAFT
  FINAL
  SUPERSEDED
}

/// Realized indirect rate for one accounting period and one pool.
///
/// This is FINANCIAL SOURCE DATA. The Finance Agent reads it and never writes,
/// derives or fabricates it — an actual rate invented from a provisional rate
/// would make every downstream variance a self-fulfilling zero.
model ActualIndirectRate {
  id                   String                   @id @default(cuid())
  consultingFirmId     String
  periodStart          DateTime
  periodEnd            DateTime
  fiscalYear           Int
  /// FRINGE | OVERHEAD | GA | MATERIAL_HANDLING | SUBCONTRACT_HANDLING | OTHER.
  /// Same vocabulary as PricingIndirectRate.rateType so the two can be matched.
  rateType             String
  poolName             String?
  /// Same precision as PricingIndirectRate.percent so a comparison is exact.
  actualRate           Decimal                  @db.Decimal(7, 4)
  /// Present only when the firm actually recorded them. Never back-solved.
  allocationBaseAmount Decimal?                 @db.Decimal(14, 2)
  poolCostAmount       Decimal?                 @db.Decimal(14, 2)
  source               ActualIndirectRateSource @default(MANUAL_ENTRY)
  sourceReference      String?
  status               ActualIndirectRateStatus @default(DRAFT)
  isHumanVerified      Boolean                  @default(false)
  verifiedByUserId     String?
  verifiedAt           DateTime?
  notes                String?
  createdByUserId      String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  consultingFirm ConsultingFirm @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)

  /// One live actual per firm, pool and period.
  @@unique([consultingFirmId, rateType, periodStart, periodEnd])
  @@index([consultingFirmId])
  @@index([consultingFirmId, fiscalYear])
  @@index([consultingFirmId, rateType])
  @@index([consultingFirmId, periodStart, periodEnd])
  @@map("actual_indirect_rates")
}

/// Outcome of one readiness rule. Deliberately NOT just PASS/FAIL: a rule the
/// schema cannot answer is UNSUPPORTED, and a rule with no records to judge is
/// INSUFFICIENT_DATA. Neither is silently counted as a pass.
enum DcaaReadinessVerdict {
  PASS
  FAIL
  WARNING
  MANUAL_REVIEW
  INSUFFICIENT_DATA
  UNSUPPORTED
}

enum DcaaReadinessSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

/// One rule result, with its evidence.
///
/// This is a Bytescon PRODUCT READINESS INDICATOR. It is not a DCAA audit, a
/// certification, or an opinion that an audit would pass. Persisting evidence
/// per rule — rather than an aggregate score — is what makes it auditable.
model DcaaReadinessCheck {
  id               String                @id @default(cuid())
  consultingFirmId String
  contractId       String?
  periodStart      DateTime?
  periodEnd        DateTime?
  ruleKey          String
  ruleVersion      String
  verdict          DcaaReadinessVerdict
  severity         DcaaReadinessSeverity
  /// SUFFICIENT | PARTIAL | INSUFFICIENT_DATA — mirrors the runtime vocabulary.
  dataSufficiency  String
  summary          String
  /// Human-readable findings, one per offending record where applicable.
  evidence         String[]              @default([])
  /// Ids of the records the verdict rests on, so a reviewer can go and look.
  sourceRecordIds  String[]              @default([])
  recordsChecked   Int                   @default(0)
  recordsFailing   Int                   @default(0)
  limitations      String[]              @default([])
  agentRunId       String?
  checkedAt        DateTime              @default(now())

  consultingFirm ConsultingFirm @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)

  @@index([consultingFirmId])
  @@index([consultingFirmId, checkedAt])
  @@index([consultingFirmId, ruleKey])
  @@index([consultingFirmId, verdict])
  @@index([contractId])
  @@map("dcaa_readiness_checks")
}

/// How much of the projection rests on real records rather than estimation.
enum CashFlowConfidenceState {
  /// Statistically supportable bands from sufficient payment history.
  BANDED
  /// Deterministic amounts only; not enough history for bands.
  DETERMINISTIC_ONLY
  INSUFFICIENT_DATA
}

/// A projection of future cash movement across the active contract portfolio.
///
/// The platform stores NO opening cash balance, so this model deliberately has
/// no openingCashBalance or projectedEndingCash column. Reporting a "cash
/// position" without knowing the starting balance would be a fabricated number;
/// what is real here is NET CASH FLOW.
model CashFlowProjection {
  id                     String                  @id @default(cuid())
  consultingFirmId       String
  periodStart            DateTime
  periodEnd              DateTime
  horizonMonths          Int
  methodVersion          String
  /// Normalised hash of every input. An unchanged portfolio reprojects to the
  /// same hash and no duplicate row is written.
  inputHash              String
  projectedReceipts      Decimal                 @db.Decimal(14, 2)
  projectedDisbursements Decimal                 @db.Decimal(14, 2)
  netCashFlow            Decimal                 @db.Decimal(14, 2)
  confidenceLower        Decimal?                @db.Decimal(14, 2)
  confidenceUpper        Decimal?                @db.Decimal(14, 2)
  confidenceState        CashFlowConfidenceState @default(INSUFFICIENT_DATA)
  /// Amounts per source class, so a contracted receivable is never presented
  /// as pipeline expected value or the reverse.
  sourceBreakdown        Json                    @default("{}")
  dataSufficiency        String
  limitations            String[]                @default([])
  agentRunId             String?
  supersedesId           String?
  computedAt             DateTime                @default(now())

  consultingFirm ConsultingFirm @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)

  @@index([consultingFirmId])
  @@index([consultingFirmId, computedAt])
  @@index([consultingFirmId, periodStart, periodEnd])
  @@index([consultingFirmId, inputHash])
  @@map("cash_flow_projections")
}

//////////////////////////////////////////////////////////////
// SECTION 7.9 — INTELLIGENCE AGENT
// Two models, both firm-scoped. They record MEASURED OUTCOMES and ADVISORY
// recommendations. Nothing here decides anything: the Intelligence Agent
// analyses and recommends, and a person decides whether to act.
//
// Statistical fields are deliberately NULLABLE. A segment below the minimum
// confirmed sample stores no rate and no interval — a stored 0% would be a
// fabricated finding, and null is the honest value.
//////////////////////////////////////////////////////////////

/// How much confirmed evidence stands behind a measurement.
enum IntelligenceDataSufficiency {
  SUFFICIENT
  PARTIAL
  INSUFFICIENT_DATA
}

/// The dimensions confirmed outcomes are segmented by.
enum WinLossSegmentType {
  OVERALL
  AGENCY
  NAICS
  CONTRACT_VEHICLE
  SET_ASIDE
  VALUE_BAND
}

/// One measured win/loss segment for one analysis period.
///
/// `wins` and `losses` count CONFIRMED participation outcomes only. `pending`
/// is reported alongside but never enters the denominator — a submitted bid
/// awaiting an award notice is not a loss.
model WinLossSegment {
  id                String                      @id @default(cuid())
  consultingFirmId  String
  segmentType       WinLossSegmentType
  /// Canonical key: agency name, NAICS code, vehicle, set-aside, band key, or
  /// 'OVERALL'. 'UNKNOWN' when the dimension is genuinely unrecorded.
  segmentKey        String
  segmentLabel      String
  periodStart       DateTime
  periodEnd         DateTime
  wins              Int                         @default(0)
  losses            Int                         @default(0)
  pending           Int                         @default(0)
  /// wins + losses. Never includes pending.
  sampleSize        Int                         @default(0)
  minimumSampleSize Int
  /// NULL below the minimum sample. Never 0 as a placeholder.
  winRate           Decimal?                    @db.Decimal(6, 5)
  intervalLower     Decimal?                    @db.Decimal(6, 5)
  intervalUpper     Decimal?                    @db.Decimal(6, 5)
  dataSufficiency   IntelligenceDataSufficiency @default(INSUFFICIENT_DATA)
  /// Ids of the SubmissionRecords the counts rest on, so a reader can verify.
  sourceOutcomeIds  String[]                    @default([])
  limitations       String[]                    @default([])
  algorithmVersion  String
  inputHash         String
  agentRunId        String?
  supersedesId      String?
  supersededAt      DateTime?
  computedAt        DateTime                    @default(now())
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  consultingFirm ConsultingFirm @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)

  @@index([consultingFirmId])
  @@index([consultingFirmId, segmentType])
  @@index([consultingFirmId, segmentType, segmentKey])
  @@index([consultingFirmId, inputHash])
  @@index([consultingFirmId, computedAt])
  @@map("win_loss_segments")
}

/// Whether a capture score could be computed at all.
enum CaptureScoreState {
  /// Enough confirmed outcomes to score the segment.
  SCORED
  /// Real signal exists but the outcome sample is below the minimum, so the
  /// segment is surfaced without a comparable score.
  EXPLORATORY
  INSUFFICIENT_DATA
}

enum CaptureRecommendationStatus {
  ACTIVE
  SUPERSEDED
  DISMISSED
}

/// An advisory capture-focus recommendation.
///
/// Creating one changes nothing: no pursuit priority, no scoring weight, no
/// pipeline membership. A person dismisses or acts on it.
model CaptureRecommendation {
  id                String                      @id @default(cuid())
  consultingFirmId  String
  segmentType       WinLossSegmentType
  segmentKey        String
  segmentLabel      String
  periodStart       DateTime
  periodEnd         DateTime
  /// NULL unless scoreState is SCORED.
  score             Decimal?                    @db.Decimal(12, 4)
  scoreState        CaptureScoreState           @default(INSUFFICIENT_DATA)
  /// NULL unless scored — an unscorable segment has no meaningful rank.
  rank              Int?
  /// Built deterministically from the structured evidence below. No model.
  rationale         String
  /// Structured evidence. A recommendation is never persisted without it.
  evidence          Json                        @default("{}")
  sampleSize        Int                         @default(0)
  dataSufficiency   IntelligenceDataSufficiency @default(INSUFFICIENT_DATA)
  status            CaptureRecommendationStatus @default(ACTIVE)
  /// Fingerprint of the evidence. A dismissal sticks for this fingerprint, so
  /// an unchanged weekly run never re-raises what a person already dismissed.
  inputHash         String
  algorithmVersion  String
  agentRunId        String?
  supersedesId      String?
  supersededAt      DateTime?
  dismissedByUserId String?
  dismissedAt       DateTime?
  dismissReason     String?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  consultingFirm ConsultingFirm @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)

  @@index([consultingFirmId])
  @@index([consultingFirmId, status])
  @@index([consultingFirmId, segmentType, segmentKey])
  @@index([consultingFirmId, inputHash])
  @@index([consultingFirmId, status, rank])
  @@map("capture_recommendations")
}

// =============================================================
// §8.1 — GovCon CRM.
//
// Deliberate design decisions, so this never becomes a second system:
//
//  - There is NO new Agency model. Agency identity already lives as a string
//    on Opportunity, Contract and AgencyAwardProfile (the latter is a GLOBAL
//    market-stats table with no tenant, so it cannot be a tenant CRM record).
//    The agency tier is therefore a grouping over agencyName, and the CRM
//    joins AgencyAwardProfile for market context rather than copying it.
//  - Calls and meetings are CrmActivity TYPES, not their own tables.
//  - Follow-ups reuse the existing notification service and are scanned by the
//    existing milestone-reminders job. No second reminder framework exists.
//  - Relationship strength is computed on read from these records; it is never
//    stored, so it cannot go stale or be written by an agent.
// =============================================================

enum GovContactRole {
  CONTRACTING_OFFICER
  CONTRACT_SPECIALIST
  COR
  PROGRAM_MANAGER
  SMALL_BUSINESS_SPECIALIST
  TECHNICAL_LEAD
  OTHER
}

enum CrmContactStatus {
  ACTIVE
  INACTIVE
  DEPARTED
}

enum CrmActivityType {
  CALL
  MEETING
  EMAIL
  INDUSTRY_DAY
  SITE_VISIT
  CAPABILITY_BRIEFING
  CONFERENCE
  NOTE
  OTHER
}

enum CrmFollowUpStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum CrmPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// A contracting office within an agency. agencyName intentionally mirrors the
/// string already used on Opportunity/Contract so CRM records line up with
/// pipeline records without a migration of existing data.
model AgencyOffice {
  id               String  @id @default(uuid())
  consultingFirmId String
  agencyName       String
  officeName       String
  officeSymbol     String?
  location         String?
  notes            String?
  isArchived       Boolean @default(false)

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  consultingFirm ConsultingFirm      @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  contacts       GovernmentContact[]
  activities     CrmActivity[]

  @@unique([consultingFirmId, agencyName, officeName])
  @@index([consultingFirmId, agencyName])
  @@index([consultingFirmId, isArchived])
  @@map("agency_offices")
}

/// A person at a government agency. agencyName is stored directly so a contact
/// can exist before an office record does.
model GovernmentContact {
  id               String           @id @default(uuid())
  consultingFirmId String
  agencyOfficeId   String?
  agencyName       String
  fullName         String
  title            String?
  contactRole      GovContactRole   @default(OTHER)
  email            String?
  phone            String?
  status           CrmContactStatus @default(ACTIVE)
  notes            String?
  ownerUserId      String?
  isArchived       Boolean          @default(false)

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  consultingFirm ConsultingFirm @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  agencyOffice   AgencyOffice?  @relation(fields: [agencyOfficeId], references: [id], onDelete: SetNull)
  owner          User?          @relation("GovContactOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  activities     CrmActivity[]
  followUps      CrmFollowUp[]

  @@index([consultingFirmId, agencyName])
  @@index([consultingFirmId, agencyOfficeId])
  @@index([consultingFirmId, isArchived])
  @@map("government_contacts")
}

/// A person at a teaming partner. Hangs off the EXISTING Partner model — no
/// second partner-company record is introduced.
model PartnerContact {
  id                         String           @id @default(uuid())
  consultingFirmId           String
  partnerId                  String
  fullName                   String
  title                      String?
  email                      String?
  phone                      String?
  isPrimary                  Boolean          @default(false)
  status                     CrmContactStatus @default(ACTIVE)
  notes                      String?
  /// Provenance when a contact was seeded from a harvested prime-contractor
  /// record rather than entered by hand.
  sourceSubcontractContactId String?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  consultingFirm ConsultingFirm      @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  partner        Partner             @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  activities     CrmActivity[]
  followUps      CrmFollowUp[]
  portalUsers    PartnerPortalUser[]

  @@index([consultingFirmId, partnerId])
  @@index([consultingFirmId, status])
  @@map("partner_contacts")
}

/// One activity system for every touchpoint. A call and a meeting differ only
/// by activityType — there is no separate call or meeting table.
model CrmActivity {
  id               String          @id @default(uuid())
  consultingFirmId String
  activityType     CrmActivityType
  occurredAt       DateTime
  subject          String
  summary          String?
  notes            String?
  durationMinutes  Int?
  location         String?
  /// Free-text attendee names. Platform users are not required, because most
  /// participants at an industry day are not accounts in this system.
  participants     String[]        @default([])
  followUpNeeded   Boolean         @default(false)
  sourceReference  String?
  ownerUserId      String?

  governmentContactId String?
  agencyOfficeId      String?
  agencyName          String?
  opportunityId       String?
  bidPursuitId        String?
  partnerId           String?
  partnerContactId    String?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  consultingFirm    ConsultingFirm     @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  governmentContact GovernmentContact? @relation(fields: [governmentContactId], references: [id], onDelete: SetNull)
  agencyOffice      AgencyOffice?      @relation(fields: [agencyOfficeId], references: [id], onDelete: SetNull)
  opportunity       Opportunity?       @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  bidPursuit        BidPursuit?        @relation(fields: [bidPursuitId], references: [id], onDelete: SetNull)
  partner           Partner?           @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  partnerContact    PartnerContact?    @relation(fields: [partnerContactId], references: [id], onDelete: SetNull)
  followUps         CrmFollowUp[]

  @@index([consultingFirmId, occurredAt])
  @@index([consultingFirmId, governmentContactId, occurredAt])
  @@index([consultingFirmId, partnerId, occurredAt])
  @@index([consultingFirmId, opportunityId])
  @@index([consultingFirmId, agencyName, occurredAt])
  @@map("crm_activities")
}

/// A CRM follow-up. Reminders are delivered by the EXISTING notification
/// service and scanned by the EXISTING milestone-reminders job; dedupe is the
/// notification service's own dedupeKey, so no second reminder ledger exists.
model CrmFollowUp {
  id                String            @id @default(uuid())
  consultingFirmId  String
  title             String
  notes             String?
  dueAt             DateTime
  status            CrmFollowUpStatus @default(OPEN)
  priority          CrmPriority       @default(MEDIUM)
  ownerUserId       String?
  completedAt       DateTime?
  completedByUserId String?

  governmentContactId String?
  partnerContactId    String?
  partnerId           String?
  opportunityId       String?
  bidPursuitId        String?
  activityId          String?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  consultingFirm    ConsultingFirm     @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  governmentContact GovernmentContact? @relation(fields: [governmentContactId], references: [id], onDelete: SetNull)
  partnerContact    PartnerContact?    @relation(fields: [partnerContactId], references: [id], onDelete: SetNull)
  partner           Partner?           @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  opportunity       Opportunity?       @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  bidPursuit        BidPursuit?        @relation(fields: [bidPursuitId], references: [id], onDelete: SetNull)
  activity          CrmActivity?       @relation(fields: [activityId], references: [id], onDelete: SetNull)
  owner             User?              @relation("CrmFollowUpOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([consultingFirmId, status, dueAt])
  @@index([consultingFirmId, ownerUserId, status])
  @@index([consultingFirmId, governmentContactId])
  @@index([consultingFirmId, partnerId])
  @@map("crm_follow_ups")
}

// =============================================================
// §8.2 — ERP completion: budget, resources, purchasing, subcontracts.
//
// Modelling decisions, so this never becomes a second ERP:
//
//  - NO new Contract, CLIN, timekeeping, invoice, funding, indirect-rate or
//    cash-flow system. Every one of those already exists and is reused.
//  - NO TaskOrder model. `Clin` already carries a self-referencing parent, its
//    own number, dates, funding and ceiling — everything a task order needs. It
//    gains a `clinLevel` discriminator instead, defaulted to CLIN so every
//    existing row and query keeps its current meaning.
//  - Budget is PLAN only. Actual stays exactly where it is: approved TimeEntry
//    plus approved ContractCost, via `recognizedExpenditure`.
//  - An approved subcontractor invoice posts ONE ContractCost row carrying its
//    source linkage, so actual cost has a single authoritative path and posting
//    is idempotent.
//  - AR and AP stay apart: ContractInvoice is money owed TO the firm;
//    SubcontractInvoice is money the firm OWES a vendor.
// =============================================================

enum ClinLevel {
  TASK_ORDER
  CLIN
  SUB_CLIN
}

enum BudgetStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
}

enum BudgetCategory {
  LABOR
  ODC
  SUBCONTRACT
  TRAVEL
  MATERIAL
  INDIRECT
  OTHER
}

enum AllocationStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PARTIALLY_RECEIVED
  COMPLETE
  CANCELLED
}

enum SubcontractInvoiceStatus {
  RECEIVED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PAID
}

/// Deliberately conservative. Nothing here asserts that a clause legally flows
/// down — that is a legal judgement and stays with a human reviewer.
enum FlowDownState {
  INSUFFICIENT_DATA
  REVIEW_REQUIRED
  APPLICABLE_CONFIRMED
  NOT_APPLICABLE_CONFIRMED
  INCLUDED
  NOT_INCLUDED
}

/// Where an authoritative ContractCost row came from. MANUAL is the historical
/// default so existing rows keep their meaning.
enum CostSourceType {
  MANUAL
  SUBCONTRACT_INVOICE
}

/// A versioned spend plan for one contract. Approved versions are never edited
/// in place — a revision supersedes them, so budget history stays as evidence.
model ContractBudget {
  id               String       @id @default(uuid())
  consultingFirmId String
  contractId       String
  versionNumber    Int
  status           BudgetStatus @default(DRAFT)
  title            String?
  notes            String?
  effectiveDate    DateTime?

  /// The version this one replaced, so a revision chain is auditable.
  supersedesBudgetId String?

  createdByUserId  String?
  approvedByUserId String?
  approvedAt       DateTime?
  supersededAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consultingFirm ConsultingFirm       @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  contract       Contract             @relation(fields: [contractId], references: [id], onDelete: Cascade)
  lines          ContractBudgetLine[]

  @@unique([contractId, versionNumber])
  @@index([consultingFirmId, contractId, status])
  @@map("contract_budgets")
}

/// One planned amount, at contract level or against a specific CLIN/task order.
model ContractBudgetLine {
  id               String         @id @default(uuid())
  consultingFirmId String
  budgetId         String
  clinId           String?
  category         BudgetCategory
  description      String?
  plannedAmount    Decimal        @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  budget ContractBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  clin   Clin?          @relation(fields: [clinId], references: [id], onDelete: SetNull)

  @@index([consultingFirmId, budgetId])
  @@index([budgetId, clinId, category])
  @@map("contract_budget_lines")
}

/// Planned staffing. TimeEntry records what happened; this records what is
/// intended, which is what remaining capacity needs.
model ResourceAllocation {
  id                  String           @id @default(uuid())
  consultingFirmId    String
  userId              String
  /// §8.3 — optional business identity. userId stays required so every existing
  /// row remains valid; new allocations may also resolve to a Personnel record.
  personnelId         String?
  contractId          String
  clinId              String?
  laborCategory       String?
  /// 0-100. Percentage of one person's working capacity on this contract.
  allocationPercent   Decimal          @db.Decimal(5, 2)
  plannedHoursPerWeek Decimal?         @db.Decimal(6, 2)
  startDate           DateTime
  endDate             DateTime?
  status              AllocationStatus @default(PLANNED)
  notes               String?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  consultingFirm ConsultingFirm @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  contract       Contract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  clin           Clin?          @relation(fields: [clinId], references: [id], onDelete: SetNull)
  user           User           @relation("ResourceAllocationUser", fields: [userId], references: [id], onDelete: Cascade)
  personnel      Personnel?     @relation(fields: [personnelId], references: [id], onDelete: SetNull)

  @@index([consultingFirmId, userId, startDate])
  @@index([consultingFirmId, contractId, status])
  @@map("resource_allocations")
}

/// A purchase order or subcontract issued under a federal contract.
/// An APPROVED order is a COMMITMENT — it reduces remaining budget without
/// being an incurred cost.
model PurchaseOrder {
  id                   String              @id @default(uuid())
  consultingFirmId     String
  contractId           String
  clinId               String?
  partnerId            String?
  /// Kept alongside partnerId so a one-off vendor needs no partner record.
  vendorName           String
  poNumber             String
  description          String?
  status               PurchaseOrderStatus @default(DRAFT)
  /// Not-to-exceed value. Line items are the evidence; this is the cap.
  ceilingAmount        Decimal             @db.Decimal(14, 2)
  startDate            DateTime?
  endDate              DateTime?
  isSubcontract        Boolean             @default(false)
  /// Provenance when a pre-award teaming arrangement became this subcontract.
  /// Referencing it never makes proposal workshare financially authoritative —
  /// a human still establishes the order.
  teamingArrangementId String?
  notes                String?

  createdByUserId  String?
  approvedByUserId String?
  approvedAt       DateTime?
  cancelledAt      DateTime?
  cancelReason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consultingFirm ConsultingFirm        @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  contract       Contract              @relation(fields: [contractId], references: [id], onDelete: Cascade)
  clin           Clin?                 @relation(fields: [clinId], references: [id], onDelete: SetNull)
  partner        Partner?              @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  lines          PurchaseOrderLine[]
  invoices       SubcontractInvoice[]
  flowDowns      SubcontractFlowDown[]

  @@unique([consultingFirmId, poNumber])
  @@index([consultingFirmId, contractId, status])
  @@index([consultingFirmId, partnerId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id               String         @id @default(uuid())
  consultingFirmId String
  purchaseOrderId  String
  clinId           String?
  description      String
  category         BudgetCategory @default(SUBCONTRACT)
  quantity         Decimal?       @db.Decimal(14, 4)
  unit             String?
  unitPrice        Decimal?       @db.Decimal(14, 4)
  amount           Decimal        @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  clin          Clin?         @relation(fields: [clinId], references: [id], onDelete: SetNull)

  @@index([consultingFirmId, purchaseOrderId])
  @@map("purchase_order_lines")
}

/// Vendor/subcontractor invoice — money the firm OWES. This is accounts
/// payable and is deliberately NOT the same model as ContractInvoice, which is
/// money owed TO the firm by the government customer.
model SubcontractInvoice {
  id                 String                   @id @default(uuid())
  consultingFirmId   String
  purchaseOrderId    String
  partnerId          String?
  vendorName         String
  invoiceNumber      String
  invoiceDate        DateTime
  servicePeriodStart DateTime?
  servicePeriodEnd   DateTime?
  amount             Decimal                  @db.Decimal(14, 2)
  status             SubcontractInvoiceStatus @default(RECEIVED)
  notes              String?
  rejectionReason    String?
  attachmentKey      String?

  /// The single ContractCost this invoice posted. Its presence is what makes
  /// posting idempotent — a re-approval can never create a second actual cost.
  postedContractCostId String?   @unique
  postedAt             DateTime?

  /// Human-recorded only. The platform never moves money.
  paymentRecordedAt       DateTime?
  paymentReference        String?
  paymentRecordedByUserId String?

  /// §8.3 — set when the subcontractor submitted it through the portal rather
  /// than a prime user recording it. Approval stays a prime human action.
  submittedByPortalUserId String?

  createdByUserId  String?
  approvedByUserId String?
  approvedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consultingFirm ConsultingFirm           @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  purchaseOrder  PurchaseOrder            @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  partner        Partner?                 @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  lines          SubcontractInvoiceLine[]

  @@unique([consultingFirmId, purchaseOrderId, invoiceNumber])
  @@index([consultingFirmId, status])
  @@map("subcontract_invoices")
}

model SubcontractInvoiceLine {
  id                   String         @id @default(uuid())
  consultingFirmId     String
  subcontractInvoiceId String
  clinId               String?
  description          String
  category             BudgetCategory @default(SUBCONTRACT)
  amount               Decimal        @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  subcontractInvoice SubcontractInvoice @relation(fields: [subcontractInvoiceId], references: [id], onDelete: Cascade)
  clin               Clin?              @relation(fields: [clinId], references: [id], onDelete: SetNull)

  @@index([consultingFirmId, subcontractInvoiceId])
  @@map("subcontract_invoice_lines")
}

/// Operational flow-down tracking for one subcontract. State is only ever set
/// by a human reviewer or derived conservatively from an existing, already
/// human-reviewed ClauseObligation — never inferred by a model.
model SubcontractFlowDown {
  id                 String        @id @default(uuid())
  consultingFirmId   String
  purchaseOrderId    String
  /// Links to the existing extracted clause record when one exists.
  clauseObligationId String?
  clauseNumber       String
  clauseTitle        String?
  state              FlowDownState @default(INSUFFICIENT_DATA)
  /// Why the state is what it is, in words, for audit.
  evidence           String?
  notes              String?

  /// §8.3 — shared with the subcontractor through the portal. Visibility and
  /// acknowledgment are separate from legal state, which stays with the prime.
  partnerVisible                    Boolean   @default(false)
  partnerAcknowledgedAt             DateTime?
  partnerAcknowledgedByPortalUserId String?

  reviewedByUserId String?
  reviewedAt       DateTime?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  consultingFirm   ConsultingFirm    @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  purchaseOrder    PurchaseOrder     @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  clauseObligation ClauseObligation? @relation(fields: [clauseObligationId], references: [id], onDelete: SetNull)

  @@unique([purchaseOrderId, clauseNumber])
  @@index([consultingFirmId, purchaseOrderId])
  @@map("subcontract_flow_downs")
}

// =============================================================
// §8.3 — Personnel & resume library, knowledge layer, partner portal.
//
// Modelling decisions, so none of this becomes a parallel system:
//
//  - `User` stays the AUTHENTICATION identity. `Personnel` is the BUSINESS
//    identity — the person a firm proposes, allocates and writes resumes for.
//    The link is optional in both directions: not every employee needs a login,
//    proposed key personnel are often consultants or subcontractor staff, and a
//    personnel record must survive its account being disabled.
//  - `ResourceAllocation` keeps its required `userId` and gains an OPTIONAL
//    `personnelId`. Existing rows stay valid; no data is migrated on a guess.
//  - Resumes are versioned like every other approved artefact in this platform.
//    An approved version is never edited in place.
//  - Partner portal users are a SEPARATE external identity, patterned on
//    ClientPortalUser. They are never internal `User` rows and never reuse the
//    CONSULTANT role, which is an internal read-only identity.
//  - Access is default-deny: a partner user sees an engagement only through an
//    explicit, human-granted, revocable access row.
//  - Deliverables, purchase orders, subcontract invoices and flow-downs are the
//    EXISTING ERP models. The portal reads and writes through them.
// =============================================================

enum PersonnelEmploymentType {
  EMPLOYEE
  CONTRACTOR
  CONSULTANT
  SUBCONTRACTOR_STAFF
  PROSPECTIVE
}

enum QualificationVerification {
  UNVERIFIED
  VERIFIED
  REJECTED
}

enum ResumeStatus {
  DRAFT
  APPROVED
  SUPERSEDED
  ARCHIVED
}

/// Where a personnel record or resume came from. PARTNER_SUBMITTED evidence is
/// never silently trusted as the prime's own.
enum PersonnelSource {
  INTERNAL
  PARTNER_SUBMITTED
  IMPORTED_FROM_USER
}

enum PartnerEngagementScope {
  OPPORTUNITY
  TEAMING_ARRANGEMENT
  CONTRACT
  PURCHASE_ORDER
}

enum PartnerSubmissionStatus {
  PENDING_REVIEW
  ACCEPTED
  REJECTED
}

/// A person the firm may employ, propose, allocate or write a resume for.
model Personnel {
  id               String                  @id @default(uuid())
  consultingFirmId String
  /// Optional link to an application account. Optional in both directions.
  userId           String?
  firstName        String
  lastName         String
  jobTitle         String?
  employmentType   PersonnelEmploymentType @default(EMPLOYEE)
  email            String?
  phone            String?
  location         String?
  summary          String?
  /// Only ever what a human entered. Never inferred from a title or a resume.
  yearsExperience  Int?
  source           PersonnelSource         @default(INTERNAL)
  /// Set when this record originated from a partner submission, so the evidence
  /// keeps its provenance after review.
  sourcePartnerId  String?
  isActive         Boolean                 @default(true)
  isArchived       Boolean                 @default(false)
  notes            String?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  consultingFirm ConsultingFirm                @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  user           User?                         @relation("PersonnelAccount", fields: [userId], references: [id], onDelete: SetNull)
  sourcePartner  Partner?                      @relation(fields: [sourcePartnerId], references: [id], onDelete: SetNull)
  qualifications PersonnelLaborQualification[]
  resumes        PersonnelResume[]
  proposalUses   ProposalKeyPersonnel[]
  allocations    ResourceAllocation[]

  @@index([consultingFirmId, isArchived])
  @@index([consultingFirmId, userId])
  @@index([consultingFirmId, lastName])
  @@map("personnel")
}

/// A labour category a person is qualified for. Qualification is established by
/// a human — it is never inferred from a job title resembling a category name.
model PersonnelLaborQualification {
  id               String                    @id @default(uuid())
  consultingFirmId String
  personnelId      String
  laborCategory    String
  effectiveDate    DateTime?
  expirationDate   DateTime?
  verification     QualificationVerification @default(UNVERIFIED)
  /// Only what a human entered for THIS category.
  yearsExperience  Int?
  evidence         String?
  notes            String?

  verifiedByUserId String?
  verifiedAt       DateTime?
  createdByUserId  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  personnel Personnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)

  @@unique([personnelId, laborCategory])
  @@index([consultingFirmId, laborCategory])
  @@map("personnel_labor_qualifications")
}

/// A versioned resume. Structured content is the primary form so a proposal can
/// reuse it; an uploaded file is optional supporting evidence, not the record.
model PersonnelResume {
  id                        String          @id @default(uuid())
  consultingFirmId          String
  personnelId               String
  versionNumber             Int
  status                    ResumeStatus    @default(DRAFT)
  title                     String?
  /// Structured, reusable content: summary, skills, experience, education,
  /// certifications, clearances, projects. Kept as one document rather than a
  /// dozen tiny tables — it is read and written whole.
  content                   Json            @default("{}")
  fileName                  String?
  fileType                  String?
  fileSize                  Int?
  storageKey                String?
  source                    PersonnelSource @default(INTERNAL)
  supersedesResumeId        String?
  /// Provenance for a resume promoted from a partner submission. Kept on the
  /// version, not the person, because a later internal version is not partner
  /// evidence and must not inherit the claim.
  sourcePartnerId           String?
  sourcePartnerSubmissionId String?
  sourcePartnerUploadId     String?

  createdByUserId  String?
  approvedByUserId String?
  approvedAt       DateTime?
  supersededAt     DateTime?
  archivedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  personnel    Personnel              @relation(fields: [personnelId], references: [id], onDelete: Cascade)
  proposalUses ProposalKeyPersonnel[]

  @@unique([personnelId, versionNumber])
  @@index([consultingFirmId, personnelId, status])
  @@map("personnel_resumes")
}

/// Key personnel selected for a proposal. Holds a snapshot for the record while
/// keeping provenance back to the live Personnel and the exact resume version,
/// so the source can never silently diverge from what was submitted.
model ProposalKeyPersonnel {
  id               String  @id @default(uuid())
  consultingFirmId String
  proposalId       String
  personnelId      String
  resumeId         String?
  proposalRole     String?
  laborCategory    String?
  /// What was used at selection time. Adaptation for a solicitation lives here;
  /// the source resume stays immutable.
  snapshot         Json    @default("{}")
  notes            String?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  proposal  Proposal         @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  personnel Personnel        @relation(fields: [personnelId], references: [id], onDelete: Cascade)
  resume    PersonnelResume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  @@unique([proposalId, personnelId])
  @@index([consultingFirmId, proposalId])
  @@map("proposal_key_personnel")
}

/// External partner/subcontractor login. Never an internal User, never the
/// CONSULTANT role. Patterned on ClientPortalUser.
model PartnerPortalUser {
  id               String    @id @default(uuid())
  consultingFirmId String
  partnerId        String
  partnerContactId String?
  email            String
  passwordHash     String?
  firstName        String
  lastName         String
  isActive         Boolean   @default(true)
  /// Single-use invite. Hashed, never stored in the clear.
  inviteTokenHash  String?
  inviteExpiresAt  DateTime?
  invitedAt        DateTime?
  invitedByUserId  String?
  acceptedAt       DateTime?
  lastLoginAt      DateTime?
  revokedAt        DateTime?
  revokedByUserId  String?

  /// Optional TOTP second factor. Same otpauth library, same encrypted-at-rest
  /// handling and same bcrypt-hashed recovery codes as an internal account.
  mfaEnabled       Boolean   @default(false)
  mfaSecret        String?
  mfaRecoveryCodes String[]  @default([])
  mfaEnrolledAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consultingFirm        ConsultingFirm                 @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  partner               Partner                        @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerContact        PartnerContact?                @relation(fields: [partnerContactId], references: [id], onDelete: SetNull)
  access                PartnerEngagementAccess[]
  uploads               PartnerPortalUpload[]
  submissions           PartnerPersonnelSubmission[]
  passwordResets        PartnerPortalPasswordReset[]
  deliverableSubmission PartnerDeliverableSubmission[]
  profileChangeRequests PartnerProfileChangeRequest[]

  @@unique([consultingFirmId, email])
  @@index([consultingFirmId, partnerId])
  @@map("partner_portal_users")
}

/// Explicit, human-granted, revocable access to ONE engagement. Default-deny:
/// belonging to the partner company grants nothing on its own.
model PartnerEngagementAccess {
  id                  String                 @id @default(uuid())
  consultingFirmId    String
  partnerPortalUserId String
  scopeType           PartnerEngagementScope
  /// Id of the opportunity, teaming arrangement, contract or purchase order.
  scopeId             String
  notes               String?

  grantedByUserId String
  grantedAt       DateTime  @default(now())
  revokedAt       DateTime?
  revokedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  portalUser PartnerPortalUser @relation(fields: [partnerPortalUserId], references: [id], onDelete: Cascade)

  @@unique([partnerPortalUserId, scopeType, scopeId])
  @@index([consultingFirmId, scopeType, scopeId])
  @@map("partner_engagement_access")
}

/// A document a partner uploaded through the portal. Mirrors ClientPortalUpload
/// and is always tied to the engagement it was provided for.
model PartnerPortalUpload {
  id                  String                 @id @default(uuid())
  consultingFirmId    String
  partnerId           String
  partnerPortalUserId String
  scopeType           PartnerEngagementScope
  scopeId             String
  category            String
  title               String
  fileName            String
  fileType            String
  fileSize            Int                    @default(0)
  storageKey          String
  notes               String?

  reviewStatus     PartnerSubmissionStatus @default(PENDING_REVIEW)
  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewNotes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consultingFirm ConsultingFirm    @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  partner        Partner           @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  portalUser     PartnerPortalUser @relation(fields: [partnerPortalUserId], references: [id], onDelete: Cascade)

  @@index([consultingFirmId, partnerId])
  @@index([consultingFirmId, scopeType, scopeId])
  @@map("partner_portal_uploads")
}

/// Personnel a partner offered for an engagement. It lands as evidence pending
/// review and is NEVER merged into the prime's approved library automatically.
model PartnerPersonnelSubmission {
  id                  String                 @id @default(uuid())
  consultingFirmId    String
  partnerId           String
  partnerPortalUserId String
  scopeType           PartnerEngagementScope
  scopeId             String
  fullName            String
  proposedRole        String?
  laborCategory       String?
  /// Same structured shape as a resume, so an accepted submission can be
  /// promoted without reshaping it.
  content             Json                   @default("{}")
  fileName            String?
  storageKey          String?
  /// The portal upload carrying this person's resume file, when one was
  /// attached. Referencing the upload rather than copying its bytes keeps one
  /// record of what the partner actually sent.
  sourceUploadId      String?

  status              PartnerSubmissionStatus @default(PENDING_REVIEW)
  reviewedByUserId    String?
  reviewedAt          DateTime?
  reviewNotes         String?
  /// Set when a human promoted this submission into the personnel library.
  importedPersonnelId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consultingFirm ConsultingFirm    @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  partner        Partner           @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  portalUser     PartnerPortalUser @relation(fields: [partnerPortalUserId], references: [id], onDelete: Cascade)

  @@index([consultingFirmId, partnerId, status])
  @@map("partner_personnel_submissions")
}

//////////////////////////////////////////////////////////////
// §8.4 — PARTNER PORTAL COMPLETION
//
// Password reset, MFA, deliverable submission and profile change review.
// Each is a separate external-facing record so an external actor never writes
// a prime-trusted field directly.
//////////////////////////////////////////////////////////////

/// Single-use partner-portal password reset. Only the SHA-256 hash of the
/// token is stored, so a database read cannot be replayed as a reset link.
/// Deliberately NOT the internal `PasswordResetToken`, which stores its token
/// in the clear and is keyed to an internal `User`.
model PartnerPortalPasswordReset {
  id                  String    @id @default(uuid())
  consultingFirmId    String
  partnerPortalUserId String
  tokenHash           String    @unique
  expiresAt           DateTime
  usedAt              DateTime?
  createdAt           DateTime  @default(now())

  portalUser PartnerPortalUser @relation(fields: [partnerPortalUserId], references: [id], onDelete: Cascade)

  @@index([partnerPortalUserId])
  @@index([expiresAt])
  @@map("partner_portal_password_resets")
}

enum PartnerDeliverableSubmissionStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  ACCEPTED_BY_PRIME
}

/// A partner's response to a deliverable that a prime human attributed to it.
///
/// A child of `ContractDeliverable` rather than a second deliverable system:
/// the deliverable keeps its own official status, due date and government
/// acceptance, and none of those is writable from the portal. Accepting a
/// submission is a prime-only transition.
model PartnerDeliverableSubmission {
  id                  String                             @id @default(uuid())
  consultingFirmId    String
  deliverableId       String
  partnerId           String
  partnerPortalUserId String
  status              PartnerDeliverableSubmissionStatus @default(DRAFT)
  note                String?
  fileName            String?
  fileType            String?
  fileSize            Int?
  storageKey          String?
  submittedAt         DateTime?

  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewNotes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliverable ContractDeliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  partner     Partner             @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  portalUser  PartnerPortalUser   @relation(fields: [partnerPortalUserId], references: [id], onDelete: Cascade)

  @@index([consultingFirmId, deliverableId])
  @@index([consultingFirmId, partnerId, status])
  @@map("partner_deliverable_submissions")
}

/// A proposed edit to the partner's own contact-facing profile.
///
/// Applied to `Partner` / `PartnerContact` only after a prime ADMIN approves,
/// and only for the small allowlist of fields the portal may propose. Prime
/// performance notes, relationship scoring and internal ratings are not
/// representable here.
model PartnerProfileChangeRequest {
  id                  String                  @id @default(uuid())
  consultingFirmId    String
  partnerId           String
  partnerPortalUserId String
  /// Allowlisted safe fields only — see partnerProfile.ts.
  proposed            Json                    @default("{}")
  /// The values held at submission time, for the reviewer's comparison.
  previous            Json                    @default("{}")
  status              PartnerSubmissionStatus @default(PENDING_REVIEW)
  submittedNote       String?

  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewNotes      String?
  appliedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner    Partner           @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  portalUser PartnerPortalUser @relation(fields: [partnerPortalUserId], references: [id], onDelete: Cascade)

  @@index([consultingFirmId, partnerId, status])
  @@map("partner_profile_change_requests")
}

//////////////////////////////////////////////////////////////
// §8.4 — PUBLIC API v1
//
// The public REST API reuses the existing `api_tokens` substrate rather than
// minting a second credential system. `kind` keeps the two delivery interfaces
// distinct: rows default to MCP, so every pre-existing token keeps exactly the
// behaviour it had, and a PUBLIC_API token is refused by the MCP resolver.
//////////////////////////////////////////////////////////////

enum ApiTokenKind {
  MCP
  PUBLIC_API
}

/// One row per public-API request. Separate from `ApiUsageLog`, which is the
/// LLM provider/token/cost ledger and has nothing to say about HTTP requests,
/// and from `McpAuditLog`, which is keyed to MCP servers and tool invocations.
model PublicApiRequestLog {
  id               String   @id @default(uuid())
  consultingFirmId String
  apiTokenId       String
  /// First 16 hex chars of the token hash — the only token artifact ever stored.
  tokenFp          String
  method           String
  /// The matched route pattern, never the raw URL, so ids stay out of the log.
  route            String
  statusCode       Int
  durationMs       Int      @default(0)
  scopeUsed        String?
  outcome          String   @default("ok")
  createdAt        DateTime @default(now())

  @@index([consultingFirmId, createdAt])
  @@index([apiTokenId, createdAt])
  @@map("public_api_request_logs")
}

//////////////////////////////////////////////////////////////
// §8.5 — ENTERPRISE INTEGRATIONS
//
// ONE tenant-scoped connection model for every external provider, rather than
// one table per vendor. A provider is a row, not a schema. Secrets are
// encrypted at rest with the existing fieldCrypto and are never returned to a
// client after storage.
//
// The internal ERP stays authoritative. An external accounting product is an
// integration, not the source of truth for Bytescon operational state.
//////////////////////////////////////////////////////////////

enum IntegrationCategory {
  ACCOUNTING
  CALENDAR
  CHAT
  ESIGNATURE
}

enum IntegrationProvider {
  QUICKBOOKS
  UNANET
  DELTEK
  GOOGLE_CALENDAR
  MICROSOFT_CALENDAR
  SLACK
  MICROSOFT_TEAMS
  DOCUSIGN
}

enum IntegrationStatus {
  /// A row exists but no credential has ever been supplied.
  NOT_CONFIGURED
  /// The platform has no server-side credential for this provider, so the
  /// tenant cannot begin a connection at all. Displayed honestly rather than
  /// as "not connected".
  CREDENTIAL_REQUIRED
  /// An authorization is in flight.
  PENDING
  /// Connected and last verified successfully.
  CONNECTED
  /// Connected, but the last operation failed.
  ERROR
  /// The stored credential no longer authenticates.
  EXPIRED
  DISCONNECTED
}

/// One provider connection per tenant. Tokens are stored encrypted and are
/// never selected into any response DTO.
model IntegrationConnection {
  id               String              @id @default(uuid())
  consultingFirmId String
  provider         IntegrationProvider
  category         IntegrationCategory
  status           IntegrationStatus   @default(NOT_CONFIGURED)

  /// The provider's own account/company/team identifier, for display and for
  /// routing an inbound webhook back to this tenant.
  externalAccountId   String?
  externalAccountName String?

  /// Encrypted at rest. Never returned to a client, never logged, never
  /// written to an audit row.
  accessTokenEnc  String?
  refreshTokenEnc String?
  tokenExpiresAt  DateTime?
  /// Scopes the provider actually granted, as reported by the provider.
  grantedScopes   String[]  @default([])

  /// Non-secret provider configuration (channel id, calendar id, base URL).
  config Json @default("{}")

  connectedAt          DateTime?
  connectedByUserId    String?
  lastSyncAt           DateTime?
  lastSuccessfulSyncAt DateTime?
  lastError            String?
  lastErrorAt          DateTime?
  /// Consecutive failures, for bounded retry and backoff.
  consecutiveFailures  Int       @default(0)
  disconnectedAt       DateTime?
  disconnectedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consultingFirm ConsultingFirm          @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  syncRecords    IntegrationSyncRecord[]
  events         IntegrationEvent[]

  @@unique([consultingFirmId, provider])
  @@index([consultingFirmId, category])
  @@index([provider, externalAccountId])
  @@map("integration_connections")
}

/// Single-use, tenant- and user-bound OAuth state. The callback proves it holds
/// a state this server minted for this tenant; nothing in the callback body is
/// trusted as authority.
model IntegrationOAuthState {
  id               String              @id @default(uuid())
  consultingFirmId String
  userId           String
  provider         IntegrationProvider
  /// SHA-256 of the state value. The raw state exists only in the redirect.
  stateHash        String              @unique
  /// SHA-256 of the PKCE verifier where the provider supports PKCE.
  codeVerifierEnc  String?
  redirectUri      String
  expiresAt        DateTime
  consumedAt       DateTime?
  createdAt        DateTime            @default(now())

  @@index([consultingFirmId, provider])
  @@index([expiresAt])
  @@map("integration_oauth_states")
}

/// The idempotency ledger. One row per (connection, local record), carrying the
/// external id the provider assigned. A repeated sync updates this row; it
/// never creates a second external object, and an inbound event resolves back
/// to exactly one local record through it.
model IntegrationSyncRecord {
  id               String    @id @default(uuid())
  connectionId     String
  consultingFirmId String
  /// The Bytescon model name, e.g. ContractInvoice, OpportunityMilestone.
  localType        String
  localId          String
  externalId       String
  externalType     String?
  /// EXPORT (Bytescon → provider) or IMPORT (provider → Bytescon).
  direction        String    @default("EXPORT")
  /// Hash of the payload last sent, so an unchanged record is not re-sent.
  payloadHash      String?
  lastSyncedAt     DateTime?
  lastError        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, localType, localId])
  @@unique([connectionId, externalId])
  @@index([consultingFirmId, localType])
  @@map("integration_sync_records")
}

/// Inbound provider events, deduped on the provider's own event id. A repeated
/// webhook has the same operational effect exactly once.
model IntegrationEvent {
  id               String              @id @default(uuid())
  consultingFirmId String
  connectionId     String?
  provider         IntegrationProvider
  externalEventId  String
  eventType        String
  /// Non-secret event envelope, for replay and diagnosis.
  payload          Json                @default("{}")
  processedAt      DateTime?
  outcome          String              @default("received")
  error            String?
  createdAt        DateTime            @default(now())

  connection IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@unique([provider, externalEventId])
  @@index([consultingFirmId, createdAt])
  @@map("integration_events")
}

//////////////////////////////////////////////////////////////
// §8.5 — E-SIGNATURE
//
// A provider integration layer over the agreement records that already exist.
// It is NOT a second agreement engine: the document text still comes from
// TeamingAgreementDraft or an uploaded file, and the signature request only
// tracks what a provider did with it.
//////////////////////////////////////////////////////////////

enum SignatureRequestStatus {
  DRAFT
  READY_TO_SEND
  SENT
  VIEWED
  PARTIALLY_SIGNED
  COMPLETED
  DECLINED
  VOIDED
  ERROR
}

enum SignatureDocumentType {
  NDA
  TEAMING_AGREEMENT
  SUBCONTRACT
  OTHER
}

model SignatureRequest {
  id               String                 @id @default(uuid())
  consultingFirmId String
  documentType     SignatureDocumentType
  status           SignatureRequestStatus @default(DRAFT)

  title                String
  /// Where the document came from. Provenance is kept so a completed envelope
  /// can always be traced to the exact draft version or file that was sent.
  sourceType           String?
  sourceId             String?
  /// Optional links to the records the agreement is about.
  teamingArrangementId String?
  partnerId            String?
  purchaseOrderId      String?

  fileName   String?
  fileType   String?
  storageKey String?

  /// The provider that carried it, and its own envelope identifier.
  provider           IntegrationProvider?
  externalEnvelopeId String?
  /// The provider's raw status string, preserved alongside the canonical one.
  providerStatus     String?

  /// Sending is a human act. These record which human, and when.
  sentByUserId  String?
  sentAt        DateTime?
  completedAt   DateTime?
  declinedAt    DateTime?
  voidedAt      DateTime?
  declineReason String?
  lastError     String?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  consultingFirm ConsultingFirm    @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  signers        SignatureSigner[]

  @@unique([provider, externalEnvelopeId])
  @@index([consultingFirmId, status])
  @@index([consultingFirmId, documentType])
  @@map("signature_requests")
}

model SignatureSigner {
  id                 String    @id @default(uuid())
  consultingFirmId   String
  signatureRequestId String
  name               String
  email              String
  /// Order for sequential signing, where the provider supports it.
  routingOrder       Int       @default(1)
  role               String?
  status             String    @default("PENDING")
  viewedAt           DateTime?
  signedAt           DateTime?
  declinedAt         DateTime?
  /// The provider's identifier for this recipient.
  externalSignerId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  signatureRequest SignatureRequest @relation(fields: [signatureRequestId], references: [id], onDelete: Cascade)

  @@index([signatureRequestId])
  @@map("signature_signers")
}

//////////////////////////////////////////////////////////////
// §8.5 — ENTERPRISE SSO
//
// Workforce single sign-on for INTERNAL users only. Deliberately unrelated to
// the MCP OAuth server, which authorizes API clients rather than employees,
// and unrelated to the client and partner portals, which are separate
// identities and stay that way.
//
// There is no second user table: a successful SSO login resolves to an
// existing `User` (or provisions one, when the tenant has explicitly allowed
// it) and then mints the ordinary internal session.
//////////////////////////////////////////////////////////////

enum SsoProviderType {
  OIDC
  SAML
}

model FirmSsoConfig {
  id               String          @id @default(uuid())
  consultingFirmId String          @unique
  providerType     SsoProviderType @default(OIDC)
  displayName      String          @default("Single sign-on")
  enabled          Boolean         @default(false)

  /// OIDC
  issuer             String?
  clientId           String?
  clientSecretEnc    String?
  authorizationUrl   String?
  tokenUrl           String?
  jwksUri            String?
  /// SAML
  entryPoint         String?
  /// The IdP's signing certificate (public; not a secret, but not returned in list DTOs).
  signingCertificate String?

  /// Only these email domains may authenticate into this tenant. Empty means
  /// the tenant has not restricted them, which is checked at review time.
  allowedEmailDomains String[] @default([])

  /// When true, password login is refused for this tenant's members except the
  /// break-glass accounts.
  enforced         Boolean  @default(false)
  /// Emails that may always use a password, so a misconfigured IdP cannot lock
  /// a firm out of its own tenant.
  breakGlassEmails String[] @default([])

  /// Provision a User on first successful login, rather than refusing.
  autoProvision Boolean @default(false)
  /// The role a provisioned user receives. Never ADMIN by default.
  defaultRole   String  @default("VIEWER")

  lastLoginAt     DateTime?
  lastError       String?
  updatedByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  consultingFirm ConsultingFirm @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)
  identities     SsoIdentity[]

  @@map("firm_sso_configs")
}

/// The binding between an IdP subject and an internal user.
///
/// Linking is on (issuer, subject), never on an email alone: an email is a
/// claim any IdP can assert, and trusting it would let one identity provider
/// authenticate as a user who belongs to another.
model SsoIdentity {
  id               String    @id @default(uuid())
  consultingFirmId String
  ssoConfigId      String
  userId           String
  issuer           String
  subject          String
  email            String?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  ssoConfig FirmSsoConfig @relation(fields: [ssoConfigId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, subject])
  @@unique([ssoConfigId, userId])
  @@index([consultingFirmId])
  @@map("sso_identities")
}

/// Single-use login state. Carries the nonce the ID token must echo and the
/// tenant the flow started for, so neither can be supplied by the callback.
model SsoLoginState {
  id               String    @id @default(uuid())
  consultingFirmId String
  stateHash        String    @unique
  nonce            String
  codeVerifierEnc  String?
  redirectUri      String
  returnTo         String?
  expiresAt        DateTime
  consumedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([expiresAt])
  @@map("sso_login_states")
}
