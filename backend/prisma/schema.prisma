// =============================================================
// SubcontractContact — perpetual, tenant-scoped POC directory.
//
// Subcontracting opportunities are purged 7 days after their deadline
// (see workers/subcontractMaintenanceWorker.ts), but the point-of-contact
// behind each one is durable teaming intelligence we want to keep and
// reference later. Every opportunity that carries a POC is upserted here
// (deduped per tenant by `dedupeKey`) so the contact survives opportunity
// cleanup. Operator-facing + internal analytics only — NOT exposed on the
// client portal. Designed for aging cleanup: firstSeenAt/lastSeenAt/
// timesSeen/hasValidEmail + an indexed lastSeenAt let pruneContacts()
// drop junk immediately and stale low-value rows on demand.
// =============================================================
model SubcontractContact {
  id                   String   @id @default(cuid())
  consultingFirmId     String
  primeContractor      String
  primeContractorUei   String?
  contactName          String?
  contactEmail         String?
  contactPhone         String?
  agency               String?
  naicsCode            String?
  setAside             String?
  sourceUrl            String?
  // Where this sighting came from: 'sba_subnet' | 'sam_setaside' | 'manual'
  // | a published-directory key such as 'dla_captains_of_industry'. Follows
  // the same latest-non-null-wins merge as the other fields, so a contact
  // seen through several channels reports the most recent one; `sourceUrl`
  // and `firstSeenAt` preserve the rest of the trail. Null on rows captured
  // before provenance tracking existed.
  source               String?
  // Normalized identity used for per-tenant dedup: lowercased email when
  // present, else a "prime|name" slug. See services/scw/subcontractContacts.ts.
  dedupeKey            String
  firstSeenAt          DateTime @default(now())
  lastSeenAt           DateTime @default(now())
  timesSeen            Int      @default(1)
  hasValidEmail        Boolean  @default(false)
  // Loose reference to the most recent originating opportunity. Intentionally
  // NOT a foreign key so the contact outlives the opportunity it came from.
  lastOpportunityId    String?
  lastOpportunityTitle String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  consultingFirm ConsultingFirm @relation(fields: [consultingFirmId], references: [id], onDelete: Cascade)

  @@unique([consultingFirmId, dedupeKey])
  @@index([consultingFirmId, lastSeenAt])
  @@index([consultingFirmId, source])
  @@index([primeContractor])
  @@index([agency])
  @@index([naicsCode])
  @@map("subcontract_contacts")
}

