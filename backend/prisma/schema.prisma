model CapabilityGapAssessment {
  id               String @id @default(uuid())
  consultingFirmId String
  opportunityId    String @unique

  confirmedCoverage     String[] @default([])
  partialCoverage       String[] @default([])
  missingCapabilities   String[] @default([])
  missingCertifications String[] @default([])
  missingEligibility    String[] @default([])
  capacityGaps          String[] @default([])
  geographyGaps         String[] @default([])
  vehicleGaps           String[] @default([])

