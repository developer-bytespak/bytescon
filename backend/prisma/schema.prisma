//////////////////////////////////////////////////////////////
// HISTORICAL MODEL BACKTEST (admin-only, not tenant-scoped)
//////////////////////////////////////////////////////////////

model BacktestRun {
  id               String    @id @default(uuid())
  consultingFirmId String // audit only — who ran it
  triggeredBy      String? // userId who initiated
  status           String // 'RUNNING' | 'COMPLETE' | 'FAILED'
  sampleSize       Int
  yearsBack        Int
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  errorMessage     String?

  // Methodology — 'v1-synthetic' (mutated profiles) or 'v2-permutation' (real-profile cross-pairs).
  // v2 is the default for new runs; v1 retained so historical runs stay comparable.
  methodVersion String    @default("v2-permutation")
  cutoffDate    DateTime? // Phase 1d: evaluate only awards after this date

  // Aggregate metrics (set on completion)
  predictionCount Int?
  brierScore      Float? // 0 = perfect, 0.25 = random, lower better
  meanProbability Float? // average predicted probability across winners
  calibrationBins Json? // [{ binMin, binMax, count, meanPred, observedRate }]
  factorMeans     Json? // mean value per ProbabilityFeatures key

  // Phase 1c metrics
  logLoss          Float? // cross-entropy: 0 = perfect, ln(2)≈0.69 = random
  rocAuc           Float? // ROC AUC: 0.5 = random, 1.0 = perfect
  ece              Float? // Expected Calibration Error (10-bin)
  brierReliability Float? // Brier decomp: how miscalibrated (lower is better)
  brierResolution  Float? // Brier decomp: how much signal (higher is better)
  brierUncertainty Float? // Brier decomp: base-rate variance

  // Phase 2 — calibration curves fit on this run's predictions.
  // Both are fit for every v2-permutation run; CALIBRATION_METHOD env var selects which is applied.

  // Isotonic (PAV) — monotonic step function, non-parametric.
  // Shape: { xs: number[], ys: number[], fittedAt: ISO, sampleSize, preBrier, postBrier }.
  calibrationCurve Json?

  // Platt scaling — parametric sigmoid: P = σ(A·logit(raw) + B).
  plattA         Float? // scale parameter
  plattB         Float? // bias parameter
  plattPreBrier  Float? // Brier before Platt (same as isotonic preBrier)
  plattPostBrier Float? // Brier after Platt (compare to isotonic postBrier)

  predictions BacktestPrediction[]

  @@map("backtest_runs")
}

