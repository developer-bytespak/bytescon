# Local test default for "npm test" in backend/.
#
# This file is loaded by vitest (see vitest.config.ts setupFiles and
# src/test-utils/loadTestEnv.ts) with dotenv override DISABLED, so an
# already exported DATABASE_URL always takes precedence. CI exports
# DATABASE_URL=...bytescon_platform_test before running the suite, so on
# CI this value is ignored and the CI database wins. On a dev machine
# with the local Postgres up but no DATABASE_URL exported, this default
# points the suite at an ISOLATED bytescon_platform_test database — NEVER the
# live/dev bytescon_platform DB. (A prior run against bytescon_platform overwrote
# the live legal/ToS versions with test rows; keep the test DB separate.)
#
# Only the well-known local dev DB string lives here, no real secrets.
DATABASE_URL=postgresql://bytescon_user:bytescon_pass@localhost:5432/bytescon_platform_test
