# =============================================================
# opportunity-mcp v0.1 — environment variables
# =============================================================
# Copy this file to .env and fill values. Never commit .env.
# CLAUDE.md §6.1: no fallback defaults in code for any sensitive value.

# Postgres connection string for the shared Gov BANKV database.
# Must point at the same DB the backend uses; MCP reads opportunities
# and writes mcp_audit_log rows there.
DATABASE_URL=postgresql://govcon_user:govcon_pass@localhost:5432/govcon_platform

# Bearer token for this MCP server instance.
# Must exist as a row in the api_tokens table (matched by SHA-256 hash).
# Mint via scripts/mint-mcp-token.ts (Phase 1.5) or directly via SQL for v0.1.
# Token must resolve to exactly one tenant (consultingFirmId).
BANKV_MCP_TOKEN=

# Log level. Defaults to "info". Use "debug" only when diagnosing.
# All logs are emitted as JSON to stderr (stdout is reserved for the
# MCP protocol transport in stdio mode).
MCP_LOG_LEVEL=info

# -------------------------------------------------------------
# HTTP transport (server-http.js) — only used in HTTP mode.
# -------------------------------------------------------------
# Port the HTTP/SSE server binds. Defaults to 3002. Caddy reverse-proxies
# /mcp (and the OAuth endpoints) to this port.
MCP_HTTP_PORT=3002

# -------------------------------------------------------------
# Embedded OAuth 2.1 authorization server (HTTP transport only).
# See OAUTH.md. OAuth is OFF unless MCP_OAUTH_SIGNING_KEY is set to a
# secret of at least 32 characters; below that length the HTTP server
# accepts raw Bearer api_tokens only, exactly as in v0.3.
# -------------------------------------------------------------
# HMAC signing secret. The server hashes this to a 32-byte key used to sign
# the stateless OAuth client_ids, authorization codes, access tokens, and
# refresh tokens. Generate with: openssl rand -base64 48
# Treat as a high-value secret: rotating it invalidates every outstanding
# OAuth token (raw api_tokens are unaffected). Leave blank to disable OAuth.
MCP_OAUTH_SIGNING_KEY=

# Canonical public origin (no trailing slash), e.g. https://mrgovcon.co.
# Used to build the issuer / resource / endpoint URLs and the access-token
# audience, independent of the inbound Host header. REQUIRED in production
# when OAuth is enabled (startup fails fast if blank with NODE_ENV=production);
# when blank in local/dev the URLs are derived from the (trusted) request host.
MCP_PUBLIC_BASE_URL=

# Comma-separated external https redirect hosts allowed to register OAuth
# clients (exact host or subdomain; `*` = any host). Closes the open
# dynamic-client-registration phishing surface. Loopback http (localhost,
# 127.0.0.1, ::1) is always allowed. Empty = permissive (any https host) with a
# per-registration warning; the consent page always shows the redirect host.
MCP_OAUTH_REDIRECT_ALLOWLIST=claude.ai,claude.com,anthropic.com,chatgpt.com,openai.com,perplexity.ai,google.com,antigravity.google

# NODE_ENV controls Prisma client global caching. Use "production" on the droplet.
NODE_ENV=development
