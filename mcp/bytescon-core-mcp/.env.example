# =============================================================
# bankv-core-mcp v0.1.0, environment variables
# =============================================================
# Copy this file to .env and fill values. Never commit .env.
# CLAUDE.md section 6.1: no fallback defaults in code for any sensitive value.

# Postgres connection string for the shared Gov BANKV database.
# Must point at the same DB the backend uses; this server reads tenant
# core data (deliverables, billing, usage, users) and writes mcp_audit_log rows.
DATABASE_URL=postgresql://govcon_user:govcon_pass@localhost:5432/govcon_platform

# Bearer token for this MCP server instance.
# Must exist as a row in the api_tokens table (matched by SHA-256 hash)
# and must have tier PRO or VAULT; the server refuses to boot on CORE.
# Token must resolve to exactly one tenant (consultingFirmId).
BANKV_MCP_TOKEN=

# Log level. Defaults to "info". Use "debug" only when diagnosing.
# All logs are emitted as JSON to stderr (stdout is reserved for the
# MCP protocol transport in stdio mode).
MCP_LOG_LEVEL=info

# NODE_ENV controls Prisma client global caching. Use "production" on the droplet.
NODE_ENV=development

# Optional: absolute path to the backend-generated Prisma client entry file.
# Normally unnecessary; the @govcon/mcp-shared loader finds
# backend/node_modules/@prisma/client/index.js by walking up from the repo.
# BANKV_PRISMA_CLIENT_PATH=
