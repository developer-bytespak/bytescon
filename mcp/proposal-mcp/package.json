{
  "name": "@bytescon/proposal-mcp",
  "version": "0.1.0",
  "description": "Bytescon proposal assembly MCP server (stdio, v0.1, four read tools plus one pure pricing-template generator)",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./resource": {
      "types": "./dist/resource.d.ts",
      "import": "./dist/resource.js",
      "default": "./dist/resource.js"
    }
  },
  "bin": {
    "proposal-mcp": "dist/server.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start:stdio": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@bytescon/mcp-shared": "file:../shared",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "winston": "^3.11.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "tsx": "^4.19.2",
    "typescript": "^5.3.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
