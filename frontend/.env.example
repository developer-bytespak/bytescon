VITE_API_URL=http://localhost:3001

# =============================================================
# Stripe Pricing Table (Landing page only)
# =============================================================
# IMPORTANT: Use TEST mode keys for development to avoid real charges.
# Find these at https://dashboard.stripe.com/test/pricing-tables
#
# To create a test pricing table:
# 1. Go to https://dashboard.stripe.com/test/pricing-tables
# 2. Click "Create pricing table"
# 3. Add the 3 test prices (Starter, Professional, Enterprise — already
#    created in your Stripe test account; see backend/.env STRIPE_PRICE_*)
# 4. Copy the prctbl_xxx ID and pk_test_xxx publishable key here
# =============================================================
VITE_STRIPE_PRICING_TABLE_ID=prctbl_REPLACE_WITH_TEST_TABLE_ID
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_TEST_PUBLISHABLE_KEY

# =============================================================
# Observability (Sentry frontend) — leave blank to disable
# =============================================================
VITE_SENTRY_DSN=

# =============================================================
# Product analytics (PostHog) — leave blank to disable
# =============================================================
# Project API key from posthog.com (starts with phc_). When set, the app
# captures pageviews/autocapture + named events (signup, bid decisions,
# proposals, requirement extraction, AI usage). No-op when blank.
# Host defaults to US Cloud; override only for EU Cloud or self-host.
VITE_POSTHOG_KEY=
# Ingest endpoint. Local dev talks to PostHog directly; PROD overrides this to
# the /ingest reverse proxy via the docker-compose build arg (ad-blocker-proof).
VITE_POSTHOG_HOST=https://us.i.posthog.com
# PostHog dashboard origin (for "view in PostHog" deep links only).
VITE_POSTHOG_UI_HOST=https://us.posthog.com

# =============================================================
# Feature flags
# =============================================================
# GB-105 Agency View v2 (analytical agency profile: spend/activity,
# top NAICS+PSC, set-aside utilization, recurring patterns, drill-down).
# Set to "true" to enable. Prod default OFF — enable last in the staged
# rollout. The additive /api/agency/:code/profile endpoint is always live;
# this flag only controls the expanded UI section.
VITE_AGENCY_VIEW_V2_ENABLED=
# GB-106 Platform & Vehicle Onboarding module (route: /platform-onboarding).
# Set to "true" to render the onboarding panel. Prod default OFF.
VITE_PLATFORM_ONBOARDING_ENABLED=
