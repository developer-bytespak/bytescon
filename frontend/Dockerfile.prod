# =============================================================
# GovCon Frontend — Production Build (Vite + nginx)
# =============================================================

# Stage 1: Build static assets
FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
# Use npm ci for deterministic installs. Requires package-lock.json to be
# in sync with package.json — keep them aligned by always running a local
# `npm install` after editing package.json and committing the resulting
# lockfile change.
RUN npm ci --no-audit --no-fund
COPY . .
ARG VITE_API_URL=""
ARG VITE_STRIPE_PUBLISHABLE_KEY=""
ARG VITE_STRIPE_PRICING_TABLE_ID=""
ARG VITE_AGENCY_VIEW_V2_ENABLED=""
ARG VITE_PLATFORM_ONBOARDING_ENABLED=""
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_STRIPE_PUBLISHABLE_KEY=$VITE_STRIPE_PUBLISHABLE_KEY
ENV VITE_STRIPE_PRICING_TABLE_ID=$VITE_STRIPE_PRICING_TABLE_ID
ENV VITE_AGENCY_VIEW_V2_ENABLED=$VITE_AGENCY_VIEW_V2_ENABLED
ENV VITE_PLATFORM_ONBOARDING_ENABLED=$VITE_PLATFORM_ONBOARDING_ENABLED
ARG VITE_POSTHOG_KEY=""
ARG VITE_POSTHOG_HOST=""
ARG VITE_POSTHOG_UI_HOST=""
ENV VITE_POSTHOG_KEY=$VITE_POSTHOG_KEY
ENV VITE_POSTHOG_HOST=$VITE_POSTHOG_HOST
ENV VITE_POSTHOG_UI_HOST=$VITE_POSTHOG_UI_HOST
RUN npm run build

# Stage 2: Serve with nginx
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
